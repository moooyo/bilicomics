+/// Read an immediate marker after verified entropy padding in strict mode.
+pub(crate) fn get_marker_strict<T>(
+    reader: &mut ZReader<T>, stream: &mut BitStream
+) -> Result<Marker, DecodeErrors>
+where
+    T: ZByteReaderTrait
+{
+    stream.check_padding()?;
+    if let Some(marker) = stream.marker.take() {
+        return Ok(marker);
+    }
+    if reader.read_u8_err()? != 0xff {
+        return Err(DecodeErrors::FormatStatic(
+            "[strict-mode]: Expected a marker immediately after entropy data"
+        ));
+    }
+    let mut marker = reader.read_u8_err()?;
+    while marker == 0xff {
+        marker = reader.read_u8_err()?;
+    }
+    if marker == 0 {
+        return Err(DecodeErrors::FormatStatic(
+            "[strict-mode]: Unexpected stuffed entropy byte after scan padding"
+        ));
+    }
+    match Marker::from_u8(marker) {
+        Some(Marker::UNKNOWN(_)) | None => Err(DecodeErrors::Format(format!(
+            "[strict-mode]: Unknown marker 0xFF{marker:X}"
+        ))),
+        Some(marker) => Ok(marker)
+    }
