                width: pw-result-badge.preferred-width + 16px; height: 24px;
                border-width: 1px; border-color: result-hit.pressed ? Theme.paper : Theme.ink;
                pw-result-badge := CatalogText { text: Strings.cat-in-shelf; font-size: 14px; horizontal-alignment: center; color: result-hit.pressed ? Theme.paper : Theme.ink; }
            }
            result-hit := CatalogHitArea { x: 0px; y: 0px; width: 100%; height: 100%; tapped => { CatalogModel.action("comic.open", comic.id); } swiped(delta) => { CatalogModel.action("search.page", delta); } }
            if Theme.scribe: VerticalLayout {
                x: parent.width - Theme.margin - 168px;
                y: 40px;
                width: 168px;
                height: 122px;
                spacing: 10px;
                FlatAction { height: 56px; text: comic.read-label != "" ? comic.read-label : Strings.cat-read-first; text-size: 18px; selected: true; clicked => { CatalogModel.action("comic.read", comic.id); } }
                FlatAction { height: 56px; text: Strings.cat-view-chapters; text-size: 18px; outlined: true; clicked => { CatalogModel.action("comic.open", comic.id); } }
            }
        }
        if CatalogModel.search-items.length == 0: Rectangle { x: 0px; width: 100%;
            y: Theme.scribe ? 60px : 44px;
            height: parent.height - self.y;
            VerticalLayout { x: 0px; y: 0px; width: 100%; height: 100%;
                padding-left: Theme.scribe ? 120px : 56px;
                padding-right: Theme.scribe ? 120px : 56px;
                spacing: 0px; alignment: center;
                CatalogText { height: self.preferred-height; text: CatalogModel.search-state == "loading" ? Strings.cat-searching : CatalogModel.empty-search-title; font-size: Theme.scribe ? 26px : 20px; font-weight: 700; horizontal-alignment: center; }
                Rectangle { height: Theme.scribe ? 14px : 12px; }
                CatalogText { height: Theme.scribe ? 30px : 24px; text: CatalogModel.status-message != "" ? CatalogModel.status-message : Strings.cat-search-help; font-size: Theme.scribe ? 19px : 16px; color: Theme.secondary; wrap: word-wrap; horizontal-alignment: center; }
                Rectangle { height: Theme.scribe ? 24px : 20px; }
                Rectangle {
                    height: Theme.scribe ? 64px : 52px;
                    HorizontalLayout {
                        x: (parent.width - self.width) / 2; y: 0px; width: Theme.scribe ? 456px : 312px; height: parent.height;
                        spacing: Theme.scribe ? 16px : 12px;
                        FlatAction { width: Theme.scribe ? 220px : 150px; height: parent.height; text-size: Theme.scribe ? 19px : 16px; text: Strings.cat-edit-keyword; selected: true; clicked => { CatalogModel.action("search.keyboard", "show"); } }
                        FlatAction { width: Theme.scribe ? 220px : 150px; height: parent.height; text-size: Theme.scribe ? 19px : 16px; text: Strings.cat-browse-more; outlined: true; clicked => { CatalogModel.action("navigate", "store"); } }
                    }
                }
            }
        }
    }
}

component EpisodeFilterBar inherits Rectangle {
    height: Theme.scribe ? 76px : 52px;
    if !CatalogModel.download-selecting: Rectangle { x: 0px; y: 0px; width: 100%; height: 100%;
        HorizontalLayout {
            x: Theme.margin;
            y: (parent.height - (Theme.scribe ? 52px : 40px)) / 2;
            height: Theme.scribe ? 52px : 40px;
            width: Theme.scribe ? 410px : 334px;
            spacing: Theme.scribe ? 8px : 4px;
            alignment: start;
            for entry in [
                { id: "all", label: Theme.scribe ? Strings.cat-all + " " + CatalogModel.detail-total : Strings.cat-all },
                { id: "unread", label: Strings.cat-unread },
                { id: "readable", label: Strings.cat-readable },
                { id: "downloaded", label: Strings.cat-downloaded }
            ]: FlatAction {
                height: parent.height;
                text: entry.label;
                selected: CatalogModel.episode-filter == entry.id;
                text-size: Theme.scribe ? 18px : 15px;
                horizontal-padding: Theme.scribe ? 18px : 12px;
                horizontal-stretch: 0;
                clicked => { CatalogModel.action("episode.filter", entry.id); }
            }
        }
        FlatAction { x: parent.width - (Theme.scribe ? 240px : 186px); y: Theme.scribe ? 12px : 6px; width: Theme.scribe ? 116px : 98px; height: Theme.scribe ? 52px : 40px; text: Strings.cat-locate-reading; text-size: Theme.scribe ? 17px : 15px; outlined: true; clicked => { CatalogModel.action("detail.locate", ""); } }
        Rectangle {
            x: parent.width - (Theme.scribe ? 118px : 84px); y: 0px; width: Theme.scribe ? 80px : 68px; height: parent.height;
            background: sort-hit.pressed ? Theme.ink : Theme.paper;
            Path { x: Theme.scribe ? 10px : 8px; y: (parent.height - self.height) / 2; width: Theme.scribe ? 20px : 18px; height: self.width; viewbox-width: 24; viewbox-height: 24; commands: "M8 4 V20 M4 16 L8 20 L12 16 M16 20 V4 M12 8 L16 4 L20 8"; fill: transparent; stroke: sort-hit.pressed ? Theme.paper : Theme.ink; stroke-width: 2px; }
            CatalogText { x: Theme.scribe ? 34px : 30px; y: 0px; width: parent.width - self.x; height: parent.height; text: CatalogModel.episode-descending ? Strings.cat-descending : Strings.cat-ascending; font-size: Theme.scribe ? 18px : 15px; color: sort-hit.pressed ? Theme.paper : Theme.ink; }
            sort-hit := CatalogHitArea { x: 0px; y: 0px; width: parent.width; height: parent.height; tapped => { CatalogModel.action("episode.sort", ""); } }
        }
    }
    if CatalogModel.download-selecting: Rectangle { x: 0px; y: 0px; width: 100%; height: 100%;
        CatalogText { y: 0px; height: 100%; x: Theme.margin; width: parent.width - Theme.margin - (Theme.scribe ? 220px : 184px); text: Theme.scribe ? Strings.cat-select-guidance-sc : Strings.cat-select-guidance; font-size: Theme.scribe ? 18px : 15px; color: Theme.secondary; }
        FlatAction { x: parent.width - Theme.margin - self.width; width: Theme.scribe ? 142px : 116px; height: Theme.scribe ? 52px : 44px; y: (parent.height - self.height) / 2; text: Strings.cat-select-readable-page; text-size: Theme.scribe ? 18px : 15px; outlined: true; clicked => { CatalogModel.action("detail.select-page", ""); } }
    }
}

component EpisodeRow inherits Rectangle {
    in property <EpisodeItem> episode;
    callback open(string);
    callback select(string);
    callback turn(int);
    height: Theme.scribe ? 68px : 64px;
    property <bool> disabled: CatalogModel.download-selecting && !root.episode.readable;
    property <color> foreground: root.disabled ? Theme.muted : hit.pressed ? Theme.paper : Theme.ink;
    property <color> secondary: root.disabled ? Theme.muted : hit.pressed ? Theme.paper : Theme.secondary;
    background: hit.pressed && !root.disabled ? Theme.ink : Theme.paper;
    accessible-role: button;
    accessible-label: root.episode.order + " " + root.episode.title + " " + root.episode.reading + " " + root.episode.access;
    accessible-enabled: !root.disabled;
    Rectangle { x: 0px; width: 100%; y: parent.height - 1px; height: 1px; background: Theme.line; }
    if root.episode.current: Rectangle { x: Theme.scribe ? 24px : 0px; y: Theme.scribe ? 12px : 8px; width: Theme.scribe ? 7px : 6px; height: parent.height - 2 * self.y; background: root.foreground; }
    if CatalogModel.download-selecting: Rectangle {
        x: Theme.margin;
        y: (parent.height - self.height) / 2;
        width: Theme.scribe ? 26px : 24px;
        height: self.width;
        border-width: 2px;
        border-color: root.disabled ? Theme.line : root.foreground;
        background: root.episode.selected ? Theme.ink : Theme.paper;
        if root.episode.selected: Icon { x: (parent.width - 16px) / 2; y: (parent.height - 16px) / 2; width: 16px; height: 16px; kind: "check"; inverted: true; }
    }
    CatalogText { y: 0px; height: 100%;
        x: Theme.scribe ? (CatalogModel.download-selecting ? 86px : 48px) : (CatalogModel.download-selecting ? 60px : 24px);
        width: Theme.scribe ? 56px : 34px;
        text: root.episode.order;
        font-size: Theme.scribe ? 20px : 17px;
        font-weight: 700;
        color: root.foreground;
    }
    if !Theme.scribe: Rectangle { y: 0px; height: 100%;
        x: CatalogModel.download-selecting ? 106px : 70px;
        width: parent.width - self.x - 164px;
        CatalogText { x: 0px; width: 100%; y: 10px; height: 24px; text: root.episode.title; font-size: 17px; font-weight: root.episode.current ? 700 : 400; color: root.foreground; }
        CatalogText { x: 0px; width: 100%; y: 35px; height: 20px; text: root.episode.reading; font-size: 14px; color: root.secondary; }
    }
    if !Theme.scribe: Rectangle { y: 0px; height: 100%;
        x: parent.width - 152px;
        width: 128px;
        Rectangle {
            x: parent.width - max(48px, access-label.preferred-width + 14px + (root.episode.locked ? 16px : 0px));
            y: 9px;
            width: max(48px, access-label.preferred-width + 14px + (root.episode.locked ? 16px : 0px));
            height: 22px;
            border-width: root.episode.temporary ? 0px : 1px;
            border-color: root.foreground;
            if root.episode.temporary: DashedOutline { x: 0px; y: 0px; width: parent.width; height: parent.height; stroke: 1px; stroke-color: root.foreground; }
            if root.episode.locked: Path { x: 7px; y: (parent.height - 12px) / 2; width: 12px; height: 12px; viewbox-width: 24; viewbox-height: 24; commands: "M5 11 H19 V21 H5 Z M8 11 V7 A4 4 0 0 1 16 7 V11"; fill: transparent; stroke: root.foreground; stroke-width: 2.6px; }
            access-label := CatalogText { x: root.episode.locked ? parent.width - self.preferred-width - 7px : (parent.width - self.preferred-width) / 2; y: 0px; height: parent.height; text: root.episode.access; font-size: 14px; horizontal-alignment: center; color: root.foreground; }
        }
        CatalogText { x: 0px; width: 100%; y: 36px; height: 18px; text: root.episode.storage; font-size: 14px; color: root.secondary; horizontal-alignment: right; }
    }
    if Theme.scribe: Rectangle { y: 0px; height: 100%;
        x: CatalogModel.download-selecting ? 160px : 120px;
        width: parent.width - self.x - 546px;
        CatalogText { x: 0px; y: 0px; width: 100%; height: 100%; text: root.episode.title; font-size: 20px; font-weight: root.episode.current ? 700 : 400; color: root.foreground; }
    }
    if Theme.scribe: CatalogText { y: 0px; height: 100%; x: parent.width - 530px; width: 170px; text: root.episode.reading; font-size: 17px; font-weight: root.episode.current ? 700 : 400; color: root.secondary; }
    if Theme.scribe: Rectangle { y: 0px; height: 100%;
        x: parent.width - 344px;
        width: 150px;
        Rectangle { x: 0px;
            y: (parent.height - 28px) / 2;
            width: max(48px, sc-access-label.preferred-width + 18px);
            height: 28px;
            border-width: root.episode.temporary ? 0px : 1px;
            border-color: root.foreground;
            if root.episode.temporary: DashedOutline { x: 0px; y: 0px; width: parent.width; height: parent.height; stroke: 1px; stroke-color: root.foreground; }
            sc-access-label := CatalogText { text: root.episode.access; font-size: 16px; horizontal-alignment: center; color: root.foreground; }
        }
    }
    if Theme.scribe: CatalogText { y: 0px; height: 100%; x: parent.width - 178px; width: 130px; text: root.episode.storage; font-size: 17px; color: root.secondary; }
    hit := CatalogHitArea { x: 0px; y: 0px; width: 100%; height: 100%;
        enabled: !root.disabled;
        tapped => { if CatalogModel.download-selecting { root.select(root.episode.id); } else { root.open(root.episode.id); } }
        swiped(delta) => { root.turn(delta); }
    }
}

export component DetailScreen inherits Rectangle {
    background: Theme.paper;
    clip: true;
    property <length> header-height: Theme.scribe ? 73px : 53px;
    property <length> summary-height: Theme.scribe ? 297px : 161px;
    property <length> summary-content-width: root.width - 2 * Theme.margin - (Theme.scribe ? 212px : 112px);
    property <length> filter-height: Theme.scribe ? 76px : 52px;
    property <length> table-header-height: Theme.scribe ? 47px : 1px;
    property <length> footer-height: CatalogModel.download-selecting ? (Theme.scribe ? 98px : 74px) : (Theme.scribe ? 81px : 61px);
    Rectangle { x: 0px; y: 0px; width: 100%;
        height: root.header-height;
        if !CatalogModel.download-selecting: BackAction { y: 0px; x: Theme.scribe ? 32px : 8px; height: parent.height; width: Theme.scribe ? 112px : 92px; text: Strings.cat-back; clicked => { CatalogModel.action("detail.back", ""); } }
        if !CatalogModel.download-selecting: CatalogText { y: 0px; height: 100%; x: 160px; width: parent.width - self.x - (Theme.scribe ? 48px : 24px); text: CatalogModel.detail-id-label; font-size: Theme.scribe ? 17px : 15px; color: Theme.secondary; horizontal-alignment: right; }
        if CatalogModel.download-selecting: CatalogText { y: 0px; height: 100%; x: Theme.margin; width: parent.width - 160px; text: Strings.cat-select-download-chapters; font-size: Theme.scribe ? 24px : 20px; font-weight: 700; }
        if CatalogModel.download-selecting: FlatAction { y: (parent.height - self.height) / 2; x: parent.width - (Theme.scribe ? 108px : 70px); width: Theme.scribe ? 76px : 58px; height: Theme.scribe ? 56px : 48px; text: Strings.cat-cancel; text-size: Theme.scribe ? 20px : 17px; clicked => { CatalogModel.action("detail.download", "cancel"); } }
        Rectangle { x: 0px; width: 100%; y: parent.height - 1px; height: 1px; background: Theme.ink; }
    }
    Rectangle { x: 0px; width: 100%;
        y: root.header-height;
        height: root.summary-height;
        BookCover { x: Theme.margin; y: Theme.scribe ? 28px : 16px; width: Theme.scribe ? 180px : 96px; height: Theme.scribe ? 240px : 128px; cover: CatalogModel.detail.cover; title: ""; badge: ""; progress: -1; }
        Rectangle {
            x: Theme.margin + (Theme.scribe ? 212px : 112px);
            y: Theme.scribe ? 28px : 16px;
            width: parent.width - self.x - Theme.margin;
            height: Theme.scribe ? 240px : 128px;
            CatalogText { x: 0px; y: 0px; width: 100%; height: Theme.scribe ? 44px : 30px; text: CatalogModel.detail.title; font-family: Theme.serif-font; font-size: Theme.scribe ? 34px : 22px; font-weight: 700; }
            if !Theme.scribe: CatalogText { x: 0px; width: 100%; y: 33px; height: 21px; text: CatalogModel.detail.subtitle; font-size: 15px; color: Theme.secondary; }
            if !Theme.scribe: CatalogText { x: 0px; width: 100%; y: 57px; height: 21px; text: CatalogModel.detail.meta; font-size: 15px; color: Theme.secondary; }
            if Theme.scribe: HorizontalLayout {
                x: 0px;
                y: 52px;
                width: parent.width;
                height: 30px;
                spacing: 10px;
                CatalogText { text: CatalogModel.detail.author; font-size: 18px; color: Theme.secondary; horizontal-stretch: 0; max-width: 180px; }
                for genre in CatalogModel.detail-genres: Rectangle {
                    height: 28px;
                    preferred-width: genre-label.preferred-width + 20px;
                    horizontal-stretch: 0;
                    background: Theme.paper;
                    border-width: 1px;
                    border-color: Theme.ink;
                    genre-label := CatalogText { text: genre; font-size: 16px; horizontal-alignment: center; }
                }
                CatalogText { text: CatalogModel.detail.meta; font-size: 17px; color: Theme.secondary; horizontal-stretch: 1; min-width: 0px; }
            }
            if Theme.scribe: CatalogText { x: 0px; width: min(600px, parent.width); y: 90px; height: 56px; text: CatalogModel.detail.description; wrap: word-wrap; font-size: 18px; }
            if !CatalogModel.download-selecting: HorizontalLayout { x: 0px; width: 100%;
                y: parent.height - (Theme.scribe ? 64px : 48px);
                height: Theme.scribe ? 64px : 48px;
                spacing: Theme.scribe ? 12px : 8px;
                alignment: start;
                FlatAction { horizontal-stretch: 0; min-width: Theme.scribe ? 240px : (root.summary-content-width - 16px) * 184 / 442; max-width: self.min-width; height: parent.height; text: CatalogModel.detail.read-label != "" ? CatalogModel.detail.read-label : Strings.cat-read-first; selected: true; text-size: Theme.scribe ? 20px : 16px; clicked => { CatalogModel.action("comic.read", CatalogModel.detail.id); } }
                FlatAction { horizontal-stretch: 0; min-width: Theme.scribe ? 160px : (root.summary-content-width - 16px) * 129 / 442; max-width: self.min-width; height: parent.height; text: Theme.scribe ? Strings.cat-download-chapters : Strings.cat-download; outlined: true; text-size: Theme.scribe ? 20px : 16px; clicked => { CatalogModel.action("detail.download", "enter"); } }
                FlatAction { horizontal-stretch: 0; min-width: Theme.scribe ? 160px : (root.summary-content-width - 16px) * 129 / 442; max-width: self.min-width; height: parent.height; text: CatalogModel.detail.in-shelf ? Strings.cat-followed : Strings.cat-follow; outlined: true; text-size: Theme.scribe ? 20px : 16px; clicked => { CatalogModel.action("detail.favorite", CatalogModel.detail.id); } }
            }
        }
        Rectangle { x: 0px; width: 100%; y: parent.height - 1px; height: 1px; background: Theme.line; }
    }
    EpisodeFilterBar { x: 0px; width: 100%; y: root.header-height + root.summary-height; height: root.filter-height; }
    Rectangle { x: 0px; width: 100%;
        y: root.header-height + root.summary-height + root.filter-height;
        height: max(0px, parent.height - self.y - root.footer-height);
        clip: true;
        Rectangle { x: 0px; y: 0px; width: 100%; height: Theme.scribe ? 2px : 1px; background: Theme.ink; }
        if Theme.scribe: Rectangle { x: 0px; y: 0px; width: 100%;
            height: root.table-header-height;
            CatalogText { y: 0px; height: 100%; x: 48px; width: CatalogModel.download-selecting ? 96px : 56px; text: Strings.cat-episode-column; font-size: 16px; color: Theme.secondary; }
            CatalogText { y: 0px; height: 100%; x: CatalogModel.download-selecting ? 160px : 120px; width: parent.width - (CatalogModel.download-selecting ? 706px : 666px); text: Strings.cat-title-column; font-size: 16px; color: Theme.secondary; }
            CatalogText { y: 0px; height: 100%; x: parent.width - 530px; width: 170px; text: Strings.cat-reading-column; font-size: 16px; color: Theme.secondary; }
            CatalogText { y: 0px; height: 100%; x: parent.width - 344px; width: 150px; text: Strings.cat-access-column; font-size: 16px; color: Theme.secondary; }
            CatalogText { y: 0px; height: 100%; x: parent.width - 178px; width: 130px; text: Strings.cat-local-column; font-size: 16px; color: Theme.secondary; }
            Rectangle { x: 0px; width: 100%; y: parent.height - 1px; height: 1px; background: Theme.ink; }
        }
        for episode[index] in CatalogModel.episodes: EpisodeRow { x: 0px; width: 100%;
            y: root.table-header-height + index * (Theme.scribe ? 68px : 64px);
            episode: episode;
            open(id) => { CatalogModel.action("episode.open", id); }
            select(id) => { CatalogModel.action("episode.select", id); }
            turn(delta) => { CatalogModel.action("episode.page", delta); }
        }
        if CatalogModel.episodes.length == 0: CatalogText { x: Theme.margin; y: root.table-header-height; width: parent.width - 2 * Theme.margin; height: 100px; text: CatalogModel.status-message; font-size: Theme.body-size; color: Theme.secondary; wrap: word-wrap; horizontal-alignment: center; }
    }
    Rectangle { x: 0px; width: 100%;
        y: parent.height - root.footer-height;
        height: root.footer-height;
        if !CatalogModel.download-selecting: HorizontalLayout {
            x: Theme.scribe ? 32px : 12px; y: 1px; width: parent.width - self.x * 2; height: parent.height - 1px; spacing: 0px;
            Rectangle {
                width: footer-previous.preferred-width; height: parent.height; horizontal-stretch: 0;
                footer-previous := NavigationButton {
                    x: 0px; y: (parent.height - self.height) / 2; width: parent.width;
                    height: Theme.scribe ? 56px : 48px; text: Strings.cat-previous-page; icon: "back";
                    text-size: Theme.scribe ? 19px : 16px; icon-size: Theme.scribe ? 19px : 16px;
                    enabled: CatalogModel.episode-page > 1;
                    clicked => { CatalogModel.action("episode.page", "-1"); }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            CatalogText { horizontal-stretch: 0; text: Theme.scribe ? Strings.cat-page-prefix + CatalogModel.episode-page + " / " + CatalogModel.episode-pages + Strings.cat-page-total-separator + CatalogModel.detail-total + Strings.cat-episode-unit : CatalogModel.episode-page + " / " + CatalogModel.episode-pages; font-size: Theme.scribe ? 19px : 15px; horizontal-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            Rectangle {
                width: footer-next.preferred-width; height: parent.height; horizontal-stretch: 0;
                footer-next := NavigationButton {
                    x: 0px; y: (parent.height - self.height) / 2; width: parent.width;
                    height: Theme.scribe ? 56px : 48px; text: Strings.cat-next-page; icon: "next"; trailing: true;
                    text-size: Theme.scribe ? 19px : 16px; icon-size: Theme.scribe ? 19px : 16px;
                    enabled: CatalogModel.episode-page < CatalogModel.episode-pages;
                    clicked => { CatalogModel.action("episode.page", "1"); }
                }
            }
        }
        if CatalogModel.download-selecting: Rectangle { y: 0px; height: 100%;
            x: Theme.margin;
            width: parent.width - 2 * Theme.margin;
            VerticalLayout {
                x: 0px; y: 2px; width: parent.width - (Theme.scribe ? 440px : 294px); height: parent.height - 2px;
                alignment: center; spacing: 0px;
                CatalogText { height: Theme.scribe ? 30px : 24px; text: Strings.cat-selected-prefix + CatalogModel.selection-count + Strings.cat-episode-unit; font-size: Theme.scribe ? 20px : 16px; font-weight: 700; }
                CatalogText { height: Theme.scribe ? 24px : 20px; text: CatalogModel.selection-size != "" ? CatalogModel.selection-size : Strings.cat-cross-page-selection; font-size: Theme.scribe ? 16px : 14px; color: Theme.secondary; }
            }
            HorizontalLayout {
                x: parent.width - (Theme.scribe ? 422px : 260px);
                y: 2px;
                width: Theme.scribe ? 422px : 260px;
                height: parent.height - 2px;
                spacing: Theme.scribe ? 10px : 8px;
                Rectangle {
                    width: Theme.scribe ? 64px : 48px; height: parent.height;
                    ArrowAction { x: 0px; y: (parent.height - self.height) / 2; width: parent.width; height: self.width; icon: "back"; label: Strings.cat-previous-page; outlined: true; enabled: CatalogModel.episode-page > 1; clicked => { CatalogModel.action("episode.page", "-1"); } }
                }
                if Theme.scribe: CatalogText { width: 56px; text: CatalogModel.episode-page + " / " + CatalogModel.episode-pages; font-size: 18px; horizontal-alignment: center; }
                Rectangle {
                    width: Theme.scribe ? 64px : 48px; height: parent.height;
                    ArrowAction { x: 0px; y: (parent.height - self.height) / 2; width: parent.width; height: self.width; icon: "next"; label: Strings.cat-next-page; outlined: true; enabled: CatalogModel.episode-page < CatalogModel.episode-pages; clicked => { CatalogModel.action("episode.page", "1"); } }
                }
                Rectangle {
                    width: Theme.scribe ? 208px : 148px;
                    height: parent.height;
                    FlatAction { x: Theme.scribe ? 8px : 0px; y: (parent.height - self.height) / 2; width: Theme.scribe ? 200px : 148px; height: Theme.scribe ? 64px : 52px; text-size: Theme.scribe ? 20px : 16px; text: CatalogModel.selection-count > 0 ? Strings.cat-download + " " + CatalogModel.selection-count + Strings.cat-episode-unit : Strings.cat-download; selected: true; outlined: CatalogModel.selection-count == 0; enabled: CatalogModel.selection-count > 0; clicked => { CatalogModel.action("detail.download", "confirm"); } }
                }
            }
        }
        Rectangle { x: 0px; y: 0px; width: parent.width; height: CatalogModel.download-selecting ? 2px : 1px; background: Theme.ink; }
    }
}
