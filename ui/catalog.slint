import { Theme } from "theme.slint";
import { Strings } from "strings.slint";
import { ActionButton, IconButton, Icon, BookCover, DashedOutline, NavigationButton } from "widgets.slint";
import { TouchKeyboard } from "keyboard.slint";

export struct ComicItem {
    id: string,
    title: string,
    author: string,
    cover: image,
    subtitle: string,
    meta: string,
    badge: string,
    downloaded: bool,
    progress: float,
    in-shelf: bool,
    description: string,
    read-label: string,
}

export struct EpisodeItem {
    id: string,
    order: string,
    title: string,
    reading: string,
    access: string,
    storage: string,
    readable: bool,
    selected: bool,
    current: bool,
    downloaded: bool,
    temporary: bool,
    locked: bool,
}

export struct CategoryItem { id: string, label: string, selected: bool }
export struct SearchHistoryItem { query: string, meta: string }

export global CatalogModel {
    callback action(string, string);
    in-out property <[ComicItem]> shelf-items;
    in-out property <[ComicItem]> store-items;
    in-out property <[ComicItem]> search-items;
    in-out property <[ComicItem]> suggestions;
    in-out property <[EpisodeItem]> episodes;
    in-out property <ComicItem> resume;
    in-out property <bool> has-resume;
    in-out property <string> shelf-state: "ready";
    in-out property <string> shelf-view: "grid";
    in-out property <string> shelf-filter: "all";
    in-out property <bool> shelf-menu-open;
    in-out property <int> shelf-page: 1;
    in-out property <int> shelf-pages: 1;
    in-out property <string> shelf-count-label;
    in-out property <string> sync-label;
    in-out property <[string]> filter-counts;
    in-out property <int> local-download-count;
    in-out property <bool> shelf-offline;
    in-out property <[CategoryItem]> categories;
    in-out property <string> category-label;
    in-out property <string> category-meta;
    in-out property <bool> category-picker-open;
    in-out property <int> store-page: 1;
    in-out property <int> store-pages: 1;
    in-out property <string> query;
    in-out property <string> composition;
    in-out property <[string]> candidates;
    in-out property <int> candidate-page;
    in-out property <int> candidate-pages: 1;
    in-out property <bool> latin;
    in-out property <bool> numeric;
    in-out property <bool> keyboard-visible: true;
    in-out property <string> search-state: "recent";
    in-out property <[SearchHistoryItem]> history;
    in-out property <string> search-result-label;
    in-out property <string> empty-search-title;
    in-out property <int> search-page: 1;
    in-out property <int> search-pages: 1;
    in-out property <ComicItem> detail;
    in-out property <[string]> detail-genres;
    in-out property <string> detail-id-label;
    in-out property <int> detail-total;
    in-out property <int> episode-page: 1;
    in-out property <int> episode-pages: 1;
    in-out property <string> episode-filter: "all";
    in-out property <bool> episode-descending;
    in-out property <bool> download-selecting;
    in-out property <int> selection-count;
    in-out property <string> selection-size;
    in-out property <string> status-message;
}

component CatalogText inherits Text {
    color: Theme.ink;
    font-family: Theme.ui-font;
    font-size: Theme.body-size;
    vertical-alignment: center;
    overflow: elide;
}

component CatalogHitArea inherits TouchArea {
    callback tapped();
    callback swiped(int);
    property <length> down-x;
    property <length> down-y;
    property <bool> gesture-moved;
    pointer-event(event) => {
        if event.kind == PointerEventKind.down {
            root.down-x = self.mouse-x;
            root.down-y = self.mouse-y;
            root.gesture-moved = false;
            Theme.refresh("press");
        }
        if event.kind == PointerEventKind.up {
            if abs(self.mouse-x - root.down-x) >= 64px && abs(self.mouse-x - root.down-x) > abs(self.mouse-y - root.down-y) {
                root.gesture-moved = true;
                root.swiped(self.mouse-x < root.down-x ? 1 : -1);
            } else if abs(self.mouse-y - root.down-y) >= 64px {
                root.gesture-moved = true;
            }
            Theme.refresh("release");
        }
    }
    clicked => { if !root.gesture-moved { root.tapped(); } }
}

component FlatAction inherits Rectangle {
    in property <string> text;
    in property <string> label: root.text;
    in property <bool> selected;
    in property <bool> outlined;
    in property <bool> enabled: true;
    in property <length> text-size: Theme.label-size;
    in property <length> horizontal-padding: 12px;
    in property <int> weight: 500;
    callback clicked();
    height: Theme.button-height;
    min-width: 48px;
    preferred-width: max(48px, caption.preferred-width + 2 * root.horizontal-padding);
    border-width: root.outlined ? 2px : 0px;
    border-color: root.enabled ? Theme.ink : Theme.line;
    background: root.enabled && (root.selected || hit.pressed) ? Theme.ink : Theme.paper;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    caption := CatalogText {
        text: root.text;
        color: !root.enabled ? Theme.muted : root.selected || hit.pressed ? Theme.paper : Theme.ink;
        font-size: root.text-size;
        font-weight: root.weight;
        horizontal-alignment: center;
    }
    hit := CatalogHitArea { x: 0px; y: 0px; width: 100%; height: 100%; enabled: root.enabled; tapped => { root.clicked(); } }
}

component BackAction inherits NavigationButton {
    icon: "back";
    height: Theme.header-height;
    text-size: Theme.scribe ? 20px : 17px;
    icon-size: Theme.scribe ? 28px : 22px;
}

component ArrowAction inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> outlined;
    callback clicked();
    width: Theme.scribe ? 56px : 48px;
    height: self.width;
    background: Theme.paper;
    IconButton {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        icon: root.icon; label: root.label; enabled: root.enabled;
        icon-size: Theme.scribe ? 28px : 22px;
        clicked => { root.clicked(); }
    }
    if root.outlined: Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        border-width: 1.5px; border-color: root.enabled ? Theme.ink : Theme.line; background: transparent;
    }
}

component InlinePager inherits Rectangle {
    in property <int> page: 1;
    in property <int> pages: 1;
    callback turn(int);
    height: Theme.scribe ? 56px : 48px;
    width: Theme.scribe ? 168px : 140px;
    HorizontalLayout { x: 0px; y: 0px; width: 100%; height: 100%;
        spacing: 0px;
        ArrowAction {
            width: Theme.scribe ? 56px : 48px;
            height: parent.height;
            icon: "back";
            label: Strings.cat-previous-page;
            enabled: root.page > 1;
            clicked => { root.turn(-1); }
        }
        CatalogText { text: root.page + " / " + root.pages; font-size: Theme.scribe ? 18px : 15px; horizontal-alignment: center; }
        ArrowAction {
            width: Theme.scribe ? 56px : 48px;
            height: parent.height;
            icon: "next";
            label: Strings.cat-next-page;
            enabled: root.page < root.pages;
            clicked => { root.turn(1); }
        }
    }
}

component ComicGrid inherits Rectangle {
    in property <[ComicItem]> items;
    in property <bool> store-mode;
    callback open(string);
    callback read(string);
    callback turn(int);
    property <int> columns: Theme.scribe ? 5 : 3;
    property <length> gap-x: Theme.scribe ? 21px : 18px;
    property <length> gap-y: Theme.scribe ? (root.store-mode ? 20px : 32px) : (root.store-mode ? 16px : 18px);
    property <length> tile-width: (root.width - 2 * Theme.margin - (root.columns - 1) * root.gap-x) / root.columns;
    property <length> cover-height: floor(root.tile-width / 1px * 4 / 3) * 1px;
    property <length> caption-height: Theme.scribe ? (root.store-mode ? 55px : 52px) : 48px;
    for comic[index] in root.items: Rectangle {
        x: Theme.margin + mod(index, root.columns) * (root.tile-width + root.gap-x);
        y: floor(index / root.columns) * (root.cover-height + root.caption-height + (Theme.scribe ? 8px : 6px) + root.gap-y);
        width: root.tile-width;
        height: root.cover-height + root.caption-height + (Theme.scribe ? 8px : 6px);
        BookCover { x: 0px; y: 0px;
            width: parent.width;
            height: root.cover-height;
            cover: comic.cover;
            title: comic.cover.width > 0 ? comic.title : "";
            badge: "";
            progress: -1;
        }
        if comic.cover.width == 0: CatalogText {
            x: 8px; y: 0px; width: parent.width - 16px; height: root.cover-height;
            text: Strings.cat-cover-not-cached; font-size: 14px; color: Theme.secondary; horizontal-alignment: center;
        }
        if (root.store-mode && comic.in-shelf) || (!root.store-mode && comic.badge != ""): Rectangle {
            x: parent.width - self.width;
            y: 0px;
            width: min(parent.width, grid-badge-label.preferred-width + 14px);
            height: 24px;
            background: root.store-mode ? Theme.paper : Theme.ink;
            border-width: root.store-mode ? 1px : 0px;
            border-color: Theme.ink;
            grid-badge-label := CatalogText {
                text: root.store-mode ? Strings.cat-in-shelf : comic.badge;
                font-size: Theme.scribe ? 14px : 13px;
                font-weight: 500;
                color: root.store-mode ? Theme.ink : Theme.paper;
                horizontal-alignment: center;
            }
        }
        cover-hit := CatalogHitArea { x: 0px; y: 0px; width: 100%;
            height: root.cover-height;
            tapped => { if root.store-mode { root.open(comic.id); } else { root.read(comic.id); } }
            swiped(delta) => { root.turn(delta); }
        }
        Rectangle { x: 0px; width: 100%;
            y: root.cover-height + (Theme.scribe ? 8px : 6px);
            height: root.caption-height;
            background: caption-hit.pressed ? Theme.ink : Theme.paper;
            CatalogText { x: 0px; y: 0px; width: 100%;
                height: Theme.scribe ? 25px : 22px;
                text: comic.title;
                font-size: Theme.scribe ? 18px : 16px;
                font-weight: 500;
                color: caption-hit.pressed ? Theme.paper : Theme.ink;
            }
            CatalogText { x: 0px; width: 100%;
                y: root.store-mode ? (Theme.scribe ? 33px : 28px) : (Theme.scribe ? 27px : 23px);
                height: Theme.scribe ? 22px : 20px;
                text: comic.meta;
                font-size: Theme.scribe ? 16px : 14px;
                color: caption-hit.pressed ? Theme.paper : Theme.secondary;
            }
            caption-hit := CatalogHitArea { x: 0px; y: 0px; width: 100%; height: 100%;
                tapped => { root.open(comic.id); }
                swiped(delta) => { root.turn(delta); }
            }
        }
    }
}

component ShelfList inherits Rectangle {
    in property <[ComicItem]> items;
    callback read(string);
    callback turn(int);
    for comic[index] in root.items: Rectangle { x: 0px; width: 100%;
        y: index * (Theme.scribe ? 104px : 84px);
        height: Theme.scribe ? 104px : 84px;
        background: hit.pressed ? Theme.ink : Theme.paper;
        Rectangle { x: 0px; width: 100%; y: parent.height - 1px; height: 1px; background: Theme.line; }
        BookCover {
            x: Theme.margin;
            y: Theme.scribe ? 12px : 12px;
            width: Theme.scribe ? 60px : 45px;
            height: Theme.scribe ? 80px : 60px;
            cover: comic.cover;
            title: "";
            badge: "";
            progress: -1;
        }
        Rectangle {
            x: Theme.margin + (Theme.scribe ? 82px : 59px);
            y: Theme.scribe ? 14px : 9px;
            width: parent.width - self.x - Theme.margin - (comic.downloaded ? 100px : 0px);
            height: parent.height - 18px;
            CatalogText { x: 0px; y: 0px; width: 100%;
                height: Theme.scribe ? 30px : 24px;
                text: comic.title;
                font-size: Theme.scribe ? 21px : 17px;
                font-weight: 700;
                color: hit.pressed ? Theme.paper : Theme.ink;
            }
            CatalogText { x: 0px; width: 100%;
                y: Theme.scribe ? 34px : 27px;
                height: Theme.scribe ? 24px : 20px;
                text: comic.meta;
                font-size: Theme.scribe ? 17px : 14px;
                color: hit.pressed ? Theme.paper : Theme.secondary;
            }
            Rectangle { x: 0px;
                y: Theme.scribe ? 66px : 52px;
                width: min(parent.width, Theme.scribe ? 480px : 360px);
                height: Theme.scribe ? 6px : 5px;
                border-width: 1px;
                border-color: hit.pressed ? Theme.paper : Theme.ink;
                Rectangle { x: 0px; y: 0px; height: 100%; width: max(0, min(1, comic.progress)) * parent.width; background: hit.pressed ? Theme.paper : Theme.ink; }
            }
        }
        if comic.downloaded: CatalogText { y: 0px; height: 100%;
            x: parent.width - Theme.margin - 100px;
            width: 100px;
            text: Strings.cat-offline-available;
            font-size: Theme.scribe ? 17px : 14px;
            horizontal-alignment: right;
            color: hit.pressed ? Theme.paper : Theme.secondary;
        }
        hit := CatalogHitArea { x: 0px; y: 0px; width: 100%; height: 100%; tapped => { root.read(comic.id); } swiped(delta) => { root.turn(delta); } }
    }
}

component ShelfMenu inherits Rectangle {
    background: Theme.paper;
    border-width: 2px;
    border-color: Theme.ink;
    height: Theme.scribe ? 439px : 375px;
    width: Theme.scribe ? 364px : 304px;
    Rectangle {
        y: 2px;
        x: 2px;
        width: parent.width - 4px;
        height: Theme.scribe ? 72px : 60px;
        background: sync-hit.pressed ? Theme.ink : Theme.paper;
        CatalogText { x: Theme.scribe ? 20px : 16px; y: 8px; width: parent.width - self.x * 2; height: 25px; text: Strings.cat-sync-now; font-size: Theme.scribe ? 19px : 16px; font-weight: 500; color: sync-hit.pressed ? Theme.paper : Theme.ink; }
        CatalogText { x: Theme.scribe ? 20px : 16px; y: 33px; width: parent.width - self.x * 2; height: 24px; text: CatalogModel.sync-label; font-size: Theme.scribe ? 16px : 14px; color: sync-hit.pressed ? Theme.paper : Theme.secondary; }
        Rectangle { x: 0px; width: 100%; y: parent.height - 2px; height: 2px; background: Theme.ink; }
        sync-hit := CatalogHitArea { x: 0px; y: 0px; width: 100%; height: 100%; tapped => { CatalogModel.action("shelf.sync", ""); } }
    }
    Rectangle {
        y: Theme.scribe ? 74px : 62px;
        x: 2px;
        width: parent.width - 4px;
        height: Theme.scribe ? 78px : 66px;
        CatalogText { y: 0px; height: 100%; x: Theme.scribe ? 20px : 16px; width: 90px; text: Strings.cat-view-mode; font-size: Theme.scribe ? 17px : 15px; color: Theme.secondary; }
        Rectangle {
            x: parent.width - 16px - self.width;
            y: (parent.height - 2px - self.height) / 2;
            width: Theme.scribe ? 204px : 172px;
            height: Theme.scribe ? 56px : 48px;
            border-width: 2px; border-color: Theme.ink; background: Theme.paper;
            HorizontalLayout {
                x: 2px; y: 2px; width: parent.width - 4px; height: parent.height - 4px; spacing: 0px;
                FlatAction { height: parent.height; text: Strings.cat-grid; selected: CatalogModel.shelf-view == "grid"; text-size: Theme.scribe ? 18px : 15px; clicked => { CatalogModel.action("shelf.view", "grid"); } }
                FlatAction { height: parent.height; text: Strings.cat-list; selected: CatalogModel.shelf-view == "list"; text-size: Theme.scribe ? 18px : 15px; clicked => { CatalogModel.action("shelf.view", "list"); } }
            }
            Rectangle { x: parent.width / 2; y: 2px; width: 2px; height: parent.height - 4px; background: Theme.ink; }
        }
        Rectangle { x: 0px; width: 100%; y: parent.height - 2px; height: 2px; background: Theme.ink; }
    }
    CatalogText {
        x: Theme.scribe ? 22px : 18px;
        y: Theme.scribe ? 152px : 128px;
        width: parent.width - self.x * 2;
        height: Theme.scribe ? 45px : 37px;
        text: Strings.cat-filter-recent;
        color: Theme.secondary;
        font-size: Theme.scribe ? 16px : 14px;
    }
    for entry[index] in [
        { id: "all", label: Strings.cat-all },
        { id: "updated", label: Strings.cat-updated },
        { id: "downloaded", label: Strings.cat-downloaded },
        { id: "finished", label: Strings.cat-finished }
    ]: Rectangle {
        x: 2px;
        y: (Theme.scribe ? 197px : 165px) + index * (Theme.scribe ? 60px : 52px);
        width: parent.width - 4px;
        height: Theme.scribe ? 60px : 52px;
        background: hit.pressed ? Theme.ink : Theme.paper;
        Rectangle { x: 0px; y: 0px; width: 100%; height: 1px; background: Theme.line; }
        CatalogText { y: 0px; height: 100%; x: Theme.scribe ? 20px : 16px; width: parent.width - 94px; text: entry.label; font-size: Theme.scribe ? 19px : 16px; font-weight: CatalogModel.shelf-filter == entry.id ? 700 : 400; color: hit.pressed ? Theme.paper : Theme.ink; }
        CatalogText { y: 0px; height: 100%; x: parent.width - (Theme.scribe ? 94px : 90px); width: 74px; text: CatalogModel.shelf-filter == entry.id ? Strings.cat-current : CatalogModel.filter-counts[index]; font-size: Theme.scribe ? 16px : 14px; color: hit.pressed ? Theme.paper : Theme.secondary; horizontal-alignment: right; }
        hit := CatalogHitArea { x: 0px; y: 0px; width: 100%; height: 100%; tapped => { CatalogModel.action("shelf.filter", entry.id); } }
    }
}

export component ShelfScreen inherits Rectangle {
    background: Theme.paper;
    clip: true;
    property <length> header-height: 0px;
    property <length> resume-height: CatalogModel.shelf-state == "ready" && Theme.scribe && CatalogModel.has-resume ? 337px : 0px;
    property <length> controls-height: Theme.scribe ? 72px : 60px;
    property <length> footer-height: Theme.scribe ? 72px : 53px;
    if CatalogModel.shelf-state == "ready": Rectangle { x: 0px; width: 100%;
        y: 0px;
        height: max(0px, parent.height - root.footer-height);
        clip: true;
        if Theme.scribe && CatalogModel.has-resume: Rectangle { x: 0px; y: 0px; width: 100%;
            height: root.resume-height;
            BookCover { x: 48px; y: 28px; width: 210px; height: 280px; cover: CatalogModel.resume.cover; title: CatalogModel.resume.title; badge: ""; progress: -1; }
            Path { x: 64px; y: 27px; width: 28px; height: 48px; viewbox-width: 28; viewbox-height: 48; commands: "M0 0 H28 V48 L14 35 L0 48 Z"; fill: Theme.ink; }
            CatalogHitArea { x: 48px; y: 28px; width: 210px; height: 280px; tapped => { CatalogModel.action("comic.read", CatalogModel.resume.id); } }
            Rectangle {
                x: 294px;
                y: 32px;
                width: parent.width - self.x - Theme.margin;
                height: 276px;
                CatalogText { x: 0px; y: 0px; width: 100%; height: 25px; text: CatalogModel.resume.read-label != "" ? CatalogModel.resume.read-label : Strings.cat-continue-reading; font-size: 17px; color: Theme.secondary; }
                CatalogText { x: 0px; width: 100%; y: 32px; height: 44px; text: CatalogModel.resume.title; font-family: Theme.serif-font; font-size: 34px; font-weight: 700; }
                CatalogText { x: 0px; width: 100%; y: 84px; height: 30px; text: CatalogModel.resume.subtitle; font-size: 21px; }
                resume-progress := Rectangle { x: 0px; y: 136px; height: 12px; width: min(362px, max(40px, parent.width - 130px)); border-width: 1.5px; border-color: Theme.ink; Rectangle { x: 0px; y: 0px; height: 100%; width: max(0, min(1, CatalogModel.resume.progress)) * parent.width; background: Theme.ink; } }
                CatalogText { x: resume-progress.width + 14px; y: 126px; height: 34px; width: 116px; text: CatalogModel.resume.meta; font-size: 17px; }
                CatalogText { x: 0px; width: 100%; y: 162px; height: 26px; text: CatalogModel.resume.description; font-size: 17px; color: Theme.secondary; }
                HorizontalLayout { x: 0px; width: 100%;
                    y: parent.height - 64px;
                    height: 64px;
                    spacing: 14px;
                    alignment: start;
                    FlatAction { width: 240px; height: 64px; text: Strings.cat-continue-reading; selected: true; text-size: 20px; clicked => { CatalogModel.action("comic.read", CatalogModel.resume.id); } }
                    FlatAction { width: 180px; height: 64px; text: Strings.cat-chapters; outlined: true; text-size: 20px; clicked => { CatalogModel.action("comic.open", CatalogModel.resume.id); } }
                }
            }
            Rectangle { x: 0px; width: 100%; y: parent.height - 1px; height: 1px; background: Theme.line; }
        }
        Rectangle { x: 0px; width: 100%;
            y: root.resume-height;
            height: root.controls-height;
            if !Theme.scribe && CatalogModel.has-resume && CatalogModel.shelf-filter == "all": Rectangle {
                x: Theme.margin;
                y: 6px;
                width: max(0px, parent.width - Theme.margin * 2 - 84px);
                height: 48px;
                border-width: 2px;
                border-color: Theme.ink;
                background: resume-hit.pressed ? Theme.ink : Theme.paper;
                Path { x: 10px; y: 13px; width: 16px; height: 22px; viewbox-width: 16; viewbox-height: 22; commands: "M1 1 H15 V21 L8 16 L1 21 Z"; fill: resume-hit.pressed ? Theme.paper : Theme.ink; }
                CatalogText { y: 0px; height: 100%; x: 34px; width: 64px; text: Strings.cat-continue-reading; font-size: 15px; font-weight: 700; color: resume-hit.pressed ? Theme.paper : Theme.ink; }
                CatalogText { y: 0px; height: 100%; x: 106px; width: parent.width - 130px; text: CatalogModel.resume.title + " · " + CatalogModel.resume.meta; font-size: 15px; color: resume-hit.pressed ? Theme.paper : Theme.ink; }
                Icon { x: parent.width - 24px; y: (parent.height - 20px) / 2; width: 20px; height: 20px; kind: "next"; inverted: resume-hit.pressed; }
                resume-hit := CatalogHitArea { x: 0px; y: 0px; width: 100%; height: 100%; tapped => { CatalogModel.action("comic.read", CatalogModel.resume.id); } }
            }
            if Theme.scribe || CatalogModel.shelf-filter != "all" || !CatalogModel.has-resume: HorizontalLayout { y: 0px; height: 100%;
                x: Theme.margin;
                width: max(0px, parent.width - Theme.margin * 2 - (Theme.scribe ? 80px : 88px));
                spacing: 12px;
                alignment: start;
                if CatalogModel.shelf-filter != "all": FlatAction { height: Theme.scribe ? 48px : 44px; text: CatalogModel.shelf-filter == "updated" ? Strings.cat-updated + " ×" : CatalogModel.shelf-filter == "downloaded" ? Strings.cat-downloaded + " ×" : Strings.cat-finished + " ×"; selected: true; text-size: Theme.scribe ? 17px : 15px; clicked => { CatalogModel.action("shelf.filter", "all"); } }
                CatalogText { text: CatalogModel.shelf-count-label; font-size: Theme.scribe ? 18px : 15px; }
                if Theme.scribe: CatalogText { text: Strings.cat-recent-order; font-size: 17px; color: Theme.secondary; }
            }
        }
        if CatalogModel.shelf-view == "grid": ComicGrid { x: 0px; width: 100%;
            y: root.resume-height + root.controls-height + (Theme.scribe ? 4px : 6px);
            height: parent.height - self.y;
            items: CatalogModel.shelf-items;
            open(id) => { CatalogModel.action("comic.open", id); }
            read(id) => { CatalogModel.action("comic.cover", id); }
            turn(delta) => { CatalogModel.action("shelf.page", delta); }
        }
        if CatalogModel.shelf-view == "list": ShelfList { x: 0px; width: 100%;
            y: root.resume-height + root.controls-height;
            height: parent.height - self.y;
            items: CatalogModel.shelf-items;
            read(id) => { CatalogModel.action("comic.cover", id); }
            turn(delta) => { CatalogModel.action("shelf.page", delta); }
        }
    }
    if CatalogModel.shelf-state == "ready": Rectangle {
        x: 0px; y: parent.height - root.footer-height; width: parent.width; height: root.footer-height;
        background: Theme.paper;
        Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.line; }
        if Theme.scribe: HorizontalLayout {
            x: Theme.margin; y: 8px; width: parent.width - Theme.margin * 2; height: 56px;
            NavigationButton { text: Strings.cat-previous-page; icon: "back"; text-size: 18px; enabled: CatalogModel.shelf-page > 1; clicked => { CatalogModel.action("shelf.page", "-1"); } }
            Rectangle { horizontal-stretch: 1; }
            CatalogText { width: 120px; text: CatalogModel.shelf-page + " / " + CatalogModel.shelf-pages; font-size: 18px; horizontal-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            NavigationButton { text: Strings.cat-next-page; icon: "next"; trailing: true; text-size: 18px; enabled: CatalogModel.shelf-page < CatalogModel.shelf-pages; clicked => { CatalogModel.action("shelf.page", "1"); } }
        }
        if !Theme.scribe: CatalogText { x: Theme.margin; y: 0px; width: max(0px, parent.width - Theme.margin * 2 - 156px); height: parent.height; text: Strings.cat-recent-order; font-size: 15px; color: Theme.secondary; }
        if !Theme.scribe: InlinePager { x: parent.width - self.width - Theme.margin; y: (parent.height - self.height) / 2; page: CatalogModel.shelf-page; pages: CatalogModel.shelf-pages; turn(delta) => { CatalogModel.action("shelf.page", delta); } }
    }
    if CatalogModel.shelf-state == "signed-out": Rectangle { x: 0px; width: 100%;
        y: root.header-height;
        height: parent.height - self.y;
        VerticalLayout { x: 0px; y: 0px; width: 100%; height: parent.height - (Theme.scribe ? 0px : 60px);
            padding-left: Theme.scribe ? 160px : 48px;
            padding-right: Theme.scribe ? 160px : 48px;
            spacing: Theme.scribe ? 20px : 16px;
            Rectangle { vertical-stretch: 1; }
            Rectangle {
                height: Theme.scribe ? 72px : 56px;
                Icon { x: (parent.width - self.width) / 2; y: 0px; width: Theme.scribe ? 72px : 56px; height: self.width; kind: "shelf"; }
            }
            CatalogText { height: Theme.scribe ? 40px : 32px; text: Strings.cat-signin-title; horizontal-alignment: center; font-size: Theme.scribe ? 28px : 22px; font-weight: 700; }
            CatalogText { height: Theme.scribe ? 90px : 100px; text: Strings.cat-signin-description; wrap: word-wrap; horizontal-alignment: center; font-size: Theme.scribe ? 19px : 16px; color: Theme.secondary; }
            HorizontalLayout {
                height: Theme.button-height;
                spacing: 16px;
                FlatAction { text: Strings.cat-qr-login; selected: true; clicked => { CatalogModel.action("navigate", "login"); } }
                FlatAction { text: Strings.cat-browse-store; outlined: true; clicked => { CatalogModel.action("navigate", "store"); } }
            }
            Rectangle { vertical-stretch: 1; }
        }
        if !Theme.scribe: Rectangle {
            x: Theme.margin; y: parent.height - 60px; width: parent.width - 2 * Theme.margin; height: 52px;
            background: local-downloads-hit.pressed ? Theme.ink : Theme.paper;
            Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.line; }
            CatalogText { x: 0px; y: 0px; width: parent.width - 100px; height: parent.height; text: CatalogModel.local-download-count < 0 ? Strings.cat-local-download-checking : Strings.cat-local-download-prefix + CatalogModel.local-download-count + Strings.cat-local-download-unit; font-size: 15px; color: local-downloads-hit.pressed ? Theme.paper : Theme.ink; }
            CatalogText { x: parent.width - 76px; y: 0px; width: 44px; height: parent.height; text: Strings.cat-view; font-size: 15px; color: local-downloads-hit.pressed ? Theme.paper : Theme.ink; horizontal-alignment: right; }
            Icon { x: parent.width - 24px; y: (parent.height - 18px) / 2; width: 18px; height: 18px; kind: "next"; inverted: local-downloads-hit.pressed; }
            local-downloads-hit := CatalogHitArea { x: 0px; y: 0px; width: parent.width; height: parent.height; tapped => { CatalogModel.action("navigate", "downloads"); } }
        }
    }
    if CatalogModel.shelf-state == "syncing" || CatalogModel.shelf-state == "empty": Rectangle { x: 0px; width: 100%;
        y: root.header-height;
        height: parent.height - self.y;
        VerticalLayout { x: 0px; y: 0px; width: 100%; height: 100%;
            padding-left: Theme.scribe ? 120px : 48px;
            padding-right: Theme.scribe ? 120px : 48px;
            spacing: 16px;
            Rectangle { vertical-stretch: 1; }
            CatalogText { height: Theme.scribe ? 42px : 34px; text: CatalogModel.shelf-state == "syncing" ? Strings.cat-syncing-title : Strings.cat-empty-shelf; font-size: Theme.scribe ? 28px : 22px; font-weight: 700; horizontal-alignment: center; }
            CatalogText { height: 80px; text: CatalogModel.status-message; wrap: word-wrap; horizontal-alignment: center; font-size: Theme.caption-size; color: Theme.secondary; }
            HorizontalLayout { height: Theme.button-height; spacing: 12px; FlatAction { text: Strings.cat-browse-store; outlined: true; clicked => { CatalogModel.action("navigate", "store"); } } FlatAction { text: Strings.cat-search; outlined: true; clicked => { CatalogModel.action("search.open", ""); } } }
            Rectangle { vertical-stretch: 1; }
        }
    }
    FlatAction {
        x: parent.width - Theme.margin - self.width;
        y: root.resume-height + (Theme.scribe ? 8px : 6px);
        width: Theme.scribe ? 56px : 72px; height: Theme.scribe ? 56px : 48px;
        text: Strings.cat-filter; label: Strings.cat-filter-sort; text-size: Theme.scribe ? 18px : 16px;
        outlined: true;
        clicked => { CatalogModel.action("shelf.menu", "toggle"); }
    }
    if CatalogModel.shelf-menu-open: Rectangle { x: 0px; y: 0px; width: 100%; height: 100%;
        CatalogHitArea { x: 0px; y: 0px; width: 100%; height: 100%; tapped => { CatalogModel.action("shelf.menu", "close"); } }
        ShelfMenu { x: parent.width - self.width - Theme.margin; y: min(root.resume-height + root.controls-height - 3px, max(0px, parent.height - self.height - 8px)); }
    }
}

export component StoreScreen inherits Rectangle {
    background: Theme.paper;
    clip: true;
    property <length> header-height: Theme.scribe ? 72px : 56px;
    property <length> categories-height: Theme.scribe ? 140px : 0px;
    property <length> pager-height: Theme.scribe ? 60px : 56px;
    Rectangle { x: 0px; y: 0px; width: 100%;
        height: root.header-height;
        Rectangle {
            x: Theme.margin;
            y: Theme.scribe ? 8px : 4px;
            width: parent.width - Theme.margin * 2;
            height: Theme.scribe ? 56px : 48px;
            border-width: 2px;
            border-color: Theme.ink;
            background: search-hit.pressed ? Theme.ink : Theme.paper;
            accessible-role: button;
            accessible-label: Strings.cat-search;
            accessible-action-default => { CatalogModel.action("search.open", ""); }
            Icon { x: Theme.scribe ? 16px : 12px; y: (parent.height - self.height) / 2; kind: "search"; inverted: search-hit.pressed; }
            CatalogText { y: 0px; height: 100%; x: Theme.scribe ? 50px : 40px; width: parent.width - self.x - 12px; text: Strings.cat-search-placeholder; font-size: Theme.scribe ? 19px : 16px; color: search-hit.pressed ? Theme.paper : Theme.muted; }
        }
        search-hit := CatalogHitArea {
            x: Theme.margin; y: 0px;
            width: parent.width - Theme.margin * 2; height: parent.height - 1px;
            tapped => { CatalogModel.action("search.open", ""); }
        }
        Rectangle { x: 0px; width: 100%; y: parent.height - 1px; height: 1px; background: Theme.ink; }
    }
    if Theme.scribe: Rectangle { x: 0px; width: 100%;
        y: root.header-height;
        height: root.categories-height;
        for category[index] in CatalogModel.categories: FlatAction {
            x: Theme.margin + mod(index, 6) * ((parent.width - 2 * Theme.margin - 50px) / 6 + 10px);
            y: 18px + floor(index / 6) * 62px;
            width: (parent.width - 2 * Theme.margin - 50px) / 6;
            height: 52px;
            text: category.label;
            text-size: 18px;
            selected: category.selected;
            outlined: true;
            clicked => { CatalogModel.action("store.category", category.id); }
        }
    }
    Rectangle { x: 0px; width: 100%;
        y: root.header-height + root.categories-height;
        height: root.pager-height;
        if !Theme.scribe: Rectangle {
            x: Theme.margin; y: 6px; height: 44px; width: 112px; border-width: 2px; border-color: Theme.ink;
            background: picker-hit.pressed ? Theme.ink : Theme.paper;
            CatalogText { x: 12px; y: 0px; width: parent.width - 40px; height: parent.height; text: CatalogModel.category-label; font-size: 16px; font-weight: 700; color: picker-hit.pressed ? Theme.paper : Theme.ink; }
            Path { x: parent.width - 26px; y: (parent.height - 14px) / 2; width: 14px; height: 14px; viewbox-width: 24; viewbox-height: 24; commands: "M5 8 H19 L12 17 Z"; fill: picker-hit.pressed ? Theme.paper : Theme.ink; }
            picker-hit := CatalogHitArea { x: 0px; y: 0px; width: parent.width; height: parent.height; tapped => { CatalogModel.action("store.picker", "toggle"); } }
        }
        if !Theme.scribe: CatalogText { y: 0px; height: 100%;
            x: 146px;
            width: parent.width - self.x - (Theme.scribe ? 208px : 156px);
            text: CatalogModel.category-meta;
            font-size: 14px;
            color: Theme.secondary;
        }
        if Theme.scribe: HorizontalLayout {
            x: Theme.margin; y: 0px; width: parent.width - Theme.margin - 208px; height: parent.height; spacing: 0px;
            CatalogText { text: CatalogModel.category-label; font-size: 18px; font-weight: 700; horizontal-stretch: 0; }
            CatalogText { text: " · " + CatalogModel.category-meta; font-size: 18px; color: Theme.secondary; horizontal-stretch: 1; }
        }
        InlinePager { x: parent.width - self.width - (Theme.scribe ? 32px : 8px); y: (parent.height - self.height) / 2; page: CatalogModel.store-page; pages: CatalogModel.store-pages; turn(delta) => { CatalogModel.action("store.page", delta); } }
    }
    ComicGrid { x: 0px; width: 100%;
        y: root.header-height + root.categories-height + root.pager-height + 4px;
        height: parent.height - self.y;
        items: CatalogModel.store-items;
        store-mode: true;
        open(id) => { CatalogModel.action("comic.open", id); }
        turn(delta) => { CatalogModel.action("store.page", delta); }
    }
    if CatalogModel.category-picker-open: Rectangle { x: 0px; y: 0px; width: 100%; height: 100%;
        CatalogHitArea { x: 0px; y: 0px; width: 100%; height: 100%; tapped => { CatalogModel.action("store.picker", "close"); } }
        Rectangle {
            x: Theme.margin;
            y: root.header-height + root.pager-height + 20px;
            width: parent.width - 2 * Theme.margin;
            height: 344px;
            background: Theme.paper;
            border-width: 2px;
            border-color: Theme.ink;
            CatalogText { x: 18px; y: 12px; height: 30px; width: 140px; text: Strings.cat-official-genres; font-size: 20px; font-weight: 700; }
            CatalogText { x: 160px; y: 12px; height: 30px; width: parent.width - 178px; text: Strings.cat-popularity-order; font-size: 14px; horizontal-alignment: right; color: Theme.secondary; }
            for category[index] in CatalogModel.categories: FlatAction {
                x: 18px + mod(index, 3) * ((parent.width - 52px) / 3 + 8px);
                y: 54px + floor(index / 3) * 60px;
                width: (parent.width - 52px) / 3;
                height: 52px;
                text: category.label;
                text-size: 16px;
                outlined: true;
                selected: category.selected;
                clicked => { CatalogModel.action("store.category", category.id); }
            }
            Rectangle { x: 18px; y: 294px; width: parent.width - 36px; height: 1px; background: Theme.line; }
            CatalogText { x: 18px; y: 298px; width: parent.width - 114px; height: 44px; text: Strings.cat-recommendations-offline; font-size: 14px; color: Theme.secondary; }
            FlatAction { x: parent.width - 94px; y: 294px; width: 76px; height: 48px; text: Strings.cat-cancel; text-size: 16px; clicked => { CatalogModel.action("store.picker", "close"); } }
        }
    }
}

