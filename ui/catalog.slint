import { Theme } from "theme.slint";
import { Strings } from "strings.slint";
import { ActionButton, IconButton, Icon, BookCover, NavigationButton } from "widgets.slint";
import { TouchKeyboard } from "keyboard.slint";

export struct ComicItem {
    id: string,
    title: string,
    author: string,
    cover: image,
    subtitle: string,
    meta: string,
    badge: string,
    downloaded: bool,
    progress: float,
    in-shelf: bool,
    description: string,
    read-label: string,
}

export struct EpisodeItem {
    id: string,
    order: string,
    title: string,
    reading: string,
    access: string,
    storage: string,
    readable: bool,
    selected: bool,
    current: bool,
    downloaded: bool,
    queued: bool,
    temporary: bool,
    locked: bool,
}

export struct CategoryItem { id: string, label: string, selected: bool }
export struct SearchHistoryItem { query: string, meta: string }

export global CatalogModel {
    callback action(string, string);
    in-out property <[ComicItem]> shelf-items;
    in-out property <[ComicItem]> store-items;
    in-out property <[ComicItem]> search-items;
    in-out property <[ComicItem]> suggestions;
    in-out property <[EpisodeItem]> episodes;
    in-out property <ComicItem> resume;
    in-out property <bool> has-resume;
    in-out property <string> shelf-state: "ready";
    in-out property <string> shelf-view: "grid";
    in-out property <string> shelf-filter: "all";
    in-out property <bool> shelf-menu-open;
    in-out property <int> shelf-page: 1;
    in-out property <int> shelf-pages: 1;
    in-out property <string> shelf-count-label;
    in-out property <string> sync-label;
    in-out property <[string]> filter-counts;
    in-out property <int> local-download-count;
    in-out property <[CategoryItem]> categories;
    in-out property <string> category-label;
    in-out property <string> category-meta;
    in-out property <bool> category-filtered;
    in-out property <bool> category-picker-open;
    in-out property <int> store-page: 1;
    in-out property <int> store-pages: 1;
    in-out property <string> query;
    in-out property <string> composition;
    in-out property <[string]> candidates;
    in-out property <int> candidate-page;
    in-out property <int> candidate-pages: 1;
    in-out property <bool> latin;
    in-out property <bool> numeric;
    in-out property <bool> keyboard-visible: true;
    in-out property <string> search-state: "recent";
    in-out property <[SearchHistoryItem]> history;
    in-out property <string> search-result-label;
    in-out property <string> empty-search-title;
    in-out property <int> search-page: 1;
    in-out property <int> search-pages: 1;
    in-out property <ComicItem> detail;
    in-out property <string> detail-back-label: Strings.nav-shelf;
    in-out property <bool> detail-loading;
    in-out property <bool> detail-locate-visible;
    in-out property <bool> detail-can-select-page;
    in-out property <bool> detail-page-selected;
    in-out property <int> detail-unread;
    in-out property <int> detail-readable;
    in-out property <int> detail-downloaded;
    in-out property <int> detail-total;
    in-out property <int> episode-page: 1;
    in-out property <int> episode-pages: 1;
    in-out property <string> episode-filter: "all";
    in-out property <bool> episode-descending;
    in-out property <bool> download-selecting;
    in-out property <int> selection-count;
    in-out property <string> status-message;
}

component CatalogText inherits Text {
    color: Theme.ink;
    font-family: Theme.ui-font;
    font-size: Theme.body-size;
    vertical-alignment: center;
    overflow: elide;
}

component CatalogHitArea inherits TouchArea {
    callback tapped();
    callback swiped(int);
    property <length> down-x;
    property <length> down-y;
    property <bool> gesture-moved;
    pointer-event(event) => {
        if event.kind == PointerEventKind.down {
            root.down-x = self.mouse-x;
            root.down-y = self.mouse-y;
            root.gesture-moved = false;
            Theme.refresh("press");
        }
        if event.kind == PointerEventKind.up {
            if abs(self.mouse-x - root.down-x) >= 64px && abs(self.mouse-x - root.down-x) > abs(self.mouse-y - root.down-y) {
                root.gesture-moved = true;
                root.swiped(self.mouse-x < root.down-x ? 1 : -1);
            } else if abs(self.mouse-y - root.down-y) >= 64px {
                root.gesture-moved = true;
            }
            Theme.refresh("release");
        }
    }
    clicked => { if !root.gesture-moved { root.tapped(); } }
}

component BackAction inherits NavigationButton {
    icon: "back";
    height: Theme.header-height;
    text-size: Theme.scribe ? 20px : 17px;
    icon-size: Theme.scribe ? 28px : 22px;
}

component InlinePager inherits Rectangle {
    in property <int> page: 1;
    in property <int> pages: 1;
    callback turn(int);
    property <length> arrow-size: Theme.scribe ? 56px : 48px;
    height: root.arrow-size;
    width: 2 * root.arrow-size + numbers.width;
    if root.pages > 1 && root.page > 1: IconButton {
        x: 0px; y: 0px; width: root.arrow-size; height: parent.height;
        icon: "back"; label: Strings.cat-previous-page;
        icon-size: Theme.scribe ? 26px : 22px;
        clicked => { root.turn(-1); }
    }
    numbers := HorizontalLayout {
        x: root.arrow-size; y: 0px; height: parent.height;
        width: max(Theme.scribe ? 56px : 44px, current.preferred-width + total.preferred-width);
        alignment: center;
        current := CatalogText {
            text: root.pages > 1 ? root.page + "" : "";
            font-size: Theme.scribe ? 20px : 15px; font-weight: 700;
        }
        total := CatalogText {
            text: root.pages > 1 ? " / " + root.pages : "";
            font-size: Theme.scribe ? 20px : 15px;
        }
    }
    if root.pages > 1 && root.page < root.pages: IconButton {
        x: parent.width - root.arrow-size; y: 0px; width: root.arrow-size; height: parent.height;
        icon: "next"; label: Strings.cat-next-page;
        icon-size: Theme.scribe ? 26px : 22px;
        clicked => { root.turn(1); }
    }
}

component CatalogTool inherits Rectangle {
    in property <string> text;
    in property <string> label: root.text;
    in property <string> icon;
    in property <bool> caret;
    in property <bool> selected;
    in property <bool> outlined: true;
    in property <bool> underlined;
    in property <length> text-size: Theme.scribe ? 18px : 15px;
    in property <length> horizontal-padding: Theme.scribe ? 18px : 12px;
    in property <int> text-weight: 700;
    callback clicked();
    property <bool> inverted: root.selected || hit.pressed;
    property <length> icon-size: Theme.scribe ? 22px : 18px;
    property <length> side-gap: Theme.scribe ? 6px : 4px;
    property <length> content-width: caption.preferred-width
        + (root.icon == "" ? 0px : root.icon-size + root.side-gap)
        + (root.caret ? 16px + root.side-gap : 0px);
    width: max(Theme.touch-size, root.content-width + 2 * root.horizontal-padding);
    height: Theme.scribe ? 56px : 44px;
    background: root.inverted ? Theme.ink : Theme.paper;
    border-width: root.outlined ? 2px : 0px;
    border-color: Theme.ink;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    if root.icon != "": Icon {
        x: max(root.horizontal-padding, (parent.width - root.content-width) / 2);
        y: (parent.height - self.height) / 2;
        width: root.icon-size; height: self.width; kind: root.icon; inverted: root.inverted;
    }
    caption := CatalogText {
        x: max(root.horizontal-padding, (parent.width - root.content-width) / 2)
            + (root.icon == "" ? 0px : root.icon-size + root.side-gap);
        y: 0px;
        width: max(0px, min(self.preferred-width, parent.width - self.x - root.horizontal-padding - (root.caret ? 16px + root.side-gap : 0px)));
        height: parent.height;
        text: root.text; font-size: root.text-size; font-weight: root.text-weight;
        color: root.inverted ? Theme.paper : Theme.ink;
    }
    if root.caret: Path {
        x: caption.x + caption.width + root.side-gap;
        y: (parent.height - self.height) / 2;
        width: 16px; height: 16px; viewbox-width: 24; viewbox-height: 24;
        commands: "M6 9 H18 L12 16 Z";
        fill: root.inverted ? Theme.paper : Theme.ink;
    }
    if root.underlined: Rectangle {
        x: caption.x; y: (parent.height + root.text-size) / 2 + 2px; width: caption.width; height: 1px;
        background: root.inverted ? Theme.paper : Theme.ink;
    }
    hit := CatalogHitArea {
        x: 0px; y: (parent.height - self.height) / 2;
        width: parent.width; height: max(Theme.touch-size, parent.height);
        tapped => { root.clicked(); }
    }
}

component ComicGrid inherits Flickable {
    in property <[ComicItem]> items;
    in property <bool> store-mode;
    callback open(string);
    callback read(string);
    callback turn(int);
    property <int> columns: Theme.scribe ? (root.store-mode ? 5 : 6) : 3;
    property <length> edge: Theme.scribe ? Theme.margin : 16px;
    property <length> gap-x: Theme.scribe && root.store-mode ? 24px : 20px;
    property <length> gap-y: Theme.scribe ? (root.store-mode ? 20px : 24px) : (root.store-mode ? 16px : 18px);
    property <length> column-width: (root.width - 2 * root.edge - (root.columns - 1) * root.gap-x) / root.columns;
    property <length> tile-width: Theme.scribe ? root.column-width : min(root.column-width, root.store-mode ? 174px : 177px);
    property <length> cover-height: root.tile-width * 4 / 3;
    property <length> caption-height: Theme.scribe ? (root.store-mode ? 55px : 58px) : (root.store-mode ? 54px : 52px);
    property <length> tile-height: root.cover-height + root.caption-height;
    viewport-width: root.width;
    viewport-height: max(root.height, ceil(root.items.length / root.columns) * (root.tile-height + root.gap-y) - root.gap-y);
    interactive: root.viewport-height > root.height;
    for comic[index] in root.items: Rectangle {
        x: root.edge + mod(index, root.columns) * (root.column-width + root.gap-x) + (root.column-width - root.tile-width) / 2;
        y: floor(index / root.columns) * (root.tile-height + root.gap-y);
        width: root.tile-width;
        height: root.tile-height;
        BookCover {
            x: 0px; y: 0px; width: parent.width; height: root.cover-height;
            cover: comic.cover; title: "";
            badge: root.store-mode ? (comic.in-shelf ? Strings.cat-in-shelf : "") : comic.badge;
            secondary-badge: root.store-mode ? comic.badge : "";
            progress: root.store-mode ? 0 : comic.progress;
        }
        if comic.cover.width == 0: CatalogText {
            x: 8px; y: 0px; width: parent.width - 16px; height: root.cover-height;
            text: Strings.cat-cover-not-cached; font-size: Theme.minimum-size;
            color: Theme.secondary; horizontal-alignment: center;
        }
        if !root.store-mode: CatalogHitArea {
            x: 0px; y: 0px; width: parent.width; height: root.cover-height;
            accessible-role: button;
            accessible-label: Strings.cat-continue-reading + " · " + comic.title;
            accessible-action-default => { root.read(comic.id); }
            tapped => { root.read(comic.id); }
            swiped(delta) => { root.turn(delta); }
        }
        Rectangle {
            x: 0px; y: root.cover-height; width: parent.width; height: root.caption-height;
            background: Theme.paper;
            CatalogText {
                x: 0px; y: Theme.scribe ? 7px : 6px; width: parent.width; height: Theme.scribe ? 25px : 23px;
                text: comic.title; font-size: Theme.scribe ? 18px : 16px; font-weight: 700;
            }
            CatalogText {
                x: 0px; y: Theme.scribe ? 32px : 29px; width: parent.width; height: Theme.scribe ? 23px : 20px;
                text: comic.meta; font-size: Theme.minimum-size;
                color: Theme.secondary;
            }
            if !root.store-mode: CatalogHitArea {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                accessible-role: button;
                accessible-label: comic.title;
                accessible-action-default => { root.open(comic.id); }
                tapped => { root.open(comic.id); }
                swiped(delta) => { root.turn(delta); }
            }
        }
        if root.store-mode: Rectangle {
            x: 0px; y: 0px; width: parent.width; height: parent.height;
            accessible-role: button;
            accessible-label: comic.title + (comic.badge == "" ? "" : " · " + comic.badge);
            accessible-action-default => { root.open(comic.id); }
            CatalogHitArea {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                tapped => { root.open(comic.id); }
                swiped(delta) => { root.turn(delta); }
            }
        }
    }
}

component ShelfList inherits Flickable {
    in property <[ComicItem]> items;
    callback open(string);
    callback read(string);
    callback turn(int);
    property <length> row-height: Theme.scribe ? 92px : 76px;
    property <length> edge: Theme.scribe ? Theme.margin : 16px;
    viewport-width: root.width;
    viewport-height: max(root.height, 1px + root.items.length * root.row-height);
    interactive: root.viewport-height > root.height;
    Rectangle { x: 0px; y: 0px; width: root.width; height: 1px; background: Theme.ink; }
    for comic[index] in root.items: Rectangle {
        x: 0px; y: 1px + index * root.row-height; width: root.width; height: root.row-height;
        background: hit.pressed ? Theme.ink : Theme.paper;
        accessible-role: button;
        accessible-label: Strings.cat-continue-reading + " · " + comic.title;
        accessible-action-default => { root.read(comic.id); }
        Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.line; }
        cover := BookCover {
            x: root.edge; y: (parent.height - self.height) / 2;
            width: Theme.scribe ? 60px : 48px; height: Theme.scribe ? 80px : 64px;
            cover: comic.cover; title: ""; progress: comic.progress;
        }
        Rectangle {
            x: cover.x + cover.width + (Theme.scribe ? 20px : 12px);
            y: (parent.height - self.height) / 2;
            width: max(0px, (comic.badge == "" ? details.x : update.x) - self.x - 16px);
            height: Theme.scribe ? 52px : 44px;
            CatalogText {
                x: 0px; y: 0px; width: parent.width; height: Theme.scribe ? 28px : 24px;
                text: comic.title; font-size: Theme.scribe ? 20px : 16px; font-weight: 700;
                color: hit.pressed ? Theme.paper : Theme.ink;
            }
            CatalogText {
                x: 0px; y: Theme.scribe ? 28px : 24px; width: parent.width; height: parent.height - self.y;
                text: comic.meta + (comic.downloaded ? " · " + Strings.cat-downloaded : "");
                font-size: Theme.scribe ? 17px : 14px; color: hit.pressed ? Theme.paper : Theme.secondary;
            }
        }
        update := Rectangle {
            x: details.x - self.width - (Theme.scribe ? 20px : 12px); y: (parent.height - self.height) / 2;
            width: comic.badge == "" ? 0px : update-label.preferred-width + 16px;
            height: Theme.scribe ? 28px : 24px;
            visible: comic.badge != "";
            background: Theme.ink;
            update-label := CatalogText {
                text: comic.badge; color: Theme.paper;
                font-size: Theme.minimum-size; font-weight: 700; horizontal-alignment: center;
            }
        }
        hit := CatalogHitArea {
            x: 0px; y: 0px; width: details.x - 8px; height: parent.height;
            tapped => { root.read(comic.id); }
            swiped(delta) => { root.turn(delta); }
        }
        details := IconButton {
            x: parent.width - self.width - (Theme.scribe ? 36px : 4px);
            y: (parent.height - self.height) / 2;
            width: Theme.scribe ? 56px : 48px; height: self.width;
            icon: "next"; icon-size: Theme.scribe ? 24px : 20px;
            label: comic.title + " · " + Strings.cat-view-chapters;
            clicked => { root.open(comic.id); }
        }
        Rectangle { x: details.x; y: details.y + (Theme.scribe ? 0px : 2px); width: 1px; height: Theme.scribe ? 56px : 44px; background: Theme.line; }
    }
}

component ShelfMenu inherits Rectangle {
    property <length> edge: Theme.scribe ? 20px : 16px;
    property <length> sync-height: Theme.scribe ? 68px : 60px;
    property <length> segment-height: Theme.scribe ? 84px : 70px;
    property <length> filter-height: Theme.scribe ? 60px : 48px;
    background: Theme.paper;
    border-width: 2px;
    border-color: Theme.ink;
    width: Theme.scribe ? 400px : 320px;
    height: 4px + root.sync-height + root.segment-height + 4 * root.filter-height;
    TouchArea { x: 0px; y: 0px; width: parent.width; height: parent.height; }
    Rectangle {
        x: 2px; y: 2px; width: parent.width - 4px; height: root.sync-height;
        background: sync-hit.pressed ? Theme.ink : Theme.paper;
        accessible-role: button;
        accessible-label: Strings.cat-sync-now;
        accessible-action-default => { CatalogModel.action("shelf.sync", ""); }
        CatalogText {
            x: root.edge; y: 0px; width: parent.width - 2 * root.edge - 108px; height: parent.height;
            text: Strings.cat-sync-now; font-size: Theme.scribe ? 20px : 16px; font-weight: 700;
            color: sync-hit.pressed ? Theme.paper : Theme.ink;
        }
        CatalogText {
            x: parent.width - root.edge - 100px; y: 0px; width: 100px; height: parent.height;
            text: CatalogModel.sync-label; font-size: Theme.scribe ? 17px : 14px;
            color: sync-hit.pressed ? Theme.paper : Theme.secondary; horizontal-alignment: right;
        }
        Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.ink; }
        sync-hit := CatalogHitArea { x: 0px; y: 0px; width: parent.width; height: parent.height; tapped => { CatalogModel.action("shelf.sync", ""); } }
    }
    Rectangle {
        x: 2px; y: 2px + root.sync-height; width: parent.width - 4px; height: root.segment-height;
        Rectangle {
            x: root.edge; y: (parent.height - self.height) / 2;
            width: parent.width - 2 * root.edge; height: Theme.scribe ? 56px : 48px;
            border-width: 2px; border-color: Theme.ink;
            HorizontalLayout {
                x: 2px; y: 2px; width: parent.width - 4px; height: parent.height - 4px;
                ActionButton {
                    horizontal-stretch: 1; height: parent.height; quiet: true;
                    text: Strings.cat-grid; text-size: Theme.scribe ? 18px : 15px;
                    selected: CatalogModel.shelf-view == "grid"; text-weight: self.selected ? 700 : 400;
                    clicked => { CatalogModel.action("shelf.view", "grid"); }
                }
                Rectangle { width: 2px; background: Theme.ink; }
                ActionButton {
                    horizontal-stretch: 1; height: parent.height; quiet: true;
                    text: Strings.cat-list; text-size: Theme.scribe ? 18px : 15px;
                    selected: CatalogModel.shelf-view == "list"; text-weight: self.selected ? 700 : 400;
                    clicked => { CatalogModel.action("shelf.view", "list"); }
                }
            }
        }
        Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.ink; }
    }
    for entry[index] in [
        { id: "all", label: Strings.cat-all },
        { id: "updated", label: Strings.cat-updated },
        { id: "downloaded", label: Strings.cat-downloaded },
        { id: "finished", label: Strings.cat-finished }
    ]: Rectangle {
        x: 2px; y: 2px + root.sync-height + root.segment-height + index * root.filter-height;
        width: parent.width - 4px; height: root.filter-height;
        property <bool> selected: CatalogModel.shelf-filter == entry.id;
        background: hit.pressed ? Theme.ink : Theme.paper;
        accessible-role: button;
        accessible-label: entry.label;
        accessible-checkable: true;
        accessible-checked: self.selected;
        accessible-action-default => { CatalogModel.action("shelf.filter", entry.id); }
        if CatalogModel.shelf-filter == entry.id: Icon {
            x: root.edge; y: (parent.height - self.height) / 2;
            width: Theme.scribe ? 24px : 20px; height: self.width; kind: "check"; inverted: hit.pressed;
        }
        CatalogText {
            x: root.edge + (Theme.scribe ? 34px : 28px); y: 0px;
            width: parent.width - self.x - root.edge - 86px; height: parent.height;
            text: entry.label; font-size: Theme.scribe ? 20px : 16px;
            font-weight: parent.selected ? 700 : 400; color: hit.pressed ? Theme.paper : Theme.ink;
        }
        CatalogText {
            x: parent.width - root.edge - 86px; y: 0px; width: 86px; height: parent.height;
            text: CatalogModel.filter-counts[index]; font-size: Theme.scribe ? 17px : 14px;
            color: hit.pressed ? Theme.paper : Theme.secondary; horizontal-alignment: right;
        }
        hit := CatalogHitArea { x: 0px; y: 0px; width: parent.width; height: parent.height; tapped => { CatalogModel.action("shelf.filter", entry.id); } }
    }
}

component ShelfResumeCard inherits Rectangle {
    in property <ComicItem> comic;
    property <length> edge: Theme.scribe ? Theme.margin : 16px;
    height: Theme.scribe ? 298px : 80px;
    BookCover {
        x: root.edge; y: Theme.scribe ? 24px : 9px;
        width: Theme.scribe ? 186px : 45px; height: Theme.scribe ? 248px : 60px;
        cover: root.comic.cover; title: "";
        accessible-role: button;
        accessible-label: Strings.cat-continue-reading + " · " + root.comic.title;
        accessible-action-default => { CatalogModel.action("comic.read", root.comic.id); }
        Path {
            x: Theme.scribe ? 12px : 6px; y: 0px;
            width: Theme.scribe ? 28px : 12px; height: Theme.scribe ? 40px : 18px;
            viewbox-width: 28; viewbox-height: 40;
            commands: "M0 0 H28 V40 L14 30 L0 40 Z"; fill: Theme.ink;
        }
    }
    CatalogHitArea {
        x: root.edge; y: Theme.scribe ? 24px : 9px;
        width: Theme.scribe ? 186px : 48px; height: Theme.scribe ? 248px : 60px;
        tapped => { CatalogModel.action("comic.read", root.comic.id); }
    }
    if Theme.scribe: Rectangle {
        x: root.edge + 218px; y: 24px; width: parent.width - self.x - root.edge; height: 248px;
        CatalogText {
            x: 0px; y: 8px; width: parent.width; height: 44px;
            text: root.comic.title; font-family: Theme.serif-font; font-size: 36px; font-weight: 700;
        }
        CatalogText { x: 0px; y: 57px; width: parent.width; height: 31px; text: root.comic.subtitle; font-size: 20px; }
        if root.comic.meta != "": Rectangle {
            x: 0px; y: 96px; width: parent.width; height: 34px;
            track := Rectangle {
                x: 0px; y: (parent.height - self.height) / 2;
                width: min(360px, max(0px, parent.width - 158px)); height: 10px;
                border-width: 1.5px; border-color: Theme.ink; background: Theme.paper;
                Rectangle { x: 0px; y: 0px; width: clamp(root.comic.progress, 0, 1) * parent.width; height: parent.height; background: Theme.ink; }
            }
            CatalogText {
                x: track.width + 14px; y: 0px; width: parent.width - self.x; height: parent.height;
                text: root.comic.meta; font-size: 18px; font-weight: 700;
            }
        }
        HorizontalLayout {
            x: 0px; y: parent.height - self.height;
            width: min(416px, parent.width); height: 64px; spacing: 16px;
            ActionButton {
                horizontal-stretch: 1; height: parent.height;
                text: Strings.cat-continue-reading; primary: true; text-size: 20px; text-weight: 700;
                clicked => { CatalogModel.action("comic.read", root.comic.id); }
            }
            ActionButton {
                horizontal-stretch: 1; height: parent.height;
                text: Strings.cat-chapters; text-size: 20px; text-weight: 400;
                clicked => { CatalogModel.action("comic.open", root.comic.id); }
            }
        }
    }
    if !Theme.scribe: Rectangle {
        x: root.edge + 59px; y: 9px; width: max(0px, parent.width - self.x - root.edge - 120px); height: 60px;
        background: title-hit.pressed ? Theme.ink : Theme.paper;
        accessible-role: button;
        accessible-label: root.comic.title;
        accessible-action-default => { CatalogModel.action("comic.open", root.comic.id); }
        CatalogText {
            x: 0px; y: 7px; width: parent.width; height: 24px;
            text: root.comic.title; font-size: 17px; font-weight: 700;
            color: title-hit.pressed ? Theme.paper : Theme.ink;
        }
        CatalogText {
            x: 0px; y: 31px; width: parent.width; height: 22px;
            text: root.comic.subtitle; font-size: 14px; color: title-hit.pressed ? Theme.paper : Theme.secondary;
        }
        title-hit := CatalogHitArea { x: 0px; y: 0px; width: parent.width; height: parent.height; tapped => { CatalogModel.action("comic.open", root.comic.id); } }
    }
    if !Theme.scribe: ActionButton {
        x: parent.width - root.edge - self.width; y: (parent.height - 2px - self.height) / 2;
        width: 108px; height: 48px; text: Strings.cat-continue-reading;
        primary: true; text-size: 16px; text-weight: 700;
        clicked => { CatalogModel.action("comic.read", root.comic.id); }
    }
    Rectangle { x: 0px; y: parent.height - 2px; width: parent.width; height: 2px; background: Theme.ink; }
}

component CatalogNotice inherits Rectangle {
    in property <string> title;
    in property <string> primary-label;
    in property <string> secondary-label;
    in property <bool> primary-filled: true;
    in property <bool> waiting;
    in property <length> heading-size: Theme.scribe ? 30px : 22px;
    in property <length> action-width: Theme.scribe ? 220px : 160px;
    callback primary();
    callback secondary();
    property <length> edge: Theme.scribe ? Theme.margin : 16px;
    property <length> gap: Theme.scribe ? 16px : 12px;
    property <length> button-width: min(root.action-width, max(48px, (root.width - 2 * root.edge - root.gap) / 2));
    property <length> bottom-padding: Theme.scribe ? 80px : 60px;
    property <length> title-height: Theme.scribe ? 44px : 32px;
    property <length> action-top: root.title-height + (Theme.scribe ? 24px : 20px);
    property <length> wait-width: Theme.scribe ? 40px : 28px;
    property <length> wait-height: Theme.scribe ? 18px : 14px;
    Rectangle {
        x: root.edge; y: max(0px, (parent.height - root.bottom-padding - self.height) / 2);
        width: parent.width - 2 * root.edge;
        height: root.action-top + (root.waiting ? root.wait-height : Theme.button-height);
        CatalogText {
            x: 0px; y: 0px; width: parent.width; height: root.title-height;
            text: root.title; font-size: root.heading-size; font-weight: 700; horizontal-alignment: center;
        }
        if root.waiting: Rectangle {
            x: (parent.width - self.width) / 2; y: root.action-top;
            width: 4 * root.wait-width + 30px; height: root.wait-height;
            for index in 4: Rectangle {
                x: index * (root.wait-width + 10px); y: 0px; width: root.wait-width; height: parent.height;
                border-width: 2px; border-color: Theme.ink; background: index == 1 ? Theme.ink : Theme.paper;
            }
        }
        if !root.waiting: HorizontalLayout {
            x: (parent.width - self.width) / 2; y: root.action-top;
            width: 2 * root.button-width + root.gap; height: Theme.button-height; spacing: root.gap;
            ActionButton {
                width: root.button-width; height: parent.height;
                text: root.primary-label; primary: root.primary-filled;
                text-size: Theme.body-size; text-weight: root.primary-filled ? 700 : 400;
                clicked => { root.primary(); }
            }
            ActionButton {
                width: root.button-width; height: parent.height;
                text: root.secondary-label; text-size: Theme.body-size; text-weight: 400;
                clicked => { root.secondary(); }
            }
        }
    }
}

export component ShelfScreen inherits Rectangle {
    background: Theme.paper;
    clip: true;
    property <length> edge: Theme.scribe ? Theme.margin : 16px;
    property <bool> show-resume: CatalogModel.has-resume && (Theme.scribe || CatalogModel.shelf-filter == "all");
    property <length> resume-height: root.show-resume ? (Theme.scribe ? 298px : 80px) : 0px;
    property <length> controls-height: Theme.scribe ? 72px : 56px;
    property <length> contents-y: root.resume-height + root.controls-height;
    if CatalogModel.shelf-state == "ready": Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        if root.show-resume: ShelfResumeCard {
            x: 0px; y: 0px; width: parent.width; height: root.resume-height;
            comic: CatalogModel.resume;
        }
        Rectangle {
            x: 0px; y: root.resume-height; width: parent.width; height: root.controls-height;
            CatalogText {
                x: root.edge; y: 0px; width: max(0px, pager.x - root.edge - 8px); height: parent.height;
                text: CatalogModel.shelf-count-label; font-size: Theme.scribe ? 20px : 15px; font-weight: 700;
            }
            pager := InlinePager {
                x: filter.x - self.width - (Theme.scribe ? 16px : 8px);
                y: (parent.height - self.height) / 2;
                page: CatalogModel.shelf-page; pages: CatalogModel.shelf-pages;
                turn(delta) => { CatalogModel.action("shelf.page", delta); }
            }
            filter := CatalogTool {
                x: parent.width - root.edge - self.width; y: (parent.height - self.height) / 2;
                icon: "filter"; label: Strings.cat-filter-sort;
                text: CatalogModel.shelf-filter == "updated" ? Strings.cat-updated : CatalogModel.shelf-filter == "downloaded" ? Strings.cat-downloaded : CatalogModel.shelf-filter == "finished" ? Strings.cat-finished : Strings.cat-filter;
                selected: CatalogModel.shelf-filter != "all";
                clicked => { CatalogModel.action("shelf.menu", "toggle"); }
            }
        }
        if CatalogModel.shelf-view == "grid": ComicGrid {
            x: 0px; y: root.contents-y + (Theme.scribe ? 8px : 4px); width: parent.width; height: max(0px, parent.height - self.y);
            items: CatalogModel.shelf-items;
            open(id) => { CatalogModel.action("comic.open", id); }
            read(id) => { CatalogModel.action("comic.cover", id); }
            turn(delta) => { CatalogModel.action("shelf.page", delta); }
        }
        if CatalogModel.shelf-view == "list": ShelfList {
            x: 0px; y: root.contents-y; width: parent.width; height: max(0px, parent.height - self.y);
            items: CatalogModel.shelf-items;
            open(id) => { CatalogModel.action("comic.open", id); }
            read(id) => { CatalogModel.action("comic.cover", id); }
            turn(delta) => { CatalogModel.action("shelf.page", delta); }
        }
        if CatalogModel.shelf-menu-open: Rectangle {
            x: 0px; y: 0px; width: parent.width; height: parent.height;
            TouchArea { x: 0px; y: 0px; width: parent.width; height: parent.height; clicked => { CatalogModel.action("shelf.menu", "close"); } }
            Rectangle { x: menu.x - 14px; y: menu.y + 14px; width: menu.width; height: menu.height; background: Theme.paper; }
            menu := ShelfMenu {
                x: parent.width - root.edge - self.width;
                y: max(0px, min(root.contents-y + (Theme.scribe ? 14px : -2px), parent.height - self.height - 14px));
            }
        }
    }
    if CatalogModel.shelf-state != "ready": Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        property <bool> signed-out: CatalogModel.shelf-state == "signed-out";
        property <bool> waiting: CatalogModel.shelf-state == "syncing";
        property <length> header-height: Theme.scribe ? 72px : 60px;
        property <length> local-height: self.signed-out ? (Theme.scribe ? 72px : 60px) : 0px;
        CatalogText {
            x: root.edge; y: 0px; width: parent.width - 2 * root.edge; height: parent.header-height;
            text: Strings.cat-shelf; font-size: Theme.scribe ? 26px : 20px; font-weight: 700;
        }
        Rectangle { x: 0px; y: parent.header-height - 2px; width: parent.width; height: 2px; background: Theme.ink; }
        CatalogNotice {
            x: 0px; y: parent.header-height; width: parent.width; height: max(0px, parent.height - self.y - parent.local-height);
            title: parent.signed-out ? Strings.cat-signin-title : parent.waiting ? Strings.cat-shelf-syncing-title : Strings.cat-empty-shelf;
            waiting: parent.waiting;
            primary-label: parent.signed-out ? Strings.cat-qr-login : Strings.cat-browse-store;
            secondary-label: parent.signed-out ? Strings.cat-browse-store : Strings.cat-search;
            primary-filled: parent.signed-out;
            primary => { CatalogModel.action("navigate", parent.signed-out ? "login" : "store"); }
            secondary => { if parent.signed-out { CatalogModel.action("navigate", "store"); } else { CatalogModel.action("search.open", ""); } }
        }
        if CatalogModel.shelf-state == "signed-out": Rectangle {
            x: root.edge; y: parent.height - self.height - 8px;
            width: parent.width - 2 * root.edge; height: Theme.scribe ? 64px : 52px;
            background: downloads-hit.pressed ? Theme.ink : Theme.paper;
            accessible-role: button;
            accessible-label: download-count.text + " · " + Strings.cat-view;
            accessible-action-default => { CatalogModel.action("navigate", "downloads"); }
            Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.line; }
            download-count := CatalogText {
                x: 0px; y: 0px; width: parent.width - 90px; height: parent.height;
                text: CatalogModel.local-download-count < 0 ? Strings.cat-local-download-checking : Strings.cat-local-download-prefix + CatalogModel.local-download-count + Strings.cat-local-download-unit;
                font-size: Theme.scribe ? 20px : 16px; color: downloads-hit.pressed ? Theme.paper : Theme.ink;
            }
            CatalogText {
                x: parent.width - 76px; y: 0px; width: 46px; height: parent.height;
                text: Strings.cat-view; font-size: Theme.scribe ? 20px : 16px;
                horizontal-alignment: right; color: downloads-hit.pressed ? Theme.paper : Theme.ink;
            }
            Icon {
                x: parent.width - self.width; y: (parent.height - self.height) / 2;
                width: Theme.scribe ? 22px : 18px; height: self.width;
                kind: "next"; inverted: downloads-hit.pressed;
            }
            downloads-hit := CatalogHitArea { x: 0px; y: 0px; width: parent.width; height: parent.height; tapped => { CatalogModel.action("navigate", "downloads"); } }
        }
    }
}

component CatalogSearchField inherits Rectangle {
    in property <string> query;
    in property <string> composition;
    in property <string> placeholder: Strings.cat-search-placeholder;
    in property <string> label: Strings.cat-search;
    in property <bool> show-cursor;
    in property <bool> large-text;
    in property <bool> press-feedback;
    callback activate();
    callback clear();
    property <bool> has-value: root.query != "" || root.composition != "";
    property <bool> inverted: root.press-feedback && field-hit.pressed;
    property <length> clear-width: Theme.scribe ? 56px : 48px;
    property <length> field-size: root.large-text ? (Theme.scribe ? 22px : 18px) : (Theme.scribe ? 20px : 16px);
    border-width: 2px;
    border-color: Theme.ink;
    background: root.inverted ? Theme.ink : Theme.paper;
    accessible-role: button;
    accessible-label: root.has-value ? root.label + " · " + root.query + root.composition : root.label;
    accessible-action-default => { root.activate(); }
    search-icon := Icon {
        x: Theme.scribe ? 18px : 14px; y: (parent.height - self.height) / 2;
        width: Theme.scribe ? 24px : 20px; height: self.width;
        kind: "search"; inverted: root.inverted;
    }
    Rectangle {
        x: search-icon.x + search-icon.width + 10px; y: 0px;
        width: max(0px, parent.width - self.x - (root.has-value ? root.clear-width + 18px : 12px));
        height: parent.height; clip: true;
        text-value := CatalogText {
            x: 0px; y: 0px; height: parent.height;
            width: min(self.preferred-width, max(0px, parent.width - spelling.width - (root.show-cursor ? 3px : 0px)));
            text: root.has-value ? root.query : root.placeholder;
            font-size: root.field-size;
            color: root.inverted ? Theme.paper : root.has-value ? Theme.ink : Theme.secondary;
        }
        spelling := CatalogText {
            x: text-value.width; y: 0px; height: parent.height;
            width: root.composition == "" ? 0px : min(self.preferred-width, parent.width * 0.45);
            text: root.composition; font-size: Theme.scribe ? 20px : 16px;
        }
        if root.composition != "": Rectangle {
            x: spelling.x; y: (parent.height + spelling.font-size) / 2 + 2px;
            width: spelling.width; height: 2px; background: Theme.ink;
        }
        if root.show-cursor: Rectangle {
            x: text-value.width + spelling.width + 1px; y: (parent.height - self.height) / 2;
            width: 2px; height: Theme.scribe ? 30px : 24px; background: Theme.ink;
        }
    }
    field-hit := CatalogHitArea {
        x: 0px; y: (parent.height - self.height) / 2;
        height: max(Theme.touch-size, parent.height);
        width: parent.width - (root.has-value ? root.clear-width + 12px : 0px);
        tapped => { root.activate(); }
    }
    if root.has-value: IconButton {
        x: parent.width - self.width - 4px; y: (parent.height - self.height) / 2;
        width: root.clear-width; height: root.clear-width;
        icon: "close"; icon-size: Theme.scribe ? 24px : 20px;
        label: Strings.cat-clear;
        clicked => { root.clear(); }
    }
}

component StoreCategories inherits Rectangle {
    property <length> edge: Theme.scribe ? Theme.margin : 14px;
    property <int> columns: Theme.scribe ? 6 : 4;
    property <length> gap: Theme.scribe ? 10px : 8px;
    property <length> row-gap: Theme.scribe ? 10px : 12px;
    property <length> top: Theme.scribe ? 16px : 14px;
    property <length> button-height: Theme.scribe ? 52px : 44px;
    property <int> rows: ceil(CatalogModel.categories.length / root.columns);
    property <length> column-width: (root.width - 2 * root.edge - (root.columns - 1) * root.gap) / root.columns;
    height: root.top + root.rows * (root.button-height + root.row-gap) - root.row-gap + (Theme.scribe ? 0px : 14px);
    for category[index] in CatalogModel.categories: CatalogTool {
        x: root.edge + mod(index, root.columns) * (root.column-width + root.gap);
        y: root.top + floor(index / root.columns) * (root.button-height + root.row-gap);
        width: root.column-width; height: root.button-height;
        text: category.label; selected: category.selected;
        text-size: Theme.scribe ? 18px : 16px;
        text-weight: category.selected ? 700 : 400;
        clicked => { CatalogModel.action("store.category", category.id); }
    }
}

export component StoreScreen inherits Rectangle {
    background: Theme.paper;
    clip: true;
    property <length> edge: Theme.scribe ? Theme.margin : 16px;
    property <length> header-height: Theme.scribe ? 80px : 60px;
    property <length> picker-height: Theme.scribe ? 72px : 56px;
    property <length> categories-height: Theme.scribe ? 16px + ceil(CatalogModel.categories.length / 6) * 62px - 10px : 0px;
    property <length> grid-top: root.header-height + root.categories-height + root.picker-height;
    Rectangle {
        x: 0px; y: 0px; width: parent.width; height: root.header-height;
        CatalogSearchField {
            x: root.edge; y: (parent.height - 2px - self.height) / 2;
            width: parent.width - 2 * root.edge; height: Theme.scribe ? 56px : 44px;
            press-feedback: true;
            activate => { CatalogModel.action("search.open", ""); }
        }
        Rectangle { x: 0px; y: parent.height - 2px; width: parent.width; height: 2px; background: Theme.ink; }
    }
    if Theme.scribe: StoreCategories { x: 0px; y: root.header-height; width: parent.width; }
    Rectangle {
        x: 0px; y: root.header-height + root.categories-height; width: parent.width; height: root.picker-height;
        if !Theme.scribe: CatalogTool {
            x: root.edge; y: (parent.height - self.height) / 2;
            text: CatalogModel.category-label; horizontal-padding: 10px; caret: true;
            selected: CatalogModel.category-filtered;
            clicked => { CatalogModel.action("store.picker", "toggle"); }
        }
        if Theme.scribe: CatalogText {
            x: root.edge; y: 0px; width: max(0px, pager.x - root.edge - 8px); height: parent.height;
            text: CatalogModel.category-meta; font-size: 17px; color: Theme.secondary;
        }
        pager := InlinePager {
            x: parent.width - self.width - (Theme.scribe ? 40px : 6px); y: (parent.height - self.height) / 2;
            page: CatalogModel.store-page; pages: CatalogModel.store-pages;
            turn(delta) => { CatalogModel.action("store.page", delta); }
        }
    }
    ComicGrid {
        x: 0px; y: root.grid-top + (Theme.scribe ? 0px : 4px); width: parent.width; height: max(0px, parent.height - self.y);
        items: CatalogModel.store-items; store-mode: true;
        open(id) => { CatalogModel.action("comic.open", id); }
        turn(delta) => { CatalogModel.action("store.page", delta); }
    }
    if !Theme.scribe && CatalogModel.category-picker-open: Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        TouchArea { x: 0px; y: 0px; width: parent.width; height: parent.height; clicked => { CatalogModel.action("store.picker", "close"); } }
        Rectangle { x: picker.x; y: picker.y + picker.height; width: picker.width; height: 14px; background: Theme.paper; }
        picker := Rectangle {
            x: root.edge; y: min(root.grid-top - 2px, max(0px, parent.height - self.height - 14px));
            width: parent.width - 2 * root.edge; height: categories.height;
            border-width: 2px; border-color: Theme.ink; background: Theme.paper;
            TouchArea { x: 0px; y: 0px; width: parent.width; height: parent.height; }
            categories := StoreCategories { x: 0px; y: 0px; width: parent.width; }
        }
    }
}

component SearchQuickRow inherits Rectangle {
    in property <string> title;
    in property <string> meta;
    in property <bool> trailing-arrow;
    callback clicked();
    property <length> edge: Theme.scribe ? Theme.margin : 16px;
    background: hit.pressed ? Theme.ink : Theme.paper;
    accessible-role: button;
    accessible-label: root.meta == "" ? root.title : root.title + " · " + root.meta;
    accessible-action-default => { root.clicked(); }
    Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.line; }
    CatalogText {
        x: root.edge; y: 0px; width: max(0px, meta-label.x - root.edge - 8px); height: parent.height;
        text: root.title; font-size: Theme.body-size; color: hit.pressed ? Theme.paper : Theme.ink;
    }
    meta-label := CatalogText {
        x: parent.width - root.edge - self.width; y: 0px;
        width: root.trailing-arrow ? 24px : min(parent.width / 3, self.preferred-width); height: parent.height;
        text: root.meta; color: hit.pressed ? Theme.paper : Theme.secondary;
        font-size: Theme.minimum-size; horizontal-alignment: right;
    }
    if root.trailing-arrow: Icon {
        x: parent.width - (Theme.scribe ? 32px : 8px) - self.width; y: (parent.height - self.height) / 2;
        width: Theme.scribe ? 24px : 20px; height: self.width; kind: "next"; inverted: hit.pressed;
    }
    if root.trailing-arrow: Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.line; }
    hit := CatalogHitArea { x: 0px; y: 0px; width: parent.width; height: parent.height; tapped => { root.clicked(); } }
}

component SearchInputResults inherits Flickable {
    property <bool> has-query: CatalogModel.query != "" || CatalogModel.composition != "";
    property <bool> show-history: !root.has-query && !CatalogModel.numeric && CatalogModel.history.length > 0;
    property <bool> show-shortcut: !root.has-query && !CatalogModel.numeric;
    property <bool> show-suggestions: root.has-query && CatalogModel.suggestions.length > 0;
    property <length> edge: Theme.scribe ? Theme.margin : 16px;
    property <length> heading-height: Theme.scribe ? 56px : 44px;
    property <length> row-height: Theme.scribe ? 64px : 52px;
    property <length> shortcut-top: root.show-history ? root.heading-height + CatalogModel.history.length * root.row-height : 0px;
    viewport-width: root.width;
    viewport-height: max(root.height, 1px + (root.show-shortcut ? root.shortcut-top + root.row-height :
        root.show-suggestions ? root.heading-height + CatalogModel.suggestions.length * root.row-height : 0px));
    interactive: root.viewport-height > root.height;
    Rectangle { x: 0px; y: 0px; width: root.width; height: 1px; background: Theme.line; }
    if root.show-history: Rectangle {
        x: 0px; y: 1px; width: root.width; height: root.shortcut-top;
        CatalogText {
            x: root.edge; y: 0px; width: parent.width - 2 * root.edge - 80px; height: root.heading-height;
            text: Strings.cat-recent-search; font-size: Theme.caption-size; color: Theme.secondary;
        }
        CatalogTool {
            x: parent.width - self.width - (Theme.scribe ? 36px : 8px); y: 0px; height: root.heading-height;
            text: Strings.cat-clear; text-size: Theme.caption-size; text-weight: 400;
            outlined: false; underlined: true; horizontal-padding: 8px;
            clicked => { CatalogModel.action("search.history.clear", ""); }
        }
        for entry[index] in CatalogModel.history: SearchQuickRow {
            x: 0px; y: root.heading-height + index * root.row-height; width: parent.width; height: root.row-height;
            title: entry.query; meta: entry.meta;
            clicked => { CatalogModel.action("search.history", entry.query); }
        }
    }
    if root.show-shortcut: SearchQuickRow {
        x: 0px; y: 1px + root.shortcut-top; width: root.width; height: root.row-height;
        title: Strings.cat-open-id; trailing-arrow: true;
        clicked => { CatalogModel.action("search.by-id", ""); }
    }
    if root.show-suggestions: Rectangle {
        x: 0px; y: 1px; width: root.width; height: root.heading-height + CatalogModel.suggestions.length * root.row-height;
        CatalogText {
            x: root.edge; y: 0px; width: parent.width - 2 * root.edge; height: root.heading-height;
            text: Strings.cat-local-matches; font-size: Theme.caption-size; color: Theme.secondary;
        }
        for comic[index] in CatalogModel.suggestions: SearchQuickRow {
            x: 0px; y: root.heading-height + index * root.row-height; width: parent.width; height: root.row-height;
            title: comic.title; meta: Strings.cat-in-shelf;
            clicked => { CatalogModel.action("comic.open", comic.id); }
        }
    }
}

component SearchResultRow inherits Rectangle {
    in property <ComicItem> comic;
    callback open();
    callback read();
    callback turn(int);
    property <length> edge: Theme.scribe ? Theme.margin : 16px;
    property <length> top: Theme.scribe ? 16px : 8px;
    property <length> action-width: Theme.scribe ? min(168px, root.width * 0.23) : 0px;
    height: Theme.scribe ? 176px : 112px;
    background: row-hit.pressed ? Theme.ink : Theme.paper;
    accessible-role: button;
    accessible-label: root.comic.title;
    accessible-action-default => { root.open(); }
    Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.line; }
    cover := BookCover {
        x: root.edge; y: root.top;
        width: Theme.scribe ? 108px : 72px; height: self.width * 4 / 3;
        cover: root.comic.cover; title: "";
    }
    Rectangle {
        x: cover.x + cover.width + (Theme.scribe ? 24px : 16px); y: root.top;
        width: max(0px, parent.width - self.x - root.edge - (Theme.scribe ? root.action-width + 24px : 0px));
        height: cover.height;
        title-band := Rectangle {
            x: 0px; y: 0px; width: parent.width; height: Theme.scribe ? 34px : 29px;
            title-label := CatalogText {
                x: 0px; y: 0px; height: parent.height;
                width: min(self.preferred-width, max(0px, parent.width - badge.width - (root.comic.in-shelf ? 12px : 0px)));
                text: root.comic.title; font-size: Theme.scribe ? 24px : 18px; font-weight: 700;
                color: row-hit.pressed ? Theme.paper : Theme.ink;
            }
            badge := Rectangle {
                x: Theme.scribe ? title-label.width + 12px : parent.width - self.width; y: (parent.height - self.height) / 2;
                width: root.comic.in-shelf ? badge-label.preferred-width + 16px : 0px;
                height: Theme.scribe ? 26px : 24px;
                visible: root.comic.in-shelf;
                border-width: 1px; border-color: row-hit.pressed ? Theme.paper : Theme.ink;
                badge-label := CatalogText {
                    text: Strings.cat-in-shelf; font-size: Theme.minimum-size; horizontal-alignment: center;
                    color: row-hit.pressed ? Theme.paper : Theme.ink;
                }
            }
        }
        if !Theme.scribe && root.comic.author != "": CatalogText {
            x: 0px; y: title-band.height + 2px; width: parent.width; height: 23px;
            text: root.comic.author; font-size: 15px; color: row-hit.pressed ? Theme.paper : Theme.secondary;
        }
        CatalogText {
            x: 0px; y: title-band.height + (Theme.scribe ? 4px : root.comic.author != "" ? 25px : 5px);
            width: parent.width; height: Theme.scribe ? 27px : 23px;
            text: Theme.scribe && root.comic.author != "" ? root.comic.author + " · " + root.comic.meta : root.comic.meta;
            font-size: Theme.scribe ? 17px : 15px; color: row-hit.pressed ? Theme.paper : Theme.secondary;
        }
    }
    row-hit := CatalogHitArea {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        tapped => { root.open(); }
        swiped(delta) => { root.turn(delta); }
    }
    if Theme.scribe: VerticalLayout {
        x: parent.width - root.edge - root.action-width; y: (parent.height - self.height) / 2 + 5px;
        width: root.action-width; height: 122px; spacing: 10px;
        ActionButton {
            height: 56px; primary: true; text-size: 18px; text-weight: 700;
            text: root.comic.read-label;
            clicked => { root.read(); }
        }
        ActionButton {
            height: 56px; text-size: 18px; text-weight: 400; text: Strings.cat-view-chapters;
            clicked => { root.open(); }
        }
    }
}

export component SearchScreen inherits Rectangle {
    background: Theme.paper;
    clip: true;
    property <length> edge: Theme.scribe ? Theme.margin : 16px;
    property <length> header-height: Theme.scribe ? 73px : 53px;
    property <length> field-band-height: Theme.scribe ? 96px : 76px;
    property <length> body-y: root.header-height + root.field-band-height;
    property <length> keyboard-height: Theme.scribe ? 395px : 311px;
    property <length> results-row-height: Theme.scribe ? 176px : 112px;
    property <length> results-head-height: Theme.scribe ? 60px : 48px;
    Rectangle {
        x: 0px; y: 0px; width: parent.width; height: root.header-height;
        BackAction {
            x: Theme.scribe ? 32px : 8px; y: (parent.height - self.height) / 2;
            height: Theme.scribe ? 56px : 48px; width: self.preferred-width;
            horizontal-padding: 4px; icon-spacing: 4px;
            text: Strings.cat-store; text-size: Theme.scribe ? 20px : 16px;
            clicked => { CatalogModel.action("navigate", "store"); }
        }
        if CatalogModel.keyboard-visible: CatalogTool {
            x: parent.width - self.width - (Theme.scribe ? 24px : 8px); y: (parent.height - self.height) / 2;
            height: Theme.scribe ? 56px : 48px; horizontal-padding: 8px;
            outlined: false; underlined: true;
            text: Strings.cat-hide-keyboard; text-size: Theme.scribe ? 20px : 16px; text-weight: 400;
            clicked => { CatalogModel.action("search.keyboard", "hide"); }
        }
        Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.ink; }
    }
    CatalogSearchField {
        x: root.edge; y: root.header-height + (root.field-band-height - self.height) / 2;
        width: parent.width - 2 * root.edge; height: Theme.scribe ? 64px : 52px;
        large-text: true;
        query: CatalogModel.query; composition: CatalogModel.composition;
        placeholder: CatalogModel.numeric ? Strings.cat-id-placeholder : Strings.cat-search-placeholder;
        label: Strings.cat-enter-search;
        show-cursor: CatalogModel.keyboard-visible;
        activate => { CatalogModel.action("search.keyboard", "show"); }
        clear => { CatalogModel.action("search.clear", ""); }
    }
    if CatalogModel.keyboard-visible: SearchInputResults {
        x: 0px; y: root.body-y; width: parent.width; height: max(0px, parent.height - self.y - root.keyboard-height);
    }
    if CatalogModel.keyboard-visible: TouchKeyboard {
        x: 0px; y: parent.height - self.height; width: parent.width;
        composition: CatalogModel.composition; candidates: CatalogModel.candidates;
        candidate-page: CatalogModel.candidate-page; candidate-pages: CatalogModel.candidate-pages;
        latin: CatalogModel.latin; numeric: CatalogModel.numeric;
        key(code) => { CatalogModel.action("search.key", code); }
        choose(index) => { Theme.refresh("keyboard"); CatalogModel.action("search.candidate", index); }
        page(delta) => { Theme.refresh("keyboard"); CatalogModel.action("search.candidate-page", delta); }
    }
    if !CatalogModel.keyboard-visible: Rectangle {
        x: 0px; y: root.body-y; width: parent.width; height: max(0px, parent.height - self.y);
        Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.ink; }
        if CatalogModel.search-items.length > 0: Rectangle {
            x: 0px; y: 1px; width: parent.width; height: parent.height - 1px;
            CatalogText {
                x: root.edge; y: 0px; width: max(0px, pager.x - root.edge - 8px); height: root.results-head-height;
                text: CatalogModel.search-result-label; font-size: Theme.scribe ? 20px : 16px; font-weight: 700;
            }
            pager := InlinePager {
                x: parent.width - self.width - (Theme.scribe ? 32px : 8px); y: (root.results-head-height - self.height) / 2;
                page: CatalogModel.search-page; pages: CatalogModel.search-pages;
                turn(delta) => { CatalogModel.action("search.page", delta); }
            }
            Flickable {
                x: 0px; y: root.results-head-height; width: parent.width; height: max(0px, parent.height - self.y);
                viewport-width: self.width;
                viewport-height: max(self.height, CatalogModel.search-items.length * root.results-row-height);
                interactive: self.viewport-height > self.height;
                for comic[index] in CatalogModel.search-items: SearchResultRow {
                    x: 0px; y: index * root.results-row-height; width: root.width; comic: comic;
                    open => { CatalogModel.action("comic.open", comic.id); }
                    read => { CatalogModel.action("comic.read", comic.id); }
                    turn(delta) => { CatalogModel.action("search.page", delta); }
                }
            }
        }
        if CatalogModel.search-items.length == 0 && CatalogModel.search-state != "idle": CatalogNotice {
            x: 0px; y: 1px; width: parent.width; height: parent.height - 1px;
            title: CatalogModel.search-state == "loading" ? Strings.cat-searching :
                CatalogModel.status-message != "" ? CatalogModel.status-message : CatalogModel.empty-search-title;
            heading-size: Theme.scribe ? 26px : 20px;
            action-width: Theme.scribe ? 220px : 150px;
            waiting: CatalogModel.search-state == "loading";
            primary-label: Strings.cat-edit-keyword; secondary-label: Strings.cat-browse-more;
            primary => { CatalogModel.action("search.keyboard", "show"); }
            secondary => { CatalogModel.action("navigate", "store"); }
        }
    }
}
