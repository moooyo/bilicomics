import { Theme } from "theme.slint";
import { Strings } from "strings.slint";
import { ActionButton, ChoiceTile, Icon, NavigationButton, WaitingIndicator } from "widgets.slint";

export global AuthModel {
    callback action(string, string);
    in-out property <int> step: 1;
    in-out property <string> phase: "loading";
    in-out property <image> qr;
    in-out property <string> expires-label;
    in-out property <string> account-name;
    in-out property <bool> authenticated: false;
    in-out property <string> return-route: "account";
    in-out property <string> direction: "ltr";
    in-out property <string> mode: "page";
    in-out property <string> landscape: "spread";
    in-out property <string> status-message;
    in-out property <int> waiting-frame: 0;
    in-out property <bool> net-visible: false;
    in-out property <string> net-phase: "idle";
    in-out property <string> net-action;
    out property <string> return-label: return-route == "detail" ? Strings.handoff-back-detail :
        return-route == "reader" ? Strings.handoff-back-reader :
        return-route == "shelf" ? Strings.nav-shelf :
        return-route == "store" ? Strings.nav-store :
        return-route == "search" ? Strings.cat-search :
        return-route == "downloads" ? Strings.nav-downloads :
        return-route == "purchase" ? Strings.auth-source-purchase : Strings.nav-account;
}

component AuthText inherits Text {
    font-family: Theme.ui-font;
    font-size: Theme.scribe ? 20px : 16px;
    color: Theme.ink;
    vertical-alignment: center;
    overflow: elide;
}

component AuthActivity inherits WaitingIndicator {
    frame: AuthModel.waiting-frame;
    gap: Theme.scribe ? 14px : 10px;
}

component AuthBackButton inherits NavigationButton {
    height: Theme.scribe ? 56px : 48px;
    icon-size: Theme.scribe ? 26px : 22px;
    icon-spacing: 4px;
    horizontal-padding: 6px;
    text-size: Theme.scribe ? 20px : 16px;
    text-weight: 400;
}

export component QrCard inherits Rectangle {
    in property <bool> onboarding: false;
    in property <length> code-area-height: Theme.scribe ? 460px : 336px;
    property <length> bar-height: Theme.scribe ? 72px : 56px;
    property <length> code-size: max(0px, min(Theme.scribe ? 380px : 276px, min(code-area.height, code-area.width) - 24px));
    property <bool> waiting: AuthModel.phase == "waiting";
    property <bool> scanned: AuthModel.phase == "scanned";
    property <bool> success: AuthModel.phase == "success";
    property <bool> offline: AuthModel.phase == "offline";
    property <bool> expired: AuthModel.phase == "expired";
    property <bool> failed: AuthModel.phase == "error";
    property <bool> checking: AuthModel.phase == "connecting";
    property <bool> busy: AuthModel.phase == "loading" || root.checking;
    property <bool> retry-network: root.failed && AuthModel.net-phase == "failed";
    property <string> phase-title: root.scanned ? Strings.auth-qr-scanned :
        root.success ? Strings.auth-qr-success : root.expired ? Strings.auth-qr-expired :
        root.offline ? Strings.auth-need-network : root.retry-network ? Strings.auth-net-failed :
        root.failed ? Strings.auth-qr-error : root.checking ? Strings.auth-net-opening : Strings.auth-qr-loading;
    property <string> phase-note: root.scanned ? Strings.auth-qr-scanned-note : AuthModel.status-message;
    property <string> phase-icon: root.scanned ? "phone" : root.success ? "check" : root.offline ? "wifi-off" : "warning";
    height: root.code-area-height + root.bar-height + 8px;
    background: Theme.paper;
    border-width: 3px;
    border-color: Theme.ink;

    code-area := Rectangle {
        x: 3px; y: 3px;
        width: root.width - 6px; height: root.code-area-height;
        clip: true;
        if root.waiting: Image {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: root.code-size; height: self.width;
            source: AuthModel.qr;
            image-fit: contain;
            image-rendering: pixelated;
            accessible-label: Strings.auth-qr-image;
        }
        if !root.waiting: VerticalLayout {
            width: parent.width; height: parent.height;
            padding-left: 12px; padding-right: 12px;
            spacing: Theme.scribe ? 10px : 8px;
            alignment: center;
            if !root.busy: Rectangle {
                height: Theme.scribe ? 60px : 48px;
                Icon {
                    x: (parent.width - self.width) / 2; y: 0px;
                    width: parent.height; height: self.width;
                    kind: root.phase-icon;
                }
            }
            AuthText {
                height: Theme.scribe ? 39px : 31px;
                text: root.phase-title;
                font-size: Theme.scribe ? 28px : 22px;
                font-weight: 700;
                horizontal-alignment: center;
            }
            if root.scanned || (root.failed && root.phase-note != ""): AuthText {
                height: Theme.scribe ? 26px : 22px;
                text: root.phase-note;
                font-size: Theme.caption-size;
                color: Theme.secondary;
                horizontal-alignment: center;
            }
            if root.busy: Rectangle {
                height: Theme.scribe ? 18px : 14px;
                AuthActivity { x: (parent.width - self.width) / 2; y: 0px; }
            }
        }
    }
    Rectangle {
        x: 3px; y: code-area.y + code-area.height;
        width: root.width - 6px; height: root.bar-height + 2px;
        Rectangle { x: 0px; y: 0px; width: parent.width; height: 2px; background: Theme.ink; }
        if root.waiting || root.scanned: Rectangle {
            x: 0px; y: 2px; width: parent.width; height: root.bar-height;
            property <length> refresh-width: root.scanned ? (Theme.scribe ? 138px : 106px) : (Theme.scribe ? 98px : 74px);
            AuthText {
                x: Theme.scribe ? 20px : 16px; y: 0px;
                width: parent.width - parent.refresh-width - self.x - 8px; height: parent.height;
                text: root.scanned ? Strings.auth-qr-waiting-confirmation : AuthModel.expires-label;
                font-size: Theme.scribe ? 18px : 15px;
                color: Theme.secondary;
            }
            ActionButton {
                x: parent.width - self.width; y: 0px; width: parent.refresh-width; height: parent.height;
                quiet: true;
                text: root.scanned ? Strings.auth-reacquire : Strings.auth-refresh;
                text-size: Theme.scribe ? 20px : 16px;
                text-weight: 700;
                clicked => { AuthModel.action("refresh", ""); }
            }
            Rectangle {
                x: parent.width - parent.refresh-width; y: 0px;
                width: 2px; height: parent.height;
                background: Theme.ink;
            }
        }
        if root.success || root.expired || root.offline || root.failed: ActionButton {
            x: 0px; y: 2px; width: parent.width; height: root.bar-height;
            primary: true;
            text: root.success ? (root.onboarding ? Strings.auth-continue-preferences : Strings.auth-return-prefix + AuthModel.return-label) :
                root.offline ? Strings.auth-net-open-continue : root.retry-network ? Strings.auth-network-retry : Strings.auth-refresh-qr;
            text-size: Theme.scribe ? 20px : 16px;
            text-weight: 700;
            clicked => { AuthModel.action(root.success ? "login-return" : root.offline ? "connect" : "refresh", ""); }
        }
    }
}

component AuthQrPane inherits Rectangle {
    in property <bool> onboarding: false;
    property <length> margin: Theme.scribe ? 48px : 32px;
    property <length> instruction-top: root.onboarding ? (Theme.scribe ? 56px : 39px) + 6px : 0px;
    property <length> instruction-height: Theme.scribe ? 28px : 22px;
    property <length> card-top: root.instruction-top + root.instruction-height + (Theme.scribe ? 24px : 18px);
    property <length> card-bar-with-border: Theme.scribe ? 80px : 64px;

    Rectangle {
        x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
        width: min(Theme.scribe ? 560px : root.width, root.width - 2 * root.margin);
        height: root.card-top + card.height;
        if root.onboarding: AuthText {
            x: 0px; y: 0px; width: parent.width; height: root.instruction-top - 6px;
            text: Strings.auth-qr-title;
            font-size: Theme.scribe ? 40px : 28px;
            font-weight: 700;
        }
        AuthText {
            x: 0px; y: root.instruction-top; width: parent.width; height: root.instruction-height;
            text: Strings.auth-welcome-instruction;
            color: Theme.secondary;
        }
        card := QrCard {
            x: 0px; y: root.card-top; width: parent.width;
            onboarding: root.onboarding;
            code-area-height: min(Theme.scribe ? 460px : 336px, max(0px, root.height - root.card-top - root.card-bar-with-border));
        }
    }
}

component DirectionCard inherits ChoiceTile {
    in property <bool> rtl: false;
    property <string> title: root.rtl ? Strings.auth-direction-rtl : Strings.auth-direction-ltr;
    property <length> page-width: Theme.scribe ? 60px : 44px;
    property <length> page-gap: Theme.scribe ? 8px : 6px;
    accessible-label: root.title;

    VerticalLayout {
        x: 0px; y: 0px; width: root.width; height: root.height;
        alignment: center;
        spacing: Theme.scribe ? 12px : 8px;
        Rectangle {
            height: Theme.scribe ? 80px : 60px;
            HorizontalLayout {
                x: (parent.width - self.width) / 2; y: 0px;
                width: 2 * root.page-width + root.page-gap; height: parent.height;
                spacing: root.page-gap;
                for index in 2: Rectangle {
                    width: root.page-width;
                    border-width: 2px;
                    border-color: Theme.ink;
                    AuthText {
                        width: parent.width; height: parent.height;
                        text: (index == 0) != root.rtl ? "1" : "2";
                        font-size: Theme.scribe ? 26px : 20px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }
                }
            }
        }
        Rectangle {
            height: Theme.scribe ? 20px : 16px;
            Path {
                x: (parent.width - self.width) / 2; y: 0px;
                width: Theme.scribe ? 72px : 56px; height: parent.height;
                viewbox-width: 48; viewbox-height: 16;
                fill: transparent;
                stroke: Theme.ink;
                stroke-width: 2.4px;
                MoveTo { x: root.rtl ? 46 : 2; y: 8; }
                LineTo { x: root.rtl ? 4 : 44; y: 8; }
                MoveTo { x: root.rtl ? 12 : 36; y: 2; }
                LineTo { x: root.rtl ? 4 : 44; y: 8; }
                LineTo { x: root.rtl ? 12 : 36; y: 14; }
            }
        }
        AuthText {
            height: Theme.scribe ? 34px : 25px;
            text: root.title;
            font-size: Theme.scribe ? 24px : 18px;
            font-weight: 700;
            horizontal-alignment: center;
        }
        AuthText {
            height: Theme.scribe ? 24px : 20px;
            text: root.rtl ? Strings.auth-direction-rtl-note : Strings.auth-direction-ltr-note;
            font-size: Theme.scribe ? 17px : 14px;
            color: Theme.secondary;
            horizontal-alignment: center;
        }
    }
}

struct PreferenceOption { value: string, label: string }

component PreferenceChoice inherits Rectangle {
    in property <string> title;
    in property <[PreferenceOption]> options;
    in property <string> selected;
    in property <length> top-inset: 0px;
    callback picked(string);
    property <length> label-height: Theme.scribe ? 28px : 22px;
    property <length> segment-height: Theme.scribe ? 56px : 48px;
    height: root.top-inset + root.label-height + (Theme.scribe ? 10px : 8px) + root.segment-height;

    AuthText {
        x: 0px; y: root.top-inset; width: parent.width; height: root.label-height;
        text: root.title;
        font-weight: 700;
    }
    Rectangle {
        x: 0px; y: parent.height - self.height; width: parent.width; height: root.segment-height;
        border-width: 2px; border-color: Theme.ink;
        for option[index] in root.options: Rectangle {
            x: 2px + index * self.width; y: 2px;
            width: (parent.width - 4px) / max(1, root.options.length); height: parent.height - 4px;
            ActionButton {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                quiet: true;
                selected: root.selected == option.value;
                text: option.label;
                text-size: Theme.scribe ? 20px : 16px;
                text-weight: self.selected ? 700 : 400;
                accessible-checkable: true;
                accessible-checked: self.selected;
                clicked => { root.picked(option.value); }
            }
            if index > 0: Rectangle { x: 0px; y: 0px; width: 2px; height: parent.height; background: Theme.ink; }
        }
    }
}

export component WelcomeScreen inherits Rectangle {
    background: Theme.paper;
    property <length> margin: Theme.scribe ? 48px : 32px;
    property <length> header-height: Theme.scribe ? 128px : 96px;
    property <length> footer-margin: Theme.scribe ? 48px : 24px;
    property <length> footer-top: root.height - Theme.button-height - root.footer-margin;
    property <bool> preferences: AuthModel.step == 2;

    Rectangle {
        x: 0px; y: 0px; width: root.width; height: root.header-height;
        AuthText {
            x: root.margin; y: parent.height - self.height - (Theme.scribe ? 24px : 18px);
            width: parent.width - 2 * self.x - 58px; height: Theme.scribe ? 44px : 32px;
            text: Strings.auth-app-name;
            font-family: Theme.serif-font;
            font-size: Theme.scribe ? 44px : 32px;
            font-weight: 700;
        }
        AuthText {
            x: parent.width - root.margin - self.width; y: parent.height - self.height - (Theme.scribe ? 24px : 18px);
            width: 58px; height: Theme.scribe ? 25px : 21px;
            text: root.preferences ? Strings.auth-step-preferences : Strings.auth-step-login;
            font-size: Theme.scribe ? 18px : 15px;
            color: Theme.secondary;
            horizontal-alignment: right;
        }
        Rectangle { x: 0px; y: parent.height - 2px; width: parent.width; height: 2px; background: Theme.ink; }
    }

    if !root.preferences: AuthQrPane {
        x: 0px; y: root.header-height; width: root.width; height: max(0px, root.footer-top - self.y);
        onboarding: true;
    }
    if root.preferences: Flickable {
        x: root.margin; y: root.header-height; width: root.width - 2 * root.margin;
        height: max(0px, root.footer-top - self.y - (Theme.scribe ? 24px : 18px));
        viewport-width: self.width;
        viewport-height: max(self.height, settings.preferred-height);
        interactive: settings.preferred-height > self.height;
        settings := VerticalLayout {
            x: 0px; y: 0px; width: parent.width; height: self.preferred-height;
            padding-top: Theme.scribe ? 40px : 24px;
            spacing: Theme.scribe ? 24px : 18px;
            alignment: start;

            VerticalLayout {
                spacing: 6px;
                if AuthModel.authenticated: AuthText {
                    height: Theme.scribe ? 28px : 22px;
                    text: AuthModel.account-name == "" ? Strings.auth-logged-in : Strings.auth-logged-in-name + AuthModel.account-name;
                    color: Theme.secondary;
                }
                if !AuthModel.authenticated: Rectangle {
                    height: Theme.scribe ? 56px : 48px;
                    AuthBackButton {
                        x: 0px; y: 0px;
                        horizontal-padding: 0px;
                        text: Strings.auth-back-login;
                        clicked => { AuthModel.action("back", ""); }
                    }
                }
                AuthText {
                    height: Theme.scribe ? 56px : 39px;
                    text: Strings.auth-direction-title;
                    font-size: Theme.scribe ? 40px : 28px;
                    font-weight: 700;
                }
            }
            HorizontalLayout {
                height: Theme.scribe ? 380px : 260px;
                spacing: Theme.scribe ? 24px : 12px;
                DirectionCard { selected: AuthModel.direction == "ltr"; clicked => { AuthModel.action("direction", "ltr"); } }
                DirectionCard { rtl: true; selected: AuthModel.direction == "rtl"; clicked => { AuthModel.action("direction", "rtl"); } }
            }
            PreferenceChoice {
                top-inset: Theme.scribe ? 10px : 8px;
                title: Strings.auth-default-mode;
                options: [{ value: "page", label: Strings.auth-mode-page }, { value: "panel", label: Strings.auth-mode-panel }, { value: "strip", label: Strings.auth-mode-strip }];
                selected: AuthModel.mode;
                picked(value) => { AuthModel.action("mode", value); }
            }
            if Theme.scribe: PreferenceChoice {
                title: Strings.auth-landscape;
                options: [{ value: "spread", label: Strings.auth-landscape-spread }, { value: "single", label: Strings.auth-landscape-single }];
                selected: AuthModel.landscape;
                picked(value) => { AuthModel.action("landscape", value); }
            }
        }
    }
    if root.preferences || AuthModel.phase != "success": ActionButton {
        x: (root.width - self.width) / 2; y: root.footer-top;
        width: min(Theme.scribe && !root.preferences ? 560px : root.width, root.width - 2 * root.margin);
        height: Theme.button-height;
        text: root.preferences ? Strings.auth-enter-shelf : Strings.auth-skip-login;
        text-size: Theme.body-size;
        text-weight: root.preferences ? 700 : 400;
        primary: root.preferences;
        clicked => { AuthModel.action(root.preferences ? "finish" : "skip", ""); }
    }
}

export component LoginScreen inherits Rectangle {
    background: Theme.paper;
    Rectangle {
        x: 0px; y: 0px; width: root.width; height: Theme.header-height;
        back := AuthBackButton {
            x: Theme.scribe ? 32px : 8px; y: (parent.height - self.height) / 2;
            text: AuthModel.return-label;
            clicked => { AuthModel.action("back", ""); }
        }
        AuthText {
            x: back.x + back.width + 8px; y: 0px;
            width: parent.width - self.x - 24px; height: parent.height;
            text: Strings.auth-qr-title;
            font-size: Theme.scribe ? 22px : 17px;
            font-weight: 700;
        }
        Rectangle { x: 0px; y: parent.height - 2px; width: parent.width; height: 2px; background: Theme.ink; }
    }
    AuthQrPane {
        x: 0px; y: Theme.header-height; width: root.width;
        height: max(0px, root.height - self.y - (Theme.scribe ? 80px : 40px));
    }
}

export component NetSheet inherits Rectangle {
    visible: AuthModel.net-visible;
    property <bool> busy: AuthModel.net-phase == "connecting";
    property <bool> failed: AuthModel.net-phase == "failed";
    property <bool> preview: AuthModel.net-phase == "preview";
    property <bool> can-continue: AuthModel.net-phase == "connected" || root.preview;
    property <bool> stacked: !Theme.scribe || dialog.width < 520px;
    property <length> isolation: Theme.scribe ? 24px : 16px;
    property <length> inset: (Theme.scribe ? 36px : 24px) + 3px;
    property <length> gap: Theme.scribe ? 18px : 14px;
    property <length> button-gap: Theme.scribe ? 12px : 10px;
    property <length> title-height: Theme.scribe ? 39px : 31px;
    property <length> actions-top: root.inset + root.title-height + root.gap + (root.busy ? 0px : Theme.scribe ? 6px : 4px);
    property <length> indicator-height: Theme.scribe ? 18px : 14px;
    property <length> buttons-height: root.busy ? root.indicator-height + root.gap + Theme.button-height :
        root.stacked ? Theme.button-height * 2 + root.button-gap : Theme.button-height;
    property <string> title: root.preview ? Strings.auth-network-preview-title : root.busy ? Strings.auth-net-opening :
        root.can-continue ? Strings.auth-net-connected : root.failed ? Strings.auth-net-failed : Strings.auth-need-network;
    property <string> primary-label: root.can-continue ? (AuthModel.net-action == "" ? Strings.network-continue : Strings.auth-net-continue + AuthModel.net-action) :
        root.failed ? Strings.auth-network-retry : Strings.auth-net-open-continue;

    // Consume outside clicks without dismissing the active network decision.
    TouchArea { x: 0px; y: 0px; width: root.width; height: root.height; }
    Rectangle {
        x: dialog.x - root.isolation; y: dialog.y - root.isolation;
        width: dialog.width + 2 * root.isolation; height: dialog.height + 2 * root.isolation;
        background: Theme.paper;
    }
    dialog := Rectangle {
        x: (root.width - self.width) / 2;
        y: max(root.isolation, min(Theme.scribe ? 360px : 220px, root.height - self.height - root.isolation));
        width: min(Theme.scribe ? 660px : root.width, root.width - 80px);
        height: root.actions-top + root.buttons-height + root.inset;
        background: Theme.paper;
        border-width: 3px;
        border-color: Theme.ink;

        AuthText {
            x: root.inset; y: root.inset; width: parent.width - 2 * self.x; height: root.title-height;
            text: root.title;
            font-size: Theme.scribe ? 28px : 22px;
            font-weight: 700;
        }
        if root.busy: AuthActivity { x: root.inset; y: root.actions-top; }
        if !root.busy: Rectangle {
            x: root.inset; y: root.actions-top;
            width: parent.width - 2 * self.x; height: root.buttons-height;
            property <length> row-width: self.width - (root.can-continue ? 1 : 2) * root.button-gap;
            property <length> primary-width: root.stacked ? self.width : self.row-width * (root.can-continue ? 1.6 / 2.3 : 1.6 / 3.3);
            property <length> offline-width: root.stacked ? (self.width - root.button-gap) / 2 : self.row-width / 3.3;
            property <length> secondary-top: root.stacked ? Theme.button-height + root.button-gap : 0px;
            ActionButton {
                x: 0px; y: 0px; width: parent.primary-width;
                text: root.primary-label;
                primary: true;
                text-size: Theme.body-size;
                text-weight: 700;
                clicked => { AuthModel.action(root.can-continue ? "net-continue" : "net-connect", ""); }
            }
            if !root.can-continue: ActionButton {
                x: root.stacked ? 0px : parent.primary-width + root.button-gap;
                y: parent.secondary-top;
                width: parent.offline-width;
                text: Strings.auth-net-downloads-only;
                text-weight: 400;
                clicked => { AuthModel.action("net-downloads", ""); }
            }
            ActionButton {
                x: root.stacked ? (root.can-continue ? 0px : parent.offline-width + root.button-gap) :
                    parent.primary-width + root.button-gap + (root.can-continue ? 0px : parent.offline-width + root.button-gap);
                y: parent.secondary-top;
                width: parent.width - self.x;
                text: Strings.auth-cancel;
                text-weight: 400;
                clicked => { AuthModel.action("net-close", ""); }
            }
        }
        if root.busy: ActionButton {
            x: root.inset; y: root.actions-top + root.indicator-height + root.gap;
            width: parent.width - 2 * self.x;
            text: Strings.auth-cancel-check;
            text-weight: 400;
            clicked => { AuthModel.action("net-close", ""); }
        }
    }
}
