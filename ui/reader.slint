import { Theme } from "theme.slint";
import { Strings } from "strings.slint";
import { ActionButton, IconButton, Icon, NavigationButton, StatusBar, DashedOutline } from "widgets.slint";

export struct ReaderThumbnail {
    page: int,
    picture: image,
    label: string,
    cached: bool,
    current: bool,
}

export struct ReaderChapter {
    id: string,
    order: string,
    title: string,
    tag: string,
    progress: string,
    access: string,
    storage: string,
    current: bool,
    read: bool,
    downloaded: bool,
    readable: bool,
    temporary: bool,
}

export global ReaderModel {
    callback action(string, string);
    in-out property <image> page;
    in-out property <image> second-page;
    in-out property <image> overview-image;
    in-out property <int> page-index: 1;
    in-out property <int> page-count: 1;
    in-out property <int> seek-index: 1;
    in-out property <int> seek-count: 1;
    in-out property <int> left-page-index;
    in-out property <int> right-page-index;
    in-out property <bool> spread-active;
    in-out property <string> spread-label;
    in-out property <string> comic-title;
    in-out property <string> episode-title;
    in-out property <string> transition-episode-title;
    in-out property <string> progress-label;
    in-out property <string> cache-label;
    in-out property <string> clock: "--:--";
    in-out property <string> battery-label: "--%";
    in-out property <string> network-label;
    in-out property <string> mode: "page";
    in-out property <string> fit: "page";
    in-out property <string> direction: "ltr";
    in-out property <string> refresh-policy: "smart";
    in-out property <string> landscape-layout: "spread";
    in-out property <bool> landscape;
    in-out property <bool> menu;
    in-out property <bool> guidance;
    in-out property <bool> transition;
    in-out property <bool> loading;
    in-out property <bool> retain-page;
    in-out property <bool> preparing-feedback;
    in-out property <bool> failed;
    in-out property <bool> offline;
    in-out property <bool> connected;
    in-out property <string> landscape-subtitle;
    in-out property <string> continue-label;
    // Kept for preference and integration compatibility; quiet reading has no footer.
    in-out property <bool> show-footer: true;
    in-out property <bool> dither: true;
    in-out property <string> dither-method: "software";
    in-out property <bool> cover-alone: true;
    in-out property <bool> next-locked: true;
    in-out property <bool> next-available: true;
    in-out property <bool> zoom-available;
    in-out property <string> sheet;
    in-out property <string> error-message;
    in-out property <string> retry-label;
    in-out property <string> dither-note;
    in-out property <string> next-title;
    in-out property <string> next-note;
    in-out property <string> next-price;
    in-out property <string> wallet-label;
    in-out property <string> coupon-label;
    in-out property <int> brightness;
    in-out property <int> warmth;
    in-out property <bool> brightness-available;
    in-out property <bool> warmth-available;
    in-out property <bool> light-busy;
    in-out property <int> panel-index: 1;
    in-out property <int> panel-count: 1;
    in-out property <int> strip-screen: 1;
    in-out property <int> strip-count: 1;
    in-out property <bool> overlap;
    in-out property <float> viewport-ratio: 0.72;
    in-out property <float> focus-x;
    in-out property <float> focus-y;
    in-out property <float> focus-width: 1;
    in-out property <float> focus-height: 1;
    in-out property <[ReaderThumbnail]> thumbnails;
    in-out property <bool> thumbnails-loading;
    in-out property <int> grid-page: 1;
    in-out property <int> grid-pages: 1;
    in-out property <[ReaderChapter]> chapters;
    in-out property <int> chapter-count;
    in-out property <int> chapter-page: 1;
    in-out property <int> chapter-pages: 1;
    in-out property <string> chapter-filter: "all";
    in-out property <bool> chapter-descending;
    in-out property <int> chapter-capacity: 14;
}

struct ReaderOption {
    value: string,
    label: string,
}

struct ReaderToolData {
    id: string,
    label: string,
    icon: string,
}

component ReaderText inherits Text {
    color: Theme.ink;
    font-family: Theme.ui-font;
    font-size: Theme.scribe ? 18px : 15px;
    vertical-alignment: center;
}

component ReaderDashedBox inherits Rectangle {
    in property <color> stroke-color: Theme.muted;
    in property <length> stroke: 1.5px;
    property <int> horizontal-count: ceil(root.width / 10px);
    property <int> vertical-count: ceil(root.height / 10px);
    background: transparent;
    for index in root.horizontal-count: Rectangle {
        x: index * 10px;
        y: 0px;
        width: min(6px, root.width - self.x);
        height: root.stroke;
        background: root.stroke-color;
    }
    for index in root.horizontal-count: Rectangle {
        x: index * 10px;
        y: parent.height - root.stroke;
        width: min(6px, root.width - self.x);
        height: root.stroke;
        background: root.stroke-color;
    }
    for index in root.vertical-count: Rectangle {
        x: 0px;
        y: index * 10px;
        width: root.stroke;
        height: min(6px, root.height - self.y);
        background: root.stroke-color;
    }
    for index in root.vertical-count: Rectangle {
        x: parent.width - root.stroke;
        y: index * 10px;
        width: root.stroke;
        height: min(6px, root.height - self.y);
        background: root.stroke-color;
    }
}

component ReaderChoice inherits Rectangle {
    in property <[ReaderOption]> options;
    in property <string> value;
    callback picked(string);
    background: Theme.paper;
    border-color: Theme.ink;
    border-width: 2px;
    height: Theme.scribe ? 60px : 52px;
    for option[index] in root.options: Rectangle {
        x: 2px + index * (root.width - 4px) / max(1, root.options.length);
        y: 2px;
        width: (root.width - 4px) / max(1, root.options.length);
        height: root.height - 4px;
        background: option.value == root.value || touch.pressed ? Theme.ink : Theme.paper;
        accessible-role: button;
        accessible-label: option.label;
        accessible-action-default => { root.picked(option.value); }
        ReaderText {
            x: 4px;
            width: parent.width - 8px;
            text: option.label;
            color: option.value == root.value || touch.pressed ? Theme.paper : Theme.ink;
            font-weight: option.value == root.value ? 700 : 400;
            horizontal-alignment: center;
            overflow: elide;
        }
        if index > 0: Rectangle { x: 0px; y: 0px; width: 2px; height: parent.height; background: Theme.ink; }
        touch := TouchArea {
            pointer-event(event) => {
                if event.kind == PointerEventKind.down { Theme.refresh("press"); }
                if event.kind == PointerEventKind.up { Theme.refresh("release"); }
            }
            clicked => { root.picked(option.value); }
        }
    }
}

component ReaderChoiceRow inherits Rectangle {
    in property <string> label;
    in property <[ReaderOption]> options;
    in property <string> value;
    callback picked(string);
    height: Theme.scribe ? 60px : 52px;
    background: Theme.paper;
    property <length> label-width: Theme.scribe ? 96px : 76px;
    ReaderText { x: 0px; y: 0px; width: root.label-width; height: parent.height; text: root.label; color: Theme.secondary; }
    ReaderChoice {
        x: root.label-width + 12px;
        width: parent.width - self.x;
        options: root.options;
        value: root.value;
        picked(value) => { root.picked(value); }
    }
}

component ReaderSheetHeader inherits Rectangle {
    in property <string> title;
    in property <bool> outlined: true;
    callback close();
    height: Theme.scribe ? 64px : 56px;
    background: Theme.paper;
    ReaderText {
        x: 0px;
        y: 0px;
        width: parent.width - close-button.width - 12px;
        height: parent.height;
        text: root.title;
        font-size: Theme.scribe ? 24px : 20px;
        font-weight: 700;
        overflow: elide;
    }
    close-button := ActionButton {
        x: parent.width - self.width;
        y: (parent.height - self.height) / 2;
        width: Theme.scribe ? 68px : 62px;
        height: Theme.scribe ? 56px : 48px;
        text: root.outlined ? Strings.read-done : Strings.read-close;
        text-size: Theme.scribe ? 18px : 15px;
        quiet: !root.outlined;
        clicked => { root.close(); }
    }
    Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.line; }
}

component ReaderTool inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    callback clicked();
    height: Theme.scribe ? 68px : 60px;
    background: touch.pressed ? Theme.ink : Theme.paper;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    Icon { x: (parent.width - self.width) / 2; y: 4px; width: Theme.scribe ? 30px : 26px; height: self.width; kind: root.icon; inverted: touch.pressed; }
    ReaderText {
        y: Theme.scribe ? 38px : 34px;
        height: 22px;
        text: root.label;
        color: touch.pressed ? Theme.paper : Theme.ink;
        font-size: Theme.scribe ? 16px : 14px;
        horizontal-alignment: center;
    }
    touch := TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down { Theme.refresh("press"); }
            if event.kind == PointerEventKind.up { Theme.refresh("release"); }
        }
        clicked => { root.clicked(); }
    }
}

component ReaderSeek inherits Rectangle {
    in property <int> value: 1;
    in property <int> count: 1;
    in property <string> label;
    callback picked(int);
    property <float> ratio: max(0, min(1, (min(root.count, root.value) - 1) / max(1, root.count - 1)));
    min-width: 48px;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-enabled: root.count > 0;
    accessible-orientation: Orientation.horizontal;
    accessible-value: root.value;
    accessible-value-minimum: 1;
    accessible-value-maximum: max(1, root.count);
    accessible-value-step: 1;
    accessible-action-set-value(value) => { if value.is-float() { root.picked(max(1, min(root.count, round(value.to-float())))); } }
    accessible-action-increment => { if root.count > 0 { root.picked(min(root.count, root.value + 1)); } }
    accessible-action-decrement => { if root.count > 0 { root.picked(max(1, root.value - 1)); } }
    forward-focus: keyboard;
    Rectangle { x: 0px; y: (parent.height - 8px) / 2; height: 8px; width: parent.width; background: Theme.paper; border-width: 1.5px; border-color: Theme.ink; }
    Rectangle { x: 0px; y: (parent.height - 8px) / 2; height: 8px; width: parent.width * root.ratio; background: Theme.ink; }
    Rectangle { x: max(0px, min(parent.width - 22px, parent.width * root.ratio - 11px)); y: (parent.height - 24px) / 2; width: 22px; height: 24px; background: Theme.paper; border-width: 2.5px; border-color: Theme.ink; }
    if keyboard.has-focus: Rectangle { x: 4px; y: 6px; width: parent.width - 8px; height: parent.height - 12px; border-width: 2px; border-color: Theme.ink; background: transparent; }
    TouchArea {
        enabled: root.count > 0;
        height: parent.height;
        clicked => { root.picked(max(1, round(min(1, max(0, self.mouse-x / self.width)) * max(0, root.count - 1)) + 1)); }
    }
    keyboard := FocusScope {
        x: 0px; y: 0px; width: 0px; height: 0px; enabled: root.count > 0;
        key-pressed(event) => {
            if event.text == Key.RightArrow { root.picked(min(root.count, root.value + 1)); return accept; }
            if event.text == Key.LeftArrow { root.picked(max(1, root.value - 1)); return accept; }
            if event.text == Key.Home { root.picked(1); return accept; }
            if event.text == Key.End { root.picked(root.count); return accept; }
            return reject;
        }
    }
}

component ReaderTapZone inherits Rectangle {
    in property <string> intent;
    in property <string> label;
    background: transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => {
        if root.intent == "menu" {
            ReaderModel.menu = true;
            ReaderModel.sheet = "";
            ReaderModel.action("menu", "open");
        } else {
            ReaderModel.action("turn", root.intent);
        }
    }
    property <length> start-x;
    property <length> start-y;
    property <bool> gesture-moved;
    touch := TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.start-x = self.mouse-x;
                root.start-y = self.mouse-y;
                root.gesture-moved = false;
            }
            if event.kind == PointerEventKind.up {
                if abs(self.mouse-x - root.start-x) >= 64px && abs(self.mouse-x - root.start-x) > abs(self.mouse-y - root.start-y) {
                    root.gesture-moved = true;
                    ReaderModel.action("turn", (self.mouse-x < root.start-x) != (ReaderModel.direction == "rtl") ? "next" : "previous");
                } else if abs(self.mouse-y - root.start-y) >= 64px {
                    root.gesture-moved = true;
                    if ReaderModel.mode == "strip" {
                        ReaderModel.action("turn", self.mouse-y < root.start-y ? "next" : "previous");
                    }
                }
            }
        }
        clicked => {
            if !root.gesture-moved && abs(self.mouse-x - root.start-x) < 64px && abs(self.mouse-y - root.start-y) < 64px {
                if root.intent == "menu" {
                    ReaderModel.menu = true;
                    ReaderModel.sheet = "";
                    ReaderModel.action("menu", "open");
                } else {
                    ReaderModel.action("turn", root.intent);
                }
            }
        }
    }
}

component ReaderLightRow inherits Rectangle {
    in property <string> label;
    in property <int> value;
    in property <bool> available;
    in property <bool> busy;
    callback changed(string);
    height: 52px;
    background: Theme.paper;
    HorizontalLayout {
        spacing: 12px;
        ReaderText { width: 64px; text: root.label; color: Theme.secondary; }
        ActionButton { text: "−"; width: 52px; height: parent.height; enabled: root.available && !root.busy && root.value > 0; clicked => { root.changed("-1"); } }
        Rectangle {
            horizontal-stretch: 1;
            Rectangle {
                y: (parent.height - 12px) / 2;
                height: 12px;
                width: parent.width;
                border-width: 1.5px;
                border-color: root.available ? Theme.ink : Theme.line;
                background: Theme.paper;
                Rectangle { x: 1.5px; y: 1.5px; height: parent.height - 3px; width: max(0px, (parent.width - 3px) * min(24, max(0, root.value)) / 24); background: Theme.ink; }
            }
        }
        ActionButton { text: "+"; width: 52px; height: parent.height; enabled: root.available && !root.busy && root.value < 24; clicked => { root.changed("+1"); } }
        ReaderText { width: 44px; horizontal-alignment: right; text: root.available ? "" + root.value : Strings.read-unknown; }
    }
}

component ReaderSpreadPage inherits Rectangle {
    in property <image> picture;
    in property <int> number;
    background: Theme.paper;
    if root.number >= 1 && root.number <= ReaderModel.page-count: Image {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        source: root.picture;
        image-fit: contain;
    }
}

export component ReaderScreen inherits Rectangle {
    background: Theme.paper;
    clip: true;
    property <bool> wide-landscape: ReaderModel.landscape && root.width >= 1100px;
    property <bool> spread: ReaderModel.spread-active;
    property <bool> show-content: !ReaderModel.transition && !ReaderModel.failed && (!ReaderModel.loading || ReaderModel.retain-page);
    property <length> reader-bar: Theme.scribe ? 64px : 56px;
    property <length> reader-status: Theme.scribe ? 32px : 28px;
    property <length> reader-button: Theme.scribe ? 56px : 48px;
    property <length> reader-edge: Theme.scribe ? 48px : 24px;
    property <length> toolbar-left: root.reader-edge;
    property <length> toolbar-right: root.reader-edge;
    property <int> guide-dash-count: ceil(root.height / 14px);
    property <string> progress: root.spread && ReaderModel.spread-label != "" ? ReaderModel.spread-label : ReaderModel.progress-label != "" ? ReaderModel.progress-label : ReaderModel.mode == "strip" ? Strings.read-page-prefix + ReaderModel.strip-screen + " / " + ReaderModel.strip-count + Strings.read-screen-suffix : ReaderModel.mode == "panel" ? min(ReaderModel.page-index, ReaderModel.page-count) + " / " + ReaderModel.page-count + " · " + Strings.read-panel-prefix + ReaderModel.panel-index : min(ReaderModel.page-index, ReaderModel.page-count) + " / " + ReaderModel.page-count;
    property <bool> directory-stacked-controls: root.width < (Theme.scribe ? 680px : 540px);
    property <bool> directory-wide-columns: Theme.scribe && root.width >= 760px;
    property <length> directory-header: Theme.scribe ? 72px : 64px;
    property <length> directory-filter-gap: Theme.scribe ? 16px : 12px;
    property <length> directory-filter-row: Theme.scribe ? 52px : 48px;
    property <length> directory-filter-height: root.directory-stacked-controls ? 2 * root.directory-filter-row + 8px : root.directory-filter-row;
    property <length> directory-columns: root.directory-wide-columns ? 36px : 0px;
    property <length> directory-row: Theme.scribe ? 68px : 60px;
    property <length> directory-footer: Theme.scribe ? 64px : 72px;
    property <length> directory-body-top: root.reader-status + root.directory-header + root.directory-filter-gap + root.directory-filter-height + 16px + root.directory-columns;
    property <int> directory-capacity: max(1, floor((root.height - root.directory-body-top - root.directory-footer) / root.directory-row));

    // Menu and sheet overlays never change the reading canvas or its image geometry.
    if root.show-content && !root.spread && ReaderModel.mode == "page": Image {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        source: ReaderModel.page;
        image-fit: contain;
    }

    if root.show-content && !root.spread && ReaderModel.mode == "panel": Image {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        source: ReaderModel.page;
        image-fit: contain;
    }

    if root.show-content && !root.spread && ReaderModel.mode == "strip": Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        clip: true;
        Image { width: parent.width; height: parent.height; source: ReaderModel.page; image-fit: contain; }
    }

    if root.show-content && root.spread: Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: Theme.paper;
        property <length> frame-width: root.width / 2;
        ReaderSpreadPage { x: 0px; y: 0px; width: parent.frame-width; height: root.height; picture: ReaderModel.page; number: ReaderModel.left-page-index; }
        ReaderSpreadPage { x: parent.frame-width; y: 0px; width: parent.frame-width; height: root.height; picture: ReaderModel.second-page; number: ReaderModel.right-page-index; }
    }

    if (ReaderModel.loading && !ReaderModel.retain-page) || ReaderModel.failed: Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: Theme.paper;
        VerticalLayout {
            padding-left: 20px;
            padding-right: 20px;
            spacing: 12px;
            Rectangle { vertical-stretch: 1; }
            ReaderText { text: ReaderModel.failed ? Strings.read-failed : Strings.read-loading; font-size: Theme.scribe ? 24px : 20px; font-weight: 700; horizontal-alignment: center; height: 34px; }
            ReaderText { text: ReaderModel.failed ? ReaderModel.error-message : Strings.read-page-prefix + ReaderModel.page-index + " / " + ReaderModel.page-count + Strings.read-loading-suffix; color: Theme.secondary; horizontal-alignment: center; wrap: word-wrap; height: Theme.scribe ? 60px : 52px; }
            if ReaderModel.loading: ReaderText { text: Strings.read-caching-background; font-size: Theme.scribe ? 16px : 14px; color: Theme.secondary; horizontal-alignment: center; height: 28px; }
            if ReaderModel.failed: HorizontalLayout {
                height: root.reader-button;
                spacing: 12px;
                Rectangle { horizontal-stretch: 1; }
                ActionButton { text: Strings.read-back; clicked => { ReaderModel.action("back", ""); } }
                ActionButton { text: ReaderModel.retry-label != "" ? ReaderModel.retry-label : Strings.read-retry; primary: true; clicked => { ReaderModel.action("retry", ""); } }
                Rectangle { horizontal-stretch: 1; }
            }
            Rectangle { vertical-stretch: 1; }
        }
    }

    if ReaderModel.preparing-feedback && root.show-content && !ReaderModel.menu: Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: Theme.scribe ? 300px : 252px;
        height: Theme.scribe ? 64px : 56px;
        background: Theme.paper;
        border-width: 1px;
        border-color: Theme.ink;
        ReaderText { text: Strings.read-loading; horizontal-alignment: center; font-size: Theme.scribe ? 22px : 18px; }
    }

    if !ReaderModel.menu && !ReaderModel.guidance && !ReaderModel.failed: Rectangle {
        background: transparent;
        ReaderTapZone { x: 0px; y: 0px; width: parent.width * 0.3; height: parent.height; intent: ReaderModel.direction == "rtl" ? "next" : "previous"; label: ReaderModel.direction == "rtl" ? (root.spread ? Strings.read-next-pair : Strings.read-next-page) : (root.spread ? Strings.read-previous-pair : Strings.read-previous-page); }
        ReaderTapZone { x: parent.width * 0.3; y: 0px; width: parent.width * 0.4; height: parent.height; intent: "menu"; label: Strings.read-open-menu; }
        ReaderTapZone { x: parent.width * 0.7; y: 0px; width: parent.width * 0.3; height: parent.height; intent: ReaderModel.direction == "rtl" ? "previous" : "next"; label: ReaderModel.direction == "rtl" ? (root.spread ? Strings.read-previous-pair : Strings.read-previous-page) : (root.spread ? Strings.read-next-pair : Strings.read-next-page); }
    }

    if ReaderModel.transition && !ReaderModel.menu: transition-page := Rectangle {
        background: Theme.paper;
        property <bool> compact: root.height < (Theme.scribe ? 1100px : 760px);
        property <bool> very-compact: root.height < (Theme.scribe ? 850px : 680px);
        property <length> inset: Theme.scribe ? 56px : 28px;
        property <length> gap: self.very-compact ? 12px : Theme.scribe ? 24px : 16px;
        property <length> pad-top: Theme.scribe ? 40px : 24px;
        property <length> pad-bottom: Theme.scribe ? 48px : 28px;
        property <length> title-margin: self.very-compact ? 8px : self.compact ? (Theme.scribe ? 64px : 12px) : Theme.scribe ? 120px : 48px;
        property <length> end-size: self.very-compact ? (Theme.scribe ? 80px : 60px) : Theme.scribe ? 120px : 88px;
        VerticalLayout {
            x: transition-page.inset; y: transition-page.pad-top;
            width: parent.width - 2 * transition-page.inset;
            height: parent.height - transition-page.pad-top - transition-page.pad-bottom;
            spacing: transition-page.gap;
            Rectangle {
                height: summary-left.preferred-height; vertical-stretch: 0;
                summary-left := ReaderText { x: 0px; y: 0px; width: parent.width * 0.6; height: parent.height; text: ReaderModel.comic-title; font-size: Theme.scribe ? 16px : 14px; color: Theme.secondary; overflow: elide; }
                ReaderText { x: parent.width * 0.6; y: 0px; width: parent.width * 0.4; height: parent.height; text: Strings.read-chapter-end + " · " + ReaderModel.page-count + " / " + ReaderModel.page-count + " " + Strings.read-after; horizontal-alignment: right; font-size: Theme.scribe ? 16px : 14px; color: Theme.secondary; }
            }
            Rectangle {
                height: transition-page.title-margin + ended-episode.preferred-height + 6px + transition-page.end-size * 1.1;
                vertical-stretch: 0;
                ended-episode := ReaderText { x: 0px; y: transition-page.title-margin; width: parent.width; height: self.preferred-height; text: ReaderModel.transition-episode-title; color: Theme.secondary; }
                Text { x: 0px; y: ended-episode.y + ended-episode.height + 6px; width: parent.width; height: transition-page.end-size * 1.1; text: Strings.read-end; color: Theme.ink; font-family: Theme.serif-font; font-size: transition-page.end-size; font-weight: 700; vertical-alignment: center; }
            }
            Rectangle {
                height: next-note.y + next-note.preferred-height;
                vertical-stretch: 0;
                Rectangle { x: 0px; y: 0px; height: 2px; width: parent.width; background: Theme.ink; }
                next-caption := ReaderText { x: 0px; y: transition-page.gap + 2px; width: parent.width; height: self.preferred-height; text: Strings.read-next-episode; font-size: Theme.scribe ? 16px : 14px; color: Theme.secondary; }
                next-heading := ReaderText { x: 0px; y: next-caption.y + next-caption.height + 6px; width: parent.width; height: self.preferred-height; text: ReaderModel.next-title; font-size: Theme.scribe ? 30px : 22px; font-weight: 700; overflow: elide; }
                next-note := ReaderText { x: 0px; y: next-heading.y + next-heading.height + 6px; width: parent.width; height: self.preferred-height; text: ReaderModel.next-note; color: Theme.secondary; }
            }
            if ReaderModel.next-locked: Rectangle {
                height: price-amount.y + price-amount.preferred-height + 18px;
                vertical-stretch: 0;
                background: Theme.paper; border-width: 2px; border-color: Theme.ink;
                price-caption := ReaderText { x: 20px; y: 18px; width: parent.width * 0.5 - 40px; height: self.preferred-height; text: Strings.read-episode-price; font-size: Theme.scribe ? 16px : 14px; color: Theme.secondary; }
                price-amount := ReaderText { x: 20px; y: price-caption.y + price-caption.height + 2px; width: parent.width * 0.5 - 40px; height: self.preferred-height; text: ReaderModel.next-price; font-size: Theme.scribe ? 30px : 22px; font-weight: 700; }
                Rectangle {
                    x: parent.width * 0.5; y: (parent.height - self.height) / 2; width: parent.width * 0.5 - 20px;
                    height: wallet-note.preferred-height + coupon-note.preferred-height + 2px;
                    wallet-note := ReaderText { x: 0px; y: 0px; width: parent.width; height: self.preferred-height; text: Strings.read-wallet + " " + ReaderModel.wallet-label; horizontal-alignment: right; font-size: Theme.scribe ? 16px : 14px; color: Theme.secondary; }
                    coupon-note := ReaderText { x: 0px; y: wallet-note.height + 2px; width: parent.width; height: self.preferred-height; text: Strings.read-coupon + " " + ReaderModel.coupon-label; horizontal-alignment: right; font-size: Theme.scribe ? 16px : 14px; color: Theme.secondary; }
                }
            }
            if ReaderModel.next-locked: ActionButton {
                height: Theme.scribe ? 68px : 56px; vertical-stretch: 0;
                text: Strings.read-confirm-purchase; text-size: Theme.scribe ? 20px : 17px;
                primary: true; enabled: ReaderModel.next-available;
                clicked => { ReaderModel.action("purchase", ""); }
            }
            if !ReaderModel.next-locked: NavigationButton {
                width: parent.width; height: Theme.scribe ? 68px : 56px; vertical-stretch: 0;
                text: ReaderModel.continue-label; text-size: Theme.scribe ? 20px : 17px;
                icon: "next"; icon-size: Theme.scribe ? 20px : 17px; trailing: true;
                icon-spacing: (Theme.scribe ? 20px : 17px) * 0.15;
                primary: true; enabled: ReaderModel.next-available;
                clicked => { ReaderModel.action("next", ""); }
            }
            ReaderText {
                height: self.preferred-height; vertical-stretch: 0;
                text: !ReaderModel.next-available ? ReaderModel.next-note : ReaderModel.next-locked ? Strings.read-purchase-note : Strings.read-continue-gesture;
                font-size: Theme.scribe ? 16px : 14px; color: Theme.secondary; wrap: word-wrap; vertical-alignment: top;
            }
            Rectangle { min-height: 0px; vertical-stretch: 1; }
            HorizontalLayout {
                height: Theme.scribe ? 60px : 52px; vertical-stretch: 0;
                spacing: 10px;
                NavigationButton { text: Strings.read-return-last; icon: "back"; icon-size: Theme.scribe ? 18px : 15px; icon-spacing: (Theme.scribe ? 18px : 15px) * 0.15; height: parent.height; width: (parent.width - 20px) / 3; outlined: true; text-size: Theme.scribe ? 18px : 15px; clicked => { ReaderModel.action("last-view", ""); } }
                ActionButton { text: Strings.read-chapter-catalog; height: parent.height; horizontal-stretch: 1; text-size: Theme.scribe ? 18px : 15px; clicked => { ReaderModel.chapter-capacity = root.directory-capacity; ReaderModel.menu = true; ReaderModel.sheet = "toc"; ReaderModel.action("sheet", "toc"); } }
                ActionButton { text: Strings.read-return-shelf; height: parent.height; horizontal-stretch: 1; text-size: Theme.scribe ? 18px : 15px; clicked => { ReaderModel.action("shelf", ""); } }
            }
        }
    }
    if ReaderModel.menu: Rectangle {
        background: transparent;
        TouchArea {
            accessible-role: button;
            accessible-label: Strings.read-close-menu;
            accessible-action-default => { ReaderModel.menu = false; ReaderModel.sheet = ""; ReaderModel.action("menu", "close"); }
            clicked => { ReaderModel.menu = false; ReaderModel.sheet = ""; ReaderModel.action("menu", "close"); }
        }
        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: root.reader-status + root.reader-bar + 2px;
            background: Theme.paper;
            TouchArea { clicked => { } }
            Rectangle { y: parent.height - 2px; height: 2px; width: parent.width; background: Theme.ink; }
            if !root.wide-landscape: StatusBar {
                x: 0px; y: 0px; width: parent.width; height: root.reader-status;
                edge: root.reader-edge;
                clock: ReaderModel.clock;
                online: ReaderModel.connected;
                network: ReaderModel.offline ? Strings.read-offline : ReaderModel.network-label;
                battery: ReaderModel.battery-label;
            }
            if root.wide-landscape: Rectangle {
                x: 40px; y: 0px; width: parent.width - 80px; height: root.reader-status;
                ReaderText { x: 0px; y: 0px; width: parent.width * 0.4; height: parent.height; text: ReaderModel.clock; font-size: 16px; }
                ReaderText { x: parent.width * 0.4; y: 0px; width: parent.width * 0.6; height: parent.height; text: (ReaderModel.offline ? Strings.read-offline : ReaderModel.network-label) + " · " + ReaderModel.battery-label; font-size: 16px; horizontal-alignment: right; }
            }
            if !root.wide-landscape: HorizontalLayout {
                x: root.reader-edge;
                y: root.reader-status;
                width: parent.width - 2 * root.reader-edge;
                height: root.reader-bar;
                spacing: 12px;
                Rectangle {
                    width: Theme.scribe ? 92px : 80px; height: parent.height;
                    IconButton { x: 0px; y: (parent.height - self.height) / 2; icon: "back"; text: Strings.read-back; width: parent.width; height: root.reader-button; icon-size: Theme.scribe ? 26px : 24px; text-size: Theme.scribe ? 18px : 15px; clicked => { ReaderModel.action("back", ""); } }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    height: parent.height;
                    ReaderText { x: 0px; y: 0px; width: parent.width; height: parent.height; text: ReaderModel.comic-title + " · " + ReaderModel.episode-title; font-size: Theme.scribe ? 20px : 17px; font-weight: 700; overflow: elide; }
                }
                Rectangle {
                    width: root.reader-button; height: parent.height;
                    IconButton { x: 0px; y: (parent.height - self.height) / 2; icon: "download"; label: Strings.read-download-episode; width: parent.width; height: root.reader-button; icon-size: 24px; clicked => { ReaderModel.action("download", ""); } }
                }
                Rectangle {
                    width: root.reader-button; height: parent.height;
                    IconButton { x: 0px; y: (parent.height - self.height) / 2; icon: "shelf"; label: Strings.read-return-shelf; width: parent.width; height: root.reader-button; icon-size: 24px; clicked => { ReaderModel.action("shelf", ""); } }
                }
            }
            if root.wide-landscape: HorizontalLayout {
                x: 24px; y: root.reader-status; width: parent.width - 48px; height: root.reader-bar; spacing: 8px;
                Rectangle {
                    width: spread-back.preferred-width; height: parent.height;
                    spread-back := NavigationButton { x: 0px; y: (parent.height - self.height) / 2; text: Strings.read-back; icon: "back"; icon-size: 26px; text-size: 18px; height: 56px; clicked => { ReaderModel.action("back", ""); } }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    height: parent.height;
                    ReaderText { x: 0px; y: 0px; width: parent.width; height: parent.height; text: ReaderModel.comic-title + " · " + ReaderModel.episode-title; font-size: 20px; font-weight: 700; overflow: elide; }
                }
                Rectangle {
                    width: 64px; height: parent.height;
                    ActionButton { x: 0px; y: (parent.height - self.height) / 2; text: Strings.read-shelf; width: parent.width; height: 56px; quiet: true; text-size: 18px; clicked => { ReaderModel.action("shelf", ""); } }
                }
            }
        }

        if ReaderModel.sheet == "": Rectangle {
            y: parent.height - self.height;
            width: parent.width;
            height: Theme.scribe ? 208px : 184px;
            background: Theme.paper;
            TouchArea { clicked => { } }
            Rectangle { x: 0px; y: 0px; width: parent.width; height: 2px; background: Theme.ink; }
            HorizontalLayout {
                x: root.toolbar-left;
                y: 8px;
                width: parent.width - root.toolbar-left - root.toolbar-right;
                height: Theme.scribe ? 56px : 48px;
                spacing: 8px;
                Rectangle {
                    width: beginning-button.preferred-width; height: parent.height;
                    beginning-button := NavigationButton { x: 0px; y: (parent.height - self.height) / 2; text: Strings.read-beginning; icon: "back"; icon-size: Theme.scribe ? 18px : 15px; horizontal-padding: 10px; icon-spacing: (Theme.scribe ? 18px : 15px) * 0.15; height: root.reader-button; text-size: Theme.scribe ? 18px : 15px; clicked => { ReaderModel.menu = false; ReaderModel.sheet = ""; ReaderModel.action("beginning", ""); } }
                }
                ReaderSeek {
                    horizontal-stretch: 1;
                    height: parent.height;
                    value: ReaderModel.seek-index;
                    count: ReaderModel.seek-count;
                    label: Strings.read-seek + " · " + root.progress;
                    picked(value) => { ReaderModel.menu = false; ReaderModel.sheet = ""; ReaderModel.action("seek", "" + value); }
                }
                Rectangle {
                    width: max(64px, seek-caption.preferred-width); height: parent.height;
                    seek-caption := ReaderText { x: 0px; y: 0px; width: parent.width; height: parent.height; text: root.progress; horizontal-alignment: right; }
                }
            }
            ReaderChoice {
                x: root.toolbar-left;
                y: Theme.scribe ? 68px : 60px;
                width: parent.width - root.toolbar-left - root.toolbar-right;
                value: ReaderModel.fit;
                options: [
                    {value: "original", label: Strings.read-zoom-original},
                    {value: "page", label: Strings.read-zoom-page},
                    {value: "height", label: Strings.read-zoom-height},
                    {value: "width", label: Strings.read-zoom-width}
                ];
                picked(value) => { ReaderModel.fit = value; ReaderModel.action("setting", "fit:" + value); }
            }
            for tool[index] in [
                {id: "toc", label: Strings.read-toc, icon: "reader-list"},
                {id: "display", label: Strings.read-settings, icon: "reader-display"},
                {id: "refresh", label: Strings.read-refresh-short, icon: "reader-refresh"},
                {id: "light", label: Strings.read-frontlight, icon: "light"}
            ]: ReaderTool {
                x: root.toolbar-left + index * (parent.width - root.toolbar-left - root.toolbar-right) / 4;
                y: Theme.scribe ? 132px : 116px;
                width: (parent.width - root.toolbar-left - root.toolbar-right) / 4;
                icon: tool.icon;
                label: tool.label;
                clicked => {
                    if tool.id == "refresh" {
                        ReaderModel.menu = false;
                        ReaderModel.sheet = "";
                        ReaderModel.action("refresh", "");
                    } else {
                        if tool.id == "toc" { ReaderModel.chapter-capacity = root.directory-capacity; }
                        ReaderModel.sheet = tool.id;
                        ReaderModel.action("sheet", tool.id);
                    }
                }
            }
        }

        if ReaderModel.sheet == "display": display-sheet := Rectangle {
            y: parent.height - self.height;
            width: parent.width;
            height: display-note.y + display-note.preferred-height + 16px;
            background: Theme.paper;
            property <length> options-height: root.wide-landscape ? 4 * (Theme.scribe ? 60px : 52px) + 36px : 5 * (Theme.scribe ? 60px : 52px) + 48px;
            TouchArea { clicked => { } }
            Rectangle { x: 0px; y: 0px; width: parent.width; height: 2px; background: Theme.ink; }
            ReaderSheetHeader { x: root.reader-edge; y: 2px; width: parent.width - 2 * root.reader-edge; title: Strings.read-settings-comic; close => { ReaderModel.sheet = ""; ReaderModel.menu = false; ReaderModel.action("menu", "close"); } }
            if !root.wide-landscape: VerticalLayout {
                x: root.reader-edge;
                y: root.reader-bar + 14px;
                width: parent.width - 2 * root.reader-edge;
                height: display-sheet.options-height;
                spacing: 12px;
                ReaderChoiceRow { label: Strings.read-mode; value: ReaderModel.mode; options: [{value: "page", label: Strings.read-single-page}, {value: "panel", label: Strings.read-panel}, {value: "strip", label: Strings.read-strip}]; picked(value) => { ReaderModel.mode = value; ReaderModel.action("setting", "mode:" + value); } }
                ReaderChoiceRow { label: Strings.read-fit; value: ReaderModel.fit; options: [{value: "original", label: Strings.read-zoom-original}, {value: "page", label: Strings.read-zoom-page}, {value: "height", label: Strings.read-zoom-height}, {value: "width", label: Strings.read-zoom-width}]; picked(value) => { ReaderModel.fit = value; ReaderModel.action("setting", "fit:" + value); } }
                ReaderChoiceRow { label: Strings.read-direction; value: ReaderModel.direction; options: [{value: "ltr", label: Strings.read-ltr}, {value: "rtl", label: Strings.read-rtl}]; picked(value) => { ReaderModel.direction = value; ReaderModel.action("setting", "direction:" + value); } }
                ReaderChoiceRow { label: Strings.read-full-refresh; value: ReaderModel.refresh-policy; options: [{value: "smart", label: Strings.read-refresh-smart}, {value: "1", label: Strings.read-refresh-every}, {value: "6", label: Strings.read-refresh-six}, {value: "0", label: Strings.read-refresh-never}]; picked(value) => { ReaderModel.refresh-policy = value; ReaderModel.action("setting", "refresh-policy:" + value); } }
                ReaderChoiceRow { label: Strings.read-dither; value: ReaderModel.dither ? ReaderModel.dither-method : "off"; options: [{value: "software", label: Strings.read-dither-software}, {value: "hardware", label: Strings.read-dither-hardware}, {value: "off", label: Strings.read-off}]; picked(value) => { ReaderModel.dither = value != "off"; if value == "off" { ReaderModel.action("setting", "dither:off"); } else { ReaderModel.dither-method = value; ReaderModel.action("setting", "dither-method:" + value); } } }
            }
            if root.wide-landscape: HorizontalLayout {
                x: root.reader-edge;
                y: root.reader-bar + 14px;
                width: parent.width - 2 * root.reader-edge;
                height: display-sheet.options-height;
                spacing: 32px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 12px;
                    ReaderChoiceRow { label: Strings.read-mode; value: ReaderModel.mode; options: [{value: "page", label: Strings.read-single-page}, {value: "panel", label: Strings.read-panel}, {value: "strip", label: Strings.read-strip}]; picked(value) => { ReaderModel.mode = value; ReaderModel.action("setting", "mode:" + value); } }
                    ReaderChoiceRow { label: Strings.read-fit; value: ReaderModel.fit; options: [{value: "original", label: Strings.read-zoom-original}, {value: "page", label: Strings.read-zoom-page}, {value: "height", label: Strings.read-zoom-height}, {value: "width", label: Strings.read-zoom-width}]; picked(value) => { ReaderModel.fit = value; ReaderModel.action("setting", "fit:" + value); } }
                    ReaderChoiceRow { label: Strings.read-direction; value: ReaderModel.direction; options: [{value: "ltr", label: Strings.read-ltr}, {value: "rtl", label: Strings.read-rtl}]; picked(value) => { ReaderModel.direction = value; ReaderModel.action("setting", "direction:" + value); } }
                    ReaderChoiceRow { label: Strings.read-landscape-layout; value: ReaderModel.landscape-layout; options: [{value: "spread", label: Strings.read-spread}, {value: "single", label: Strings.read-single-page}]; picked(value) => { ReaderModel.landscape-layout = value; ReaderModel.action("setting", "landscape-layout:" + value); } }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 12px;
                    ReaderChoiceRow { label: Strings.read-cover-page; value: ReaderModel.cover-alone ? "on" : "off"; options: [{value: "on", label: Strings.read-on}, {value: "off", label: Strings.read-off}]; picked(value) => { ReaderModel.cover-alone = value == "on"; ReaderModel.action("setting", "cover-alone:" + value); } }
                    ReaderChoiceRow { label: Strings.read-full-refresh; value: ReaderModel.refresh-policy; options: [{value: "smart", label: Strings.read-refresh-smart}, {value: "1", label: Strings.read-refresh-every}, {value: "6", label: Strings.read-refresh-six}, {value: "0", label: Strings.read-refresh-never}]; picked(value) => { ReaderModel.refresh-policy = value; ReaderModel.action("setting", "refresh-policy:" + value); } }
                    ReaderChoiceRow { label: Strings.read-dither; value: ReaderModel.dither ? ReaderModel.dither-method : "off"; options: [{value: "software", label: Strings.read-dither-software}, {value: "hardware", label: Strings.read-dither-hardware}, {value: "off", label: Strings.read-off}]; picked(value) => { ReaderModel.dither = value != "off"; if value == "off" { ReaderModel.action("setting", "dither:off"); } else { ReaderModel.dither-method = value; ReaderModel.action("setting", "dither-method:" + value); } } }
                    Rectangle { min-height: 0px; vertical-stretch: 1; }
                }
            }
            display-note := ReaderText { x: root.reader-edge; y: root.reader-bar + 26px + display-sheet.options-height; width: parent.width - 2 * root.reader-edge; height: self.preferred-height; text: (ReaderModel.refresh-policy == "smart" ? Strings.read-refresh-smart-note : Strings.read-refresh-fixed-note) + ReaderModel.dither-note; font-size: Theme.scribe ? 16px : 14px; color: Theme.secondary; wrap: word-wrap; vertical-alignment: top; }
        }

        if ReaderModel.sheet == "toc": directory := Rectangle {
            x: 0px;
            y: 0px;
            width: root.width;
            height: root.height;
            background: Theme.paper;
            TouchArea { clicked => { } }
            StatusBar {
                x: 0px; y: 0px; width: parent.width; height: root.reader-status;
                edge: root.reader-edge; clock: ReaderModel.clock;
                online: ReaderModel.connected;
                network: ReaderModel.offline ? Strings.read-offline : ReaderModel.network-label;
                battery: ReaderModel.battery-label;
            }
            Rectangle {
                x: 0px; y: root.reader-status; width: parent.width; height: root.directory-header;
                property <length> back-width: Theme.scribe ? 164px : 116px;
                property <length> count-width: Theme.scribe ? 112px : 64px;
                NavigationButton {
                    x: root.reader-edge - 12px; y: (parent.height - self.height) / 2;
                    width: parent.back-width; height: root.reader-button;
                    icon: "back"; text: Strings.read-return-reading;
                    icon-size: Theme.scribe ? 26px : 24px; icon-spacing: Theme.scribe ? 6px : 4px;
                    text-size: Theme.scribe ? 20px : 16px;
                    clicked => { ReaderModel.menu = false; ReaderModel.sheet = ""; ReaderModel.action("menu", "close"); }
                }
                ReaderText {
                    x: root.reader-edge + parent.back-width + (Theme.scribe ? 20px : 8px);
                    y: 0px; width: max(0px, parent.width - root.reader-edge - parent.count-width - self.x - 8px);
                    height: parent.height; text: ReaderModel.comic-title + " · " + Strings.read-toc;
                    font-size: Theme.scribe ? 25px : 20px; font-weight: 700; overflow: elide;
                }
                ReaderText {
                    x: parent.width - root.reader-edge - parent.count-width; y: 0px;
                    width: parent.count-width; height: parent.height;
                    text: (Theme.scribe ? Strings.read-directory-count-prefix : "") + ReaderModel.chapter-count + Strings.read-episode-suffix;
                    font-size: Theme.scribe ? 18px : 15px; color: Theme.secondary; horizontal-alignment: right;
                }
                Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.ink; }
            }
            Rectangle {
                x: root.reader-edge;
                y: root.reader-status + root.directory-header + root.directory-filter-gap;
                width: parent.width - 2 * root.reader-edge;
                height: root.directory-filter-height;
                property <length> filter-width: min(parent.width - 2 * root.reader-edge, Theme.scribe ? 348px : 278px);
                property <length> sort-width: Theme.scribe ? 76px : 54px;
                property <length> locate-width: Theme.scribe ? 122px : 104px;
                for entry[index] in [
                    {value: "all", label: Strings.cat-all + " " + ReaderModel.chapter-count},
                    {value: "unread", label: Strings.cat-unread},
                    {value: "readable", label: Strings.cat-readable},
                    {value: "downloaded", label: Strings.cat-downloaded}
                ]: ActionButton {
                    x: index * parent.filter-width / 4; y: 0px;
                    width: parent.filter-width / 4; height: root.directory-filter-row;
                    text: entry.label; quiet: true; selected: ReaderModel.chapter-filter == entry.value;
                    text-size: Theme.scribe ? 18px : 15px;
                    clicked => { ReaderModel.chapter-capacity = root.directory-capacity; ReaderModel.action("toc", "filter:" + entry.value); }
                }
                ActionButton {
                    x: parent.width - parent.sort-width - parent.locate-width - 12px;
                    y: root.directory-stacked-controls ? root.directory-filter-row + 8px : 0px;
                    width: parent.locate-width; height: root.directory-filter-row;
                    text: Strings.read-directory-locate; text-size: Theme.scribe ? 18px : 15px;
                    clicked => { ReaderModel.chapter-capacity = root.directory-capacity; ReaderModel.action("toc", "locate"); }
                }
                ActionButton {
                    x: parent.width - parent.sort-width;
                    y: root.directory-stacked-controls ? root.directory-filter-row + 8px : 0px;
                    width: parent.sort-width; height: root.directory-filter-row;
                    text: ReaderModel.chapter-descending ? Strings.cat-descending : Strings.cat-ascending;
                    quiet: true; text-size: Theme.scribe ? 18px : 15px;
                    clicked => { ReaderModel.chapter-capacity = root.directory-capacity; ReaderModel.action("toc", ReaderModel.chapter-descending ? "sort:asc" : "sort:desc"); }
                }
            }
            if root.directory-wide-columns: Rectangle {
                x: 0px; y: root.directory-body-top - root.directory-columns;
                width: parent.width; height: root.directory-columns;
                ReaderText { x: root.reader-edge; y: 0px; width: 50px; height: parent.height; text: Strings.cat-episode-column; font-size: 16px; color: Theme.secondary; }
                ReaderText { x: root.reader-edge + 64px; y: 0px; width: max(0px, parent.width - root.reader-edge - 368px - self.x - 32px); height: parent.height; text: Strings.read-directory-title-column; font-size: 16px; color: Theme.secondary; }
                ReaderText { x: parent.width - root.reader-edge - 368px; y: 0px; width: 140px; height: parent.height; text: Strings.read-directory-progress-column; font-size: 16px; color: Theme.secondary; }
                ReaderText { x: parent.width - root.reader-edge - 212px; y: 0px; width: 112px; height: parent.height; text: Strings.cat-access-column; font-size: 16px; color: Theme.secondary; }
                ReaderText { x: parent.width - root.reader-edge - 84px; y: 0px; width: 84px; height: parent.height; text: Strings.cat-local-column; font-size: 16px; color: Theme.secondary; }
            }
            for chapter[index] in ReaderModel.chapters: Rectangle {
                visible: index < root.directory-capacity;
                y: root.directory-body-top + index * self.height;
                width: parent.width;
                height: root.directory-row;
                background: directory-touch.pressed ? Theme.ink : Theme.paper;
                accessible-role: button;
                accessible-label: chapter.order + " " + chapter.title + " " + chapter.progress + " " + chapter.access + " " + chapter.storage;
                accessible-action-default => { ReaderModel.menu = false; ReaderModel.sheet = ""; ReaderModel.action("episode", chapter.id); }
                if chapter.current: Rectangle { x: 0px; y: 8px; width: 4px; height: parent.height - 16px; background: directory-touch.pressed ? Theme.paper : Theme.ink; }
                ReaderText { x: root.reader-edge; y: 0px; width: 48px; height: parent.height; text: chapter.order; font-size: Theme.scribe ? 20px : 18px; font-weight: chapter.current ? 700 : 500; color: directory-touch.pressed ? Theme.paper : Theme.ink; }
                if root.directory-wide-columns: ReaderText { x: root.reader-edge + 64px; y: 0px; width: max(0px, parent.width - root.reader-edge - 368px - self.x - 32px); height: parent.height; text: chapter.title; font-size: 20px; font-weight: chapter.current ? 700 : 400; color: directory-touch.pressed ? Theme.paper : Theme.ink; overflow: elide; }
                if root.directory-wide-columns: ReaderText { x: parent.width - root.reader-edge - 368px; y: 0px; width: 140px; height: parent.height; text: chapter.progress; font-size: 17px; font-weight: chapter.current ? 700 : 400; color: directory-touch.pressed ? Theme.paper : chapter.current ? Theme.ink : Theme.secondary; overflow: elide; }
                if !root.directory-wide-columns: Rectangle {
                    x: root.reader-edge + (Theme.scribe ? 52px : 46px); y: 0px;
                    width: max(0px, parent.width - root.reader-edge - 132px - self.x); height: parent.height;
                    ReaderText { x: 0px; y: Theme.scribe ? 10px : 4px; width: parent.width; height: 28px; text: chapter.title; font-size: Theme.scribe ? 20px : 18px; font-weight: chapter.current ? 700 : 400; color: directory-touch.pressed ? Theme.paper : Theme.ink; overflow: elide; }
                    ReaderText { x: 0px; y: Theme.scribe ? 40px : 33px; width: parent.width; height: 22px; text: chapter.progress + (chapter.storage != "" && chapter.storage != "—" ? " · " + chapter.storage : ""); font-size: 14px; font-weight: chapter.current ? 500 : 400; color: directory-touch.pressed ? Theme.paper : chapter.current ? Theme.ink : Theme.secondary; overflow: elide; }
                }
                tag := Rectangle {
                    x: root.directory-wide-columns ? parent.width - root.reader-edge - 212px : parent.width - root.reader-edge - self.width;
                    y: (parent.height - self.height) / 2;
                    width: min(116px, max(48px, tag-label.preferred-width + 14px)); height: Theme.scribe ? 28px : 26px;
                    border-width: chapter.temporary ? 0px : 1px; border-color: directory-touch.pressed ? Theme.paper : Theme.ink; background: transparent;
                    if chapter.temporary: DashedOutline { width: parent.width; height: parent.height; stroke: 1px; stroke-color: directory-touch.pressed ? Theme.paper : Theme.ink; }
                    tag-label := ReaderText { x: 7px; y: 0px; width: parent.width - 14px; height: parent.height; text: chapter.access != "" ? chapter.access : chapter.tag; font-size: Theme.scribe ? 16px : 13px; color: directory-touch.pressed ? Theme.paper : Theme.ink; horizontal-alignment: center; overflow: elide; }
                }
                if root.directory-wide-columns: ReaderText { x: parent.width - root.reader-edge - 84px; y: 0px; width: 84px; height: parent.height; text: chapter.storage; font-size: 16px; color: directory-touch.pressed ? Theme.paper : Theme.secondary; overflow: elide; }
                Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.line; }
                directory-touch := TouchArea {
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down { Theme.refresh("press"); }
                        if event.kind == PointerEventKind.up { Theme.refresh("release"); }
                    }
                    clicked => { ReaderModel.menu = false; ReaderModel.sheet = ""; ReaderModel.action("episode", chapter.id); }
                }
            }
            if ReaderModel.chapters.length == 0: ReaderText {
                x: root.reader-edge; y: root.directory-body-top;
                width: parent.width - 2 * root.reader-edge;
                height: max(root.directory-row, parent.height - root.directory-body-top - root.directory-footer);
                text: Strings.read-directory-empty; font-size: Theme.scribe ? 20px : 17px;
                color: Theme.secondary; horizontal-alignment: center; wrap: word-wrap;
            }
            Rectangle {
                x: 0px; y: parent.height - root.directory-footer;
                width: parent.width; height: root.directory-footer; background: Theme.paper;
                Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.ink; }
                NavigationButton {
                    x: root.reader-edge - 12px; y: (parent.height - self.height) / 2;
                    height: root.reader-button; icon: "back"; text: Strings.cat-previous-page;
                    text-size: Theme.scribe ? 18px : 16px; enabled: ReaderModel.chapter-page > 1;
                    clicked => { ReaderModel.chapter-capacity = root.directory-capacity; ReaderModel.action("toc", "previous"); }
                }
                ReaderText { x: parent.width / 2 - 60px; y: 0px; width: 120px; height: parent.height; text: ReaderModel.chapter-page + " / " + ReaderModel.chapter-pages; horizontal-alignment: center; font-size: Theme.scribe ? 18px : 16px; }
                NavigationButton {
                    x: parent.width - root.reader-edge - self.width + 12px; y: (parent.height - self.height) / 2;
                    height: root.reader-button; icon: "next"; trailing: true; text: Strings.cat-next-page;
                    text-size: Theme.scribe ? 18px : 16px; enabled: ReaderModel.chapter-page < ReaderModel.chapter-pages;
                    clicked => { ReaderModel.chapter-capacity = root.directory-capacity; ReaderModel.action("toc", "next"); }
                }
            }
        }

        if ReaderModel.sheet == "light": Rectangle {
            y: parent.height - self.height;
            width: parent.width;
            height: root.reader-bar + 158px + (!ReaderModel.brightness-available || !ReaderModel.warmth-available ? 28px : 0px);
            background: Theme.paper;
            TouchArea { clicked => { } }
            Rectangle { x: 0px; y: 0px; width: parent.width; height: 2px; background: Theme.ink; }
            ReaderSheetHeader { x: root.reader-edge; y: 2px; width: parent.width - 2 * root.reader-edge; title: Strings.read-frontlight; close => { ReaderModel.menu = false; ReaderModel.sheet = ""; ReaderModel.action("menu", "close"); } }
            ReaderLightRow { x: root.reader-edge; y: root.reader-bar + 18px; width: parent.width - 2 * root.reader-edge; label: Strings.read-brightness; value: ReaderModel.brightness; available: ReaderModel.brightness-available; busy: ReaderModel.light-busy; changed(value) => { ReaderModel.action("brightness", value); } }
            ReaderLightRow { x: root.reader-edge; y: root.reader-bar + 86px; width: parent.width - 2 * root.reader-edge; label: Strings.read-warmth; value: ReaderModel.warmth; available: ReaderModel.warmth-available; busy: ReaderModel.light-busy; changed(value) => { ReaderModel.action("warmth", value); } }
            if !ReaderModel.brightness-available || !ReaderModel.warmth-available: ReaderText { x: root.reader-edge; y: parent.height - 38px; width: parent.width - 2 * root.reader-edge; height: 26px; text: Strings.read-hardware-unavailable; font-size: Theme.scribe ? 16px : 14px; color: Theme.secondary; }
        }
    }

    if ReaderModel.guidance && !ReaderModel.menu: Rectangle {
        background: Theme.paper;
        ReaderText { x: 12px; y: root.height * 0.18; width: root.width - 24px; height: 30px; text: ReaderModel.zoom-available ? Strings.read-hint-gesture-zoom : Strings.read-hint-gesture; color: Theme.secondary; horizontal-alignment: center; }
        ReaderText { x: 24px; y: root.height * 0.18 + 40px; width: root.width - 48px; height: 44px; text: Strings.read-hint-progress; font-size: Theme.scribe ? 16px : 14px; color: Theme.secondary; horizontal-alignment: center; wrap: word-wrap; }
        for index in 3: Rectangle {
            x: index == 0 ? 0px : index == 1 ? root.width * 0.3 : root.width * 0.7;
            width: root.width * (index == 1 ? 0.4 : 0.3);
            height: root.height;
            background: transparent;
            ReaderText { y: parent.height / 2 - 32px; height: 34px; text: index == 1 ? Strings.read-hint-menu : (index == 0) != (ReaderModel.direction == "rtl") ? Strings.read-previous-page : Strings.read-next-page; font-size: Theme.scribe ? 24px : 20px; font-weight: 700; horizontal-alignment: center; }
            ReaderText { y: parent.height / 2 + 12px; height: 28px; text: index == 0 ? Strings.read-hint-left : index == 1 ? Strings.read-hint-center : Strings.read-hint-right; font-size: Theme.scribe ? 16px : 14px; color: Theme.secondary; horizontal-alignment: center; }
        }
        for index in root.guide-dash-count: Rectangle { x: root.width * 0.3 - 1px; y: index * 14px; width: 2px; height: 8px; background: Theme.ink; }
        for index in root.guide-dash-count: Rectangle { x: root.width * 0.7 - 1px; y: index * 14px; width: 2px; height: 8px; background: Theme.ink; }
        Rectangle { x: (root.width - self.width) / 2; y: root.height * 0.88 - self.height; width: start-label.preferred-width + 44px; height: 50px; background: Theme.ink; start-label := ReaderText { x: 22px; width: parent.width - 44px; text: Strings.read-hint-start; font-size: Theme.scribe ? 20px : 17px; font-weight: 500; color: Theme.paper; horizontal-alignment: center; } }
        TouchArea {
            accessible-role: button;
            accessible-label: Strings.read-hint-dismiss;
            accessible-action-default => { ReaderModel.guidance = false; ReaderModel.action("guidance", "dismiss"); }
            clicked => { ReaderModel.guidance = false; ReaderModel.action("guidance", "dismiss"); }
        }
    }
}
