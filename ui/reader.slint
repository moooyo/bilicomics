import { Theme } from "theme.slint";
import { Strings } from "strings.slint";
import { ActionButton, DashedOutline, DashedRule, Icon, NavigationButton, StatusBar } from "widgets.slint";

export struct ReaderThumbnail {
    page: int,
    picture: image,
    label: string,
    cached: bool,
    current: bool,
}

export struct ReaderChapter {
    id: string,
    order: string,
    title: string,
    tag: string,
    progress: string,
    access: string,
    storage: string,
    current: bool,
    read: bool,
    downloaded: bool,
    readable: bool,
    temporary: bool,
}

export global ReaderModel {
    callback action(string, string);
    in-out property <image> page;
    in-out property <image> second-page;
    in-out property <image> overview-image;
    in-out property <int> page-index: 1;
    in-out property <int> page-count: 1;
    in-out property <int> seek-index: 1;
    in-out property <int> seek-count: 1;
    in-out property <int> left-page-index;
    in-out property <int> right-page-index;
    in-out property <bool> spread-active;
    in-out property <string> spread-label;
    in-out property <string> comic-title;
    in-out property <string> episode-title;
    in-out property <string> return-label: Strings.read-shelf;
    // An empty state enables download; all non-empty states are non-interactive.
    in-out property <string> download-state: "unavailable";
    in-out property <string> transition-episode-title;
    in-out property <string> progress-label;
    in-out property <string> cache-label;
    in-out property <string> clock: "--:--";
    in-out property <string> battery-label: "--%";
    in-out property <string> network-label;
    in-out property <string> mode: "page";
    in-out property <string> fit: "page";
    in-out property <string> direction: "ltr";
    in-out property <string> refresh-policy: "smart";
    in-out property <string> refresh-mode: "normal";
    in-out property <string> refresh-mode-note;
    in-out property <bool> presented-fast-mode: false;
    in-out property <bool> presented-cpu-dither: false;
    in-out property <string> landscape-layout: "spread";
    in-out property <bool> landscape;
    in-out property <bool> menu;
    in-out property <bool> guidance;
    in-out property <bool> transition;
    in-out property <bool> loading;
    in-out property <bool> retain-page;
    in-out property <bool> preparing-feedback;
    in-out property <bool> failed;
    in-out property <bool> offline;
    in-out property <bool> connected;
    in-out property <string> landscape-subtitle;
    in-out property <string> continue-label;
    // Kept for preference and integration compatibility; quiet reading has no footer.
    in-out property <bool> show-footer: true;
    in-out property <bool> dither: true;
    in-out property <string> dither-method: "bayer8";
    in-out property <bool> jpeg-acceleration: false;
    in-out property <bool> jpeg-acceleration-available: false;
    in-out property <string> jpeg-acceleration-note;
    in-out property <bool> cover-alone: true;
    in-out property <bool> next-locked: true;
    in-out property <bool> next-available: true;
    in-out property <bool> zoom-available;
    in-out property <string> sheet;
    in-out property <string> error-message;
    in-out property <string> retry-label;
    in-out property <string> dither-note;
    in-out property <string> next-title;
    in-out property <string> next-note;
    in-out property <string> next-price;
    in-out property <string> wallet-label;
    in-out property <string> coupon-label;
    in-out property <int> brightness;
    in-out property <int> warmth;
    in-out property <bool> brightness-available;
    in-out property <bool> warmth-available;
    in-out property <bool> light-busy;
    in-out property <int> panel-index: 1;
    in-out property <int> panel-count: 1;
    in-out property <int> strip-screen: 1;
    in-out property <int> strip-count: 1;
    in-out property <bool> overlap;
    in-out property <float> viewport-ratio: 0.72;
    in-out property <float> focus-x;
    in-out property <float> focus-y;
    in-out property <float> focus-width: 1;
    in-out property <float> focus-height: 1;
    in-out property <[ReaderThumbnail]> thumbnails;
    in-out property <bool> thumbnails-loading;
    in-out property <int> grid-page: 1;
    in-out property <int> grid-pages: 1;
    in-out property <[ReaderChapter]> chapters;
    in-out property <int> chapter-count;
    in-out property <int> chapter-page: 1;
    in-out property <int> chapter-pages: 1;
    in-out property <string> chapter-filter: "all";
    in-out property <bool> chapter-descending;
    in-out property <int> chapter-capacity: 14;
}

struct ReaderOption {
    value: string,
    label: string,
}

struct ReaderSetting {
    key: string,
    label: string,
    value: string,
    options: [ReaderOption],
    paused: bool,
    unavailable: bool,
}

component ReaderText inherits Text {
    color: Theme.ink;
    font-family: Theme.ui-font;
    font-size: Theme.scribe ? 18px : 15px;
    vertical-alignment: center;
}

component ReaderChoice inherits Rectangle {
    in property <[ReaderOption]> options;
    in property <string> label;
    in property <string> value;
    in property <bool> paused;
    callback picked(string);
    background: Theme.paper;
    border-color: Theme.ink;
    border-width: root.paused ? 0px : 2px;

    for option[index] in root.options: Rectangle {
        x: 2px + index * (root.width - 4px) / max(1, root.options.length);
        y: 2px;
        width: (root.width - 4px) / max(1, root.options.length);
        height: root.height - 4px;
        property <bool> selected: option.value == root.value;
        property <bool> inverted: !root.paused && (self.selected || touch.pressed);
        background: self.inverted ? Theme.ink : Theme.paper;
        accessible-role: button;
        accessible-label: root.label + " · " + option.label;
        accessible-enabled: !root.paused;
        accessible-checkable: true;
        accessible-checked: self.selected;
        accessible-action-default => { if !root.paused { root.picked(option.value); } }
        caption := ReaderText {
            x: 4px; y: 0px;
            width: parent.width - 8px; height: parent.height;
            text: option.label;
            color: parent.inverted ? Theme.paper : root.paused && !parent.selected ? Theme.secondary : Theme.ink;
            font-weight: parent.selected ? 700 : 400;
            horizontal-alignment: center;
            overflow: elide;
        }
        if root.paused && option.value == root.value: Rectangle {
            width: min(caption.width, caption.preferred-width);
            height: 1px;
            x: (parent.width - self.width) / 2;
            y: min(parent.height - 2px, (parent.height + caption.preferred-height) / 2 + 1px);
            background: Theme.ink;
        }
        if index > 0 && !root.paused: Rectangle {
            x: 0px; y: 0px; width: 2px; height: parent.height;
            background: Theme.ink;
        }
        if index > 0 && root.paused: DashedRule {
            x: 0px; y: 0px; width: 2px; height: parent.height;
            vertical: true; stroke: 2px; stroke-color: Theme.secondary;
        }
        touch := TouchArea {
            x: 0px; y: min(0px, (parent.height - Theme.touch-size) / 2);
            width: parent.width; height: max(parent.height, Theme.touch-size);
            enabled: !root.paused;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down { Theme.refresh("press"); }
                if event.kind == PointerEventKind.up { Theme.refresh("release"); }
            }
            clicked => { root.picked(option.value); }
        }
    }
    if root.paused: DashedOutline { stroke: 2px; stroke-color: Theme.secondary; }
}

component ReaderSettingsGroup inherits Rectangle {
    in property <[ReaderSetting]> settings;
    in property <string> title;
    in property <length> column-header: Theme.scribe ? 40px : 0px;
    in property <length> row-height: Theme.scribe ? 90px : 48px;
    in property <length> row-gap: Theme.scribe ? 13px : 12px;
    property <length> control-height: Theme.scribe ? root.row-height - 34px : root.row-height - 4px;
    property <length> label-width: 104px;
    height: root.column-header + root.settings.length * (root.row-height + root.row-gap) - root.row-gap;

    if Theme.scribe: ReaderText {
        x: 0px; y: 0px; width: parent.width; height: 26px;
        text: root.title; font-size: 17px; font-weight: 700; color: Theme.secondary;
    }
    for setting[index] in root.settings: Rectangle {
        x: 0px; y: root.column-header + index * (root.row-height + root.row-gap);
        width: root.width; height: root.row-height;
        property <length> control-x: Theme.scribe ? 0px : root.label-width + 12px;
        property <length> control-y: Theme.scribe ? 30px : (root.row-height - root.control-height) / 2;
        setting-label := ReaderText {
            x: 0px; y: Theme.scribe ? 0px : setting.paused ? 3px : 0px;
            width: Theme.scribe ? parent.width : root.label-width;
            height: Theme.scribe ? 26px : setting.paused ? 20px : parent.height;
            text: setting.label;
            color: Theme.scribe ? Theme.ink : Theme.secondary;
            overflow: elide;
        }
        if setting.paused: ReaderText {
            x: Theme.scribe ? setting-label.preferred-width + 8px : 0px;
            y: Theme.scribe ? 0px : 23px;
            width: Theme.scribe ? parent.width - self.x : root.label-width;
            height: Theme.scribe ? 26px : 20px;
            text: (Theme.scribe ? "· " : "") + Strings.read-setting-paused;
            font-size: Theme.minimum-size;
            font-weight: 700;
        }
        if !setting.unavailable: ReaderChoice {
            x: parent.control-x; y: parent.control-y;
            width: parent.width - self.x; height: root.control-height;
            label: setting.paused ? setting.label + " · " + Strings.read-setting-paused : setting.label;
            options: setting.options;
            value: setting.value;
            paused: setting.paused;
            picked(value) => { ReaderModel.action("setting", setting.key + ":" + value); }
        }
        if setting.unavailable: DashedOutline {
            x: parent.control-x; y: parent.control-y;
            width: parent.width - self.x; height: root.control-height;
            stroke: 2px; stroke-color: Theme.secondary;
            ReaderText { text: Strings.read-unavailable; color: Theme.secondary; horizontal-alignment: center; }
        }
    }
}

component ReaderSheetHeader inherits Rectangle {
    in property <string> title;
    in property <bool> divider;
    callback close();
    height: Theme.scribe ? 72px : 52px;
    ReaderText {
        x: 0px; y: 0px;
        width: parent.width - close-button.width - 12px;
        height: parent.height;
        text: root.title;
        font-size: Theme.scribe ? 24px : 18px;
        font-weight: 700;
        overflow: elide;
    }
    close-button := ActionButton {
        x: parent.width - self.width;
        y: (parent.height - self.height) / 2;
        width: self.preferred-width;
        height: Theme.scribe ? 56px : 44px;
        text: Strings.read-done;
        text-size: Theme.scribe ? 20px : 16px;
        text-weight: 700;
        clicked => { root.close(); }
    }
    if root.divider: Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.ink; }
}

component ReaderBottomPanel inherits Rectangle {
    background: Theme.paper;
    TouchArea { clicked => { } }
    Rectangle { x: 0px; y: -16px; width: parent.width; height: 16px; background: Theme.paper; }
    Rectangle { x: 0px; y: 0px; width: parent.width; height: 2px; background: Theme.ink; }
    @children
}

component ReaderSettings inherits ReaderBottomPanel {
    callback close();
    property <bool> layout-tab: true;
    property <bool> fast: ReaderModel.refresh-mode == "fast";
    property <length> inset: Theme.scribe ? 48px : 16px;
    property <length> body-top: Theme.scribe ? 92px : 112px;
    property <length> column-gap: 48px;
    property <length> column-width: Theme.scribe ? (root.width - 2 * root.inset - root.column-gap) / 2 : root.width - 2 * root.inset;
    property <bool> compact: Theme.scribe && root.height < 610px;
    property <[ReaderSetting]> layout-settings: [
        { key: "fit", label: Strings.read-fit, value: ReaderModel.fit, paused: false, unavailable: false, options: [
            {value: "original", label: Strings.read-zoom-original}, {value: "page", label: Strings.read-zoom-page},
            {value: "height", label: Strings.read-zoom-height}, {value: "width", label: Strings.read-zoom-width}
        ] },
        { key: "mode", label: Strings.read-mode, value: ReaderModel.mode, paused: false, unavailable: false, options: [
            {value: "page", label: Strings.read-single-page}, {value: "panel", label: Strings.read-panel},
            {value: "strip", label: Strings.read-strip}
        ] },
        { key: "direction", label: Strings.read-direction, value: ReaderModel.direction, paused: false, unavailable: false, options: [
            {value: "ltr", label: Strings.read-ltr}, {value: "rtl", label: Strings.read-rtl}
        ] },
        { key: "landscape-layout", label: Strings.read-landscape-layout, value: ReaderModel.landscape-layout, paused: false, unavailable: false, options: [
            {value: "spread", label: Strings.read-spread}, {value: "single", label: Strings.read-landscape-single}
        ] }
    ];
    property <[ReaderSetting]> display-settings: [
        { key: "refresh-mode", label: Strings.refresh-mode-label, value: ReaderModel.refresh-mode, paused: false, unavailable: false, options: [
            {value: "normal", label: Strings.refresh-mode-normal}, {value: "fast", label: Strings.refresh-mode-fast}
        ] },
        { key: "refresh-policy", label: Strings.read-full-refresh, value: ReaderModel.refresh-policy, paused: root.fast, unavailable: false, options: [
            {value: "smart", label: Strings.read-refresh-smart}, {value: "1", label: Strings.read-refresh-every},
            {value: "6", label: Strings.read-refresh-six}, {value: "0", label: Strings.read-refresh-never}
        ] },
        { key: "dither-method", label: Strings.read-dither, value: ReaderModel.dither ? ReaderModel.dither-method : "off", paused: root.fast, unavailable: false, options: [
            {value: "off", label: Strings.spatial-dither-off}, {value: "bayer8", label: Strings.read-dither-bayer},
            {value: "floyd_steinberg", label: Strings.read-dither-high-precision}
        ] },
        { key: "jpeg-acceleration", label: Strings.media-jpeg-acceleration, value: ReaderModel.jpeg-acceleration ? "on" : "off", paused: false, unavailable: !ReaderModel.jpeg-acceleration-available, options: [
            {value: "on", label: Strings.read-on}, {value: "off", label: Strings.read-off}
        ] }
    ];
    height: Theme.scribe ? 610px : 376px;

    ReaderSheetHeader {
        x: root.inset; y: 2px; width: parent.width - 2 * root.inset;
        title: Strings.read-settings-comic;
        divider: Theme.scribe;
        close => { root.close(); }
    }
    if !Theme.scribe: Rectangle {
        x: 0px; y: 54px; width: parent.width; height: 44px;
        accessible-role: tab-list;
        Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.ink; }
        for label[index] in [Strings.read-settings-layout, Strings.read-settings-display]: Rectangle {
            x: root.inset + index * 56px; y: 0px; width: 48px; height: parent.height;
            property <bool> selected: (index == 0) == root.layout-tab;
            background: tab-touch.pressed ? Theme.pale : transparent;
            accessible-role: tab;
            accessible-label: label;
            accessible-item-selected: self.selected;
            accessible-action-default => { root.layout-tab = index == 0; }
            ReaderText { text: label; font-size: 16px; font-weight: parent.selected ? 700 : 400; horizontal-alignment: center; }
            if (index == 0) == root.layout-tab: Rectangle { x: 0px; y: parent.height - 3px; width: parent.width; height: 3px; background: Theme.ink; }
            tab-touch := TouchArea {
                x: 0px; y: -2px; width: parent.width; height: 48px;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down { Theme.refresh("press"); }
                    if event.kind == PointerEventKind.up { Theme.refresh("release"); }
                }
                clicked => { root.layout-tab = index == 0; }
            }
        }
    }
    Flickable {
        x: root.inset; y: root.body-top;
        width: parent.width - 2 * root.inset;
        height: max(0px, parent.height - self.y);
        viewport-width: self.width;
        viewport-height: max(self.height, left-settings.height + 16px);
        interactive: self.viewport-height > self.height;
        left-settings := ReaderSettingsGroup {
            x: 0px; y: 0px; width: root.column-width;
            row-height: root.compact ? 82px : Theme.scribe ? 90px : 48px;
            row-gap: root.compact ? 10px : Theme.scribe ? 13px : 12px;
            settings: Theme.scribe || root.layout-tab ? root.layout-settings : root.display-settings;
            title: Strings.read-settings-layout;
        }
        if Theme.scribe: ReaderSettingsGroup {
            x: root.column-width + root.column-gap; y: 0px; width: root.column-width;
            row-height: left-settings.row-height;
            row-gap: left-settings.row-gap;
            settings: root.display-settings;
            title: Strings.read-settings-display;
        }
    }
}

component ReaderTool inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    callback clicked();
    property <length> icon-size: Theme.scribe ? 28px : 24px;
    property <length> label-height: Theme.scribe ? 24px : 22px;
    property <length> gap: Theme.scribe ? 4px : 2px;
    background: touch.pressed ? Theme.ink : Theme.paper;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    symbol := Icon {
        x: (parent.width - self.width) / 2; y: (parent.height - self.height - root.gap - root.label-height) / 2;
        width: root.icon-size; height: self.width;
        kind: root.icon; inverted: touch.pressed;
    }
    ReaderText {
        y: symbol.y + symbol.height + root.gap;
        height: root.label-height;
        text: root.label;
        color: touch.pressed ? Theme.paper : Theme.ink;
        font-size: Theme.scribe ? 17px : 14px;
        horizontal-alignment: center;
    }
    touch := TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down { Theme.refresh("press"); }
            if event.kind == PointerEventKind.up { Theme.refresh("release"); }
        }
        clicked => { root.clicked(); }
    }
}

component ReaderSeek inherits Rectangle {
    in property <int> value: 1;
    in property <int> count: 1;
    in property <string> label;
    in property <bool> rtl;
    out property <int> preview: pointer.pressed ? root.pointer-value : root.value;
    out property <bool> dragging: pointer.pressed;
    callback picked(int);
    property <bool> has-press;
    property <float> pointer-fraction: max(0, min(1, (pointer.mouse-x - track.x) / max(1px, track.width)));
    property <int> pointer-value: 1 + round((root.rtl ? 1 - root.pointer-fraction : root.pointer-fraction) * max(0, root.count - 1));
    property <float> ratio: max(0, min(1, (root.preview - 1) / max(1, root.count - 1)));
    property <length> thumb-width: Theme.scribe ? 24px : 20px;
    property <length> thumb-height: Theme.scribe ? 44px : 36px;
    property <length> fill-width: track.width * root.ratio;
    property <length> thumb-center: track.x + track.width * (root.rtl ? 1 - root.ratio : root.ratio);
    accessible-role: slider;
    accessible-label: root.label;
    accessible-enabled: root.count > 1;
    accessible-orientation: Orientation.horizontal;
    accessible-value: root.preview;
    accessible-value-minimum: 1;
    accessible-value-maximum: max(1, root.count);
    accessible-value-step: 1;
    accessible-action-set-value(value) => { if root.count > 1 && value.is-float() { root.picked(max(1, min(root.count, round(value.to-float())))); } }
    accessible-action-increment => { if root.count > 1 { root.picked(min(root.count, root.value + 1)); } }
    accessible-action-decrement => { if root.count > 1 { root.picked(max(1, root.value - 1)); } }
    forward-focus: keyboard;
    track := Rectangle {
        x: root.thumb-width / 2; y: (parent.height - self.height) / 2;
        width: parent.width - root.thumb-width; height: Theme.scribe ? 14px : 12px;
        background: Theme.paper; border-width: 2px; border-color: Theme.ink;
        Rectangle {
            x: root.rtl ? parent.width - self.width : 0px; y: 0px;
            width: root.fill-width; height: parent.height; background: Theme.ink;
        }
    }
    Rectangle {
        x: root.thumb-center - self.width / 2; y: (parent.height - self.height) / 2;
        width: root.thumb-width; height: root.thumb-height;
        background: Theme.paper; border-width: 2px; border-color: Theme.ink;
        Rectangle {
            x: Theme.scribe ? 6px : 5px; y: self.x;
            width: parent.width - 2 * self.x; height: parent.height - 2 * self.y;
            background: Theme.ink;
        }
    }
    if keyboard.has-focus: Rectangle {
        x: 1px; y: 4px; width: parent.width - 2px; height: parent.height - 8px;
        border-width: 1px; border-color: Theme.ink; background: transparent;
    }
    pointer := TouchArea {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        enabled: root.count > 1;
        // The slider follows the pointer without requesting a reader render until release.
        pointer-event(event) => {
            if event.kind == PointerEventKind.cancel {
                root.has-press = false;
            } else if event.button == PointerEventButton.left {
                if event.kind == PointerEventKind.down { root.has-press = true; }
                if event.kind == PointerEventKind.up && root.has-press {
                    root.has-press = false;
                    root.picked(root.pointer-value);
                }
            }
        }
    }
    keyboard := FocusScope {
        x: 0px; y: 0px; width: 0px; height: 0px; enabled: root.count > 1;
        key-pressed(event) => {
            if event.text == Key.RightArrow || event.text == Key.LeftArrow {
                root.picked(max(1, min(root.count, root.value + ((event.text == Key.RightArrow) != root.rtl ? 1 : -1))));
                return accept;
            }
            if event.text == Key.Home { root.picked(1); return accept; }
            if event.text == Key.End { root.picked(root.count); return accept; }
            return reject;
        }
    }
}

component ReaderTapZone inherits Rectangle {
    in property <string> intent;
    in property <string> label;
    background: transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => {
        if root.intent == "menu" {
            ReaderModel.menu = true;
            ReaderModel.sheet = "";
            ReaderModel.action("menu", "open");
        } else {
            ReaderModel.action("turn", root.intent);
        }
    }
    property <length> start-x;
    property <length> start-y;
    property <bool> gesture-moved;
    touch := TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.start-x = self.mouse-x;
                root.start-y = self.mouse-y;
                root.gesture-moved = false;
            }
            if event.kind == PointerEventKind.up {
                if abs(self.mouse-x - root.start-x) >= 64px && abs(self.mouse-x - root.start-x) > abs(self.mouse-y - root.start-y) {
                    root.gesture-moved = true;
                    ReaderModel.action("turn", (self.mouse-x < root.start-x) != (ReaderModel.direction == "rtl") ? "next" : "previous");
                } else if abs(self.mouse-y - root.start-y) >= 64px {
                    root.gesture-moved = true;
                    if ReaderModel.mode == "strip" {
                        ReaderModel.action("turn", self.mouse-y < root.start-y ? "next" : "previous");
                    }
                }
            }
        }
        clicked => {
            if !root.gesture-moved && abs(self.mouse-x - root.start-x) < 64px && abs(self.mouse-y - root.start-y) < 64px {
                if root.intent == "menu" {
                    ReaderModel.menu = true;
                    ReaderModel.sheet = "";
                    ReaderModel.action("menu", "open");
                } else {
                    ReaderModel.action("turn", root.intent);
                }
            }
        }
    }
}

component ReaderLightRow inherits Rectangle {
    in property <string> label;
    in property <int> value;
    in property <bool> available;
    in property <bool> busy;
    in property <length> value-width;
    callback stepped(string);
    property <length> label-width: Theme.scribe ? 52px : 40px;
    property <length> step-size: Theme.scribe ? 56px : 48px;
    property <length> gap: Theme.scribe ? 16px : 12px;
    property <int> level-count: 24;
    height: Theme.scribe ? 80px : 64px;

    ReaderText { x: 0px; y: 0px; width: root.label-width; height: parent.height; text: root.label; color: Theme.secondary; }
    decrease := ActionButton {
        x: root.label-width + root.gap; y: (parent.height - self.height) / 2;
        width: root.step-size; height: self.width;
        text: "−"; label: Strings.read-light-decrease + root.label;
        text-size: Theme.scribe ? 28px : 24px;
        enabled: root.available && !root.busy && root.value > 0;
        clicked => { root.stepped("-1"); }
    }
    Rectangle {
        x: decrease.x + decrease.width + root.gap; y: (parent.height - self.height) / 2;
        width: max(0px, increase.x - root.gap - self.x); height: Theme.scribe ? 24px : 20px;
        property <length> tick-gap: min(Theme.scribe ? 3px : 2px, self.width / (2 * root.level-count));
        property <length> tick-width: (self.width - (root.level-count - 1) * self.tick-gap) / root.level-count;
        for index in root.level-count: Rectangle {
            x: index * (parent.tick-width + parent.tick-gap); y: 0px;
            width: parent.tick-width; height: parent.height;
            background: root.available && index < root.value ? Theme.ink : Theme.paper;
            border-width: 1.5px; border-color: root.available ? Theme.ink : Theme.secondary;
        }
    }
    increase := ActionButton {
        x: parent.width - root.value-width - root.gap - self.width; y: (parent.height - self.height) / 2;
        width: root.step-size; height: self.width;
        text: "+"; label: Strings.read-light-increase + root.label;
        text-size: Theme.scribe ? 28px : 24px;
        enabled: root.available && !root.busy && root.value < root.level-count;
        clicked => { root.stepped("+1"); }
    }
    ReaderText {
        x: parent.width - root.value-width; y: 0px; width: root.value-width; height: parent.height;
        text: root.available ? "" + root.value : Strings.read-unavailable;
        font-size: root.available && Theme.scribe ? 20px : 16px;
        font-weight: root.available ? 700 : 400;
        color: root.available ? Theme.ink : Theme.secondary;
        horizontal-alignment: right;
    }
}

component ReaderFrontlight inherits ReaderBottomPanel {
    callback close();
    property <length> inset: Theme.scribe ? 48px : 16px;
    property <length> header-height: Theme.scribe ? 72px : 56px;
    property <length> value-width: ReaderModel.brightness-available && ReaderModel.warmth-available ? (Theme.scribe ? 36px : 28px) : 52px;
    height: Theme.scribe ? 256px : 212px;

    ReaderSheetHeader {
        x: root.inset; y: 2px; width: parent.width - 2 * root.inset; height: root.header-height;
        title: Strings.read-frontlight;
        close => { root.close(); }
    }
    brightness := ReaderLightRow {
        x: root.inset; y: root.header-height + 2px; width: parent.width - 2 * root.inset;
        label: Strings.read-brightness;
        value: ReaderModel.brightness; available: ReaderModel.brightness-available; busy: ReaderModel.light-busy;
        value-width: root.value-width;
        stepped(value) => { ReaderModel.action("brightness", value); }
    }
    ReaderLightRow {
        x: root.inset; y: brightness.y + brightness.height; width: parent.width - 2 * root.inset;
        label: Strings.read-warmth;
        value: ReaderModel.warmth; available: ReaderModel.warmth-available; busy: ReaderModel.light-busy;
        value-width: root.value-width;
        stepped(value) => { ReaderModel.action("warmth", value); }
    }
}

component ReaderMenuBar inherits Rectangle {
    property <bool> downloaded: ReaderModel.download-state == "downloaded";
    property <bool> queued: ReaderModel.download-state == "queued";
    property <length> right-inset: Theme.scribe ? 24px : 12px;
    height: Theme.status-height + Theme.header-height;
    background: Theme.paper;
    TouchArea { clicked => { } }
    StatusBar {
        x: 0px; y: 0px; width: parent.width;
        edge: Theme.scribe ? 48px : 16px;
        clock: ReaderModel.clock;
        online: ReaderModel.connected;
        network: ReaderModel.offline ? Strings.read-offline : ReaderModel.network-label;
        battery: ReaderModel.battery-label;
    }
    back-button := NavigationButton {
        x: Theme.scribe ? 32px : 8px;
        y: Theme.status-height + (Theme.header-height - 2px - self.height) / 2;
        text: ReaderModel.return-label != "" ? ReaderModel.return-label : Strings.read-shelf;
        icon: "back"; icon-size: Theme.scribe ? 28px : 24px;
        horizontal-padding: Theme.scribe ? 8px : 4px; icon-spacing: Theme.scribe ? 4px : 2px;
        height: Theme.scribe ? 56px : 48px;
        text-size: Theme.scribe ? 20px : 16px; text-weight: 400;
        clicked => { ReaderModel.action("back", ""); }
    }
    ReaderText {
        x: back-button.x + back-button.width + 8px; y: Theme.status-height;
        width: max(0px, download-button.x - self.x - 8px); height: Theme.header-height - 2px;
        text: ReaderModel.comic-title == "" ? ReaderModel.episode-title : ReaderModel.comic-title + (ReaderModel.episode-title == "" ? "" : " · " + ReaderModel.episode-title);
        font-size: Theme.scribe ? 20px : 16px; font-weight: 700; overflow: elide;
    }
    download-button := NavigationButton {
        x: parent.width - root.right-inset - self.width;
        y: Theme.status-height + (Theme.header-height - 2px - self.height) / 2;
        visible: !root.downloaded && !root.queued;
        enabled: ReaderModel.download-state == "";
        text: Strings.read-download-episode;
        icon: "download"; icon-size: Theme.scribe ? 22px : 18px;
        outlined: true; horizontal-padding: Theme.scribe ? 14px : 10px; icon-spacing: 4px;
        height: Theme.scribe ? 52px : 44px;
        text-size: Theme.scribe ? 18px : 15px; text-weight: 700;
        clicked => { ReaderModel.action("download", ""); }
    }
    if root.downloaded || root.queued: Rectangle {
        x: download-button.x; y: Theme.status-height;
        width: download-button.width; height: Theme.header-height - 2px;
        caption := ReaderText {
            x: 0px; y: 0px; width: parent.width - (Theme.scribe ? 12px : 8px); height: parent.height;
            text: root.downloaded ? Strings.read-downloaded : Strings.read-download-queued;
            color: root.downloaded ? Theme.secondary : Theme.ink;
            font-weight: root.queued ? 700 : 400;
            horizontal-alignment: right;
        }
        if root.downloaded: Icon {
            x: caption.width - caption.preferred-width - self.width - 4px; y: (parent.height - self.height) / 2;
            width: Theme.scribe ? 22px : 18px; height: self.width;
            kind: "check"; colorize: Theme.secondary;
        }
    }
    Rectangle { x: 0px; y: parent.height - 2px; width: parent.width; height: 2px; background: Theme.ink; }
}

component ReaderControls inherits Rectangle {
    in property <string> progress;
    property <bool> rtl: ReaderModel.direction == "rtl";
    property <bool> strip: ReaderModel.mode == "strip";
    property <length> inset: Theme.scribe ? 48px : 16px;
    property <length> seek-gap: Theme.scribe ? 16px : 10px;
    property <length> tool-gap: 8px;
    property <length> tool-width: (root.width - 2 * root.inset - 3 * root.tool-gap) / 4;
    height: Theme.scribe ? 160px : 132px;
    background: Theme.paper;
    TouchArea { clicked => { } }
    Rectangle { x: 0px; y: 0px; width: parent.width; height: 2px; background: Theme.ink; }
    Rectangle {
        x: root.inset; y: Theme.scribe ? 10px : 8px;
        width: parent.width - 2 * root.inset; height: Theme.scribe ? 56px : 48px;
        property <length> progress-width: max(Theme.scribe ? 72px : 58px, max(progress-metrics.preferred-width, seek-metrics.preferred-width));
        // Measure committed and maximum preview progress separately so dragging never resizes the track.
        progress-metrics := ReaderText { visible: false; text: root.progress; font-weight: 700; }
        seek-metrics := ReaderText {
            visible: false;
            text: (root.strip ? Strings.read-page-prefix : "") + ReaderModel.seek-count + " / " + ReaderModel.seek-count + (root.strip ? Strings.read-screen-suffix : "");
            font-weight: 700;
        }
        beginning-button := NavigationButton {
            x: root.rtl ? parent.width - self.width : 0px; y: 0px;
            height: parent.height;
            visible: ReaderModel.seek-index > 1 || (ReaderModel.mode == "panel" && ReaderModel.panel-index > 1) || ReaderModel.transition;
            text: Strings.read-beginning;
            icon: root.rtl ? "next" : "back"; trailing: root.rtl;
            icon-size: Theme.scribe ? 24px : 20px;
            horizontal-padding: Theme.scribe ? 6px : 3px; icon-spacing: 2px;
            text-size: Theme.scribe ? 18px : 15px; text-weight: 400;
            clicked => { ReaderModel.menu = false; ReaderModel.sheet = ""; ReaderModel.action("beginning", ""); }
        }
        seek-control := ReaderSeek {
            x: (root.rtl ? parent.progress-width : beginning-button.width) + root.seek-gap;
            y: 0px;
            width: max(0px, parent.width - beginning-button.width - parent.progress-width - 2 * root.seek-gap);
            height: parent.height;
            rtl: root.rtl;
            value: ReaderModel.seek-index; count: ReaderModel.seek-count;
            label: Strings.read-seek;
            picked(value) => { ReaderModel.menu = false; ReaderModel.sheet = ""; ReaderModel.action("seek", "" + value); }
        }
        ReaderText {
            x: root.rtl ? 0px : parent.width - self.width; y: 0px;
            width: parent.progress-width; height: parent.height;
            text: seek-control.dragging ? (root.strip ? Strings.read-page-prefix : "") + seek-control.preview + " / " + ReaderModel.seek-count + (root.strip ? Strings.read-screen-suffix : "") : root.progress;
            font-weight: 700; horizontal-alignment: root.rtl ? left : right;
        }
    }
    for tool[index] in [
        {id: "toc", label: Strings.read-toc, icon: "reader-list"},
        {id: "display", label: Strings.read-settings, icon: "reader-display"},
        {id: "refresh", label: Strings.read-refresh-short, icon: "reader-refresh"},
        {id: "light", label: Strings.read-frontlight, icon: "light"}
    ]: ReaderTool {
        x: root.inset + index * (root.tool-width + root.tool-gap);
        y: Theme.scribe ? 76px : 64px;
        width: root.tool-width; height: Theme.scribe ? 80px : 66px;
        icon: tool.icon; label: tool.label;
        clicked => {
            if tool.id == "refresh" {
                ReaderModel.menu = false;
                ReaderModel.sheet = "";
                ReaderModel.action("refresh", "");
            } else {
                ReaderModel.sheet = tool.id;
                ReaderModel.action("sheet", tool.id);
            }
        }
    }
}

component ReaderSpreadPage inherits Rectangle {
    in property <image> picture;
    in property <int> number;
    background: Theme.paper;
    if root.number >= 1 && root.number <= ReaderModel.page-count: Image {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        source: root.picture;
        image-fit: contain;
        image-rendering: (ReaderModel.presented-fast-mode || ReaderModel.presented-cpu-dither) ? pixelated : smooth;
    }
}

export component ReaderScreen inherits Rectangle {
    background: Theme.paper;
    clip: true;
    property <bool> spread: ReaderModel.spread-active;
    property <bool> show-content: !ReaderModel.transition && !ReaderModel.failed && (!ReaderModel.loading || ReaderModel.retain-page);
    property <length> reader-button: Theme.scribe ? 56px : 48px;
    property <int> guide-dash-count: ceil(root.height / 14px);
    property <string> progress: root.spread && ReaderModel.spread-label != "" ? ReaderModel.spread-label : ReaderModel.progress-label != "" ? ReaderModel.progress-label : ReaderModel.mode == "strip" ? Strings.read-page-prefix + ReaderModel.strip-screen + " / " + ReaderModel.strip-count + Strings.read-screen-suffix : ReaderModel.mode == "panel" ? min(ReaderModel.page-index, ReaderModel.page-count) + " / " + ReaderModel.page-count + " · " + Strings.read-panel-prefix + ReaderModel.panel-index : min(ReaderModel.page-index, ReaderModel.page-count) + " / " + ReaderModel.page-count;

    // Menu and sheet overlays never change the reading canvas or its image geometry.
    if root.show-content && !root.spread && ReaderModel.mode == "page": Image {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        source: ReaderModel.page;
        image-fit: contain;
        image-rendering: (ReaderModel.presented-fast-mode || ReaderModel.presented-cpu-dither) ? pixelated : smooth;
    }

    if root.show-content && !root.spread && ReaderModel.mode == "panel": Image {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        source: ReaderModel.page;
        image-fit: contain;
        image-rendering: (ReaderModel.presented-fast-mode || ReaderModel.presented-cpu-dither) ? pixelated : smooth;
    }

    if root.show-content && !root.spread && ReaderModel.mode == "strip": Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        clip: true;
        Image { width: parent.width; height: parent.height; source: ReaderModel.page; image-fit: contain; image-rendering: (ReaderModel.presented-fast-mode || ReaderModel.presented-cpu-dither) ? pixelated : smooth; }
    }

    if root.show-content && root.spread: Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: Theme.paper;
        property <length> frame-width: root.width / 2;
        ReaderSpreadPage { x: 0px; y: 0px; width: parent.frame-width; height: root.height; picture: ReaderModel.page; number: ReaderModel.left-page-index; }
        ReaderSpreadPage { x: parent.frame-width; y: 0px; width: parent.frame-width; height: root.height; picture: ReaderModel.second-page; number: ReaderModel.right-page-index; }
    }

    if (ReaderModel.loading && !ReaderModel.retain-page) || ReaderModel.failed: Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: Theme.paper;
        VerticalLayout {
            padding-left: 20px;
            padding-right: 20px;
            spacing: 12px;
            Rectangle { vertical-stretch: 1; }
            ReaderText { text: ReaderModel.failed ? Strings.read-failed : Strings.read-loading; font-size: Theme.scribe ? 24px : 20px; font-weight: 700; horizontal-alignment: center; height: 34px; }
            ReaderText { text: ReaderModel.failed ? ReaderModel.error-message : Strings.read-page-prefix + ReaderModel.page-index + " / " + ReaderModel.page-count + Strings.read-loading-suffix; color: Theme.secondary; horizontal-alignment: center; wrap: word-wrap; height: Theme.scribe ? 60px : 52px; }
            if ReaderModel.loading: ReaderText { text: Strings.read-caching-background; font-size: Theme.scribe ? 16px : 14px; color: Theme.secondary; horizontal-alignment: center; height: 28px; }
            if ReaderModel.failed: HorizontalLayout {
                height: root.reader-button;
                spacing: 12px;
                Rectangle { horizontal-stretch: 1; }
                ActionButton { text: Strings.read-back; clicked => { ReaderModel.action("back", ""); } }
                ActionButton { text: ReaderModel.retry-label != "" ? ReaderModel.retry-label : Strings.read-retry; primary: true; clicked => { ReaderModel.action("retry", ""); } }
                Rectangle { horizontal-stretch: 1; }
            }
            Rectangle { vertical-stretch: 1; }
        }
    }

    if ReaderModel.preparing-feedback && root.show-content && !ReaderModel.menu: Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: Theme.scribe ? 300px : 252px;
        height: Theme.scribe ? 64px : 56px;
        background: Theme.paper;
        border-width: 1px;
        border-color: Theme.ink;
        ReaderText { text: Strings.read-loading; horizontal-alignment: center; font-size: Theme.scribe ? 22px : 18px; }
    }

    if !ReaderModel.menu && !ReaderModel.guidance && !ReaderModel.failed: Rectangle {
        background: transparent;
        ReaderTapZone { x: 0px; y: 0px; width: parent.width * 0.3; height: parent.height; intent: ReaderModel.direction == "rtl" ? "next" : "previous"; label: ReaderModel.direction == "rtl" ? (root.spread ? Strings.read-next-pair : Strings.read-next-page) : (root.spread ? Strings.read-previous-pair : Strings.read-previous-page); }
        ReaderTapZone { x: parent.width * 0.3; y: 0px; width: parent.width * 0.4; height: parent.height; intent: "menu"; label: Strings.read-open-menu; }
        ReaderTapZone { x: parent.width * 0.7; y: 0px; width: parent.width * 0.3; height: parent.height; intent: ReaderModel.direction == "rtl" ? "previous" : "next"; label: ReaderModel.direction == "rtl" ? (root.spread ? Strings.read-previous-pair : Strings.read-previous-page) : (root.spread ? Strings.read-next-pair : Strings.read-next-page); }
    }

    if ReaderModel.transition && !ReaderModel.menu: transition-page := Rectangle {
        background: Theme.paper;
        property <bool> compact: root.height < (Theme.scribe ? 1100px : 760px);
        property <bool> very-compact: root.height < (Theme.scribe ? 850px : 680px);
        property <length> inset: Theme.scribe ? 56px : 28px;
        property <length> gap: self.very-compact ? 12px : Theme.scribe ? 24px : 16px;
        property <length> pad-top: Theme.scribe ? 40px : 24px;
        property <length> pad-bottom: Theme.scribe ? 48px : 28px;
        property <length> title-margin: self.very-compact ? 8px : self.compact ? (Theme.scribe ? 64px : 12px) : Theme.scribe ? 120px : 48px;
        property <length> end-size: self.very-compact ? (Theme.scribe ? 80px : 60px) : Theme.scribe ? 120px : 88px;
        VerticalLayout {
            x: transition-page.inset; y: transition-page.pad-top;
            width: parent.width - 2 * transition-page.inset;
            height: parent.height - transition-page.pad-top - transition-page.pad-bottom;
            spacing: transition-page.gap;
            Rectangle {
                height: summary-left.preferred-height; vertical-stretch: 0;
                summary-left := ReaderText { x: 0px; y: 0px; width: parent.width * 0.6; height: parent.height; text: ReaderModel.comic-title; font-size: Theme.scribe ? 16px : 14px; color: Theme.secondary; overflow: elide; }
                ReaderText { x: parent.width * 0.6; y: 0px; width: parent.width * 0.4; height: parent.height; text: Strings.read-chapter-end + " · " + ReaderModel.page-count + " / " + ReaderModel.page-count + " " + Strings.read-after; horizontal-alignment: right; font-size: Theme.scribe ? 16px : 14px; color: Theme.secondary; }
            }
            Rectangle {
                height: transition-page.title-margin + ended-episode.preferred-height + 6px + transition-page.end-size * 1.1;
                vertical-stretch: 0;
                ended-episode := ReaderText { x: 0px; y: transition-page.title-margin; width: parent.width; height: self.preferred-height; text: ReaderModel.transition-episode-title; color: Theme.secondary; }
                Text { x: 0px; y: ended-episode.y + ended-episode.height + 6px; width: parent.width; height: transition-page.end-size * 1.1; text: Strings.read-end; color: Theme.ink; font-family: Theme.serif-font; font-size: transition-page.end-size; font-weight: 700; vertical-alignment: center; }
            }
            Rectangle {
                height: next-note.y + next-note.preferred-height;
                vertical-stretch: 0;
                Rectangle { x: 0px; y: 0px; height: 2px; width: parent.width; background: Theme.ink; }
                next-caption := ReaderText { x: 0px; y: transition-page.gap + 2px; width: parent.width; height: self.preferred-height; text: Strings.read-next-episode; font-size: Theme.scribe ? 16px : 14px; color: Theme.secondary; }
                next-heading := ReaderText { x: 0px; y: next-caption.y + next-caption.height + 6px; width: parent.width; height: self.preferred-height; text: ReaderModel.next-title; font-size: Theme.scribe ? 30px : 22px; font-weight: 700; overflow: elide; }
                next-note := ReaderText { x: 0px; y: next-heading.y + next-heading.height + 6px; width: parent.width; height: self.preferred-height; text: ReaderModel.next-note; color: Theme.secondary; }
            }
            if ReaderModel.next-locked: Rectangle {
                height: price-amount.y + price-amount.preferred-height + 18px;
                vertical-stretch: 0;
                background: Theme.paper; border-width: 2px; border-color: Theme.ink;
                price-caption := ReaderText { x: 20px; y: 18px; width: parent.width * 0.5 - 40px; height: self.preferred-height; text: Strings.read-episode-price; font-size: Theme.scribe ? 16px : 14px; color: Theme.secondary; }
                price-amount := ReaderText { x: 20px; y: price-caption.y + price-caption.height + 2px; width: parent.width * 0.5 - 40px; height: self.preferred-height; text: ReaderModel.next-price; font-size: Theme.scribe ? 30px : 22px; font-weight: 700; }
                Rectangle {
                    x: parent.width * 0.5; y: (parent.height - self.height) / 2; width: parent.width * 0.5 - 20px;
                    height: wallet-note.preferred-height + coupon-note.preferred-height + 2px;
                    wallet-note := ReaderText { x: 0px; y: 0px; width: parent.width; height: self.preferred-height; text: Strings.read-wallet + " " + ReaderModel.wallet-label; horizontal-alignment: right; font-size: Theme.scribe ? 16px : 14px; color: Theme.secondary; }
                    coupon-note := ReaderText { x: 0px; y: wallet-note.height + 2px; width: parent.width; height: self.preferred-height; text: Strings.read-coupon + " " + ReaderModel.coupon-label; horizontal-alignment: right; font-size: Theme.scribe ? 16px : 14px; color: Theme.secondary; }
                }
            }
            if ReaderModel.next-locked: ActionButton {
                height: Theme.scribe ? 68px : 56px; vertical-stretch: 0;
                text: Strings.read-confirm-purchase; text-size: Theme.scribe ? 20px : 17px;
                primary: true; enabled: ReaderModel.next-available;
                clicked => { ReaderModel.action("purchase", ""); }
            }
            if !ReaderModel.next-locked: NavigationButton {
                width: parent.width; height: Theme.scribe ? 68px : 56px; vertical-stretch: 0;
                text: ReaderModel.continue-label; text-size: Theme.scribe ? 20px : 17px;
                icon: "next"; icon-size: Theme.scribe ? 20px : 17px; trailing: true;
                icon-spacing: (Theme.scribe ? 20px : 17px) * 0.15;
                primary: true; enabled: ReaderModel.next-available;
                clicked => { ReaderModel.action("next", ""); }
            }
            ReaderText {
                height: self.preferred-height; vertical-stretch: 0;
                text: !ReaderModel.next-available ? ReaderModel.next-note : ReaderModel.next-locked ? Strings.read-purchase-note : Strings.read-continue-gesture;
                font-size: Theme.scribe ? 16px : 14px; color: Theme.secondary; wrap: word-wrap; vertical-alignment: top;
            }
            Rectangle { min-height: 0px; vertical-stretch: 1; }
            HorizontalLayout {
                height: Theme.scribe ? 60px : 52px; vertical-stretch: 0;
                spacing: 10px;
                NavigationButton { text: Strings.read-return-last; icon: "back"; icon-size: Theme.scribe ? 18px : 15px; icon-spacing: (Theme.scribe ? 18px : 15px) * 0.15; height: parent.height; width: (parent.width - 20px) / 3; outlined: true; text-size: Theme.scribe ? 18px : 15px; clicked => { ReaderModel.action("last-view", ""); } }
                ActionButton { text: Strings.read-chapter-catalog; height: parent.height; horizontal-stretch: 1; text-size: Theme.scribe ? 18px : 15px; clicked => { ReaderModel.menu = true; ReaderModel.sheet = "toc"; ReaderModel.action("sheet", "toc"); } }
                ActionButton { text: Strings.read-return-shelf; height: parent.height; horizontal-stretch: 1; text-size: Theme.scribe ? 18px : 15px; clicked => { ReaderModel.action("shelf", ""); } }
            }
        }
    }
    // The full-screen chapter directory is hosted by AppWindow.
    if ReaderModel.menu && ReaderModel.sheet != "toc": Rectangle {
        background: transparent;
        TouchArea {
            accessible-role: button;
            accessible-label: Strings.read-close-menu;
            accessible-action-default => { ReaderModel.menu = false; ReaderModel.sheet = ""; ReaderModel.action("menu", "close"); }
            clicked => { ReaderModel.menu = false; ReaderModel.sheet = ""; ReaderModel.action("menu", "close"); }
        }
        ReaderMenuBar { x: 0px; y: 0px; width: parent.width; }
        if ReaderModel.sheet == "": ReaderControls {
            x: 0px; y: parent.height - self.height; width: parent.width;
            progress: root.progress;
        }
        if ReaderModel.sheet == "display": ReaderSettings {
            x: 0px; y: parent.height - self.height; width: parent.width;
            height: min(Theme.scribe ? 610px : 376px, parent.height - Theme.status-height - Theme.header-height - 16px);
            close => { ReaderModel.sheet = ""; ReaderModel.action("sheet", ""); }
        }
        if ReaderModel.sheet == "light": ReaderFrontlight {
            x: 0px; y: parent.height - self.height; width: parent.width;
            close => { ReaderModel.sheet = ""; ReaderModel.action("sheet", ""); }
        }
    }

    if ReaderModel.guidance && !ReaderModel.menu: Rectangle {
        background: Theme.paper;
        ReaderText { x: 12px; y: root.height * 0.18; width: root.width - 24px; height: 30px; text: ReaderModel.zoom-available ? Strings.read-hint-gesture-zoom : Strings.read-hint-gesture; color: Theme.secondary; horizontal-alignment: center; }
        ReaderText { x: 24px; y: root.height * 0.18 + 40px; width: root.width - 48px; height: 44px; text: Strings.read-hint-progress; font-size: Theme.scribe ? 16px : 14px; color: Theme.secondary; horizontal-alignment: center; wrap: word-wrap; }
        for index in 3: Rectangle {
            x: index == 0 ? 0px : index == 1 ? root.width * 0.3 : root.width * 0.7;
            width: root.width * (index == 1 ? 0.4 : 0.3);
            height: root.height;
            background: transparent;
            ReaderText { y: parent.height / 2 - 32px; height: 34px; text: index == 1 ? Strings.read-hint-menu : (index == 0) != (ReaderModel.direction == "rtl") ? Strings.read-previous-page : Strings.read-next-page; font-size: Theme.scribe ? 24px : 20px; font-weight: 700; horizontal-alignment: center; }
            ReaderText { y: parent.height / 2 + 12px; height: 28px; text: index == 0 ? Strings.read-hint-left : index == 1 ? Strings.read-hint-center : Strings.read-hint-right; font-size: Theme.scribe ? 16px : 14px; color: Theme.secondary; horizontal-alignment: center; }
        }
        for index in root.guide-dash-count: Rectangle { x: root.width * 0.3 - 1px; y: index * 14px; width: 2px; height: 8px; background: Theme.ink; }
        for index in root.guide-dash-count: Rectangle { x: root.width * 0.7 - 1px; y: index * 14px; width: 2px; height: 8px; background: Theme.ink; }
        Rectangle { x: (root.width - self.width) / 2; y: root.height * 0.88 - self.height; width: start-label.preferred-width + 44px; height: 50px; background: Theme.ink; start-label := ReaderText { x: 22px; width: parent.width - 44px; text: Strings.read-hint-start; font-size: Theme.scribe ? 20px : 17px; font-weight: 500; color: Theme.paper; horizontal-alignment: center; } }
        TouchArea {
            accessible-role: button;
            accessible-label: Strings.read-hint-dismiss;
            accessible-action-default => { ReaderModel.guidance = false; ReaderModel.action("guidance", "dismiss"); }
            clicked => { ReaderModel.guidance = false; ReaderModel.action("guidance", "dismiss"); }
        }
    }
}
