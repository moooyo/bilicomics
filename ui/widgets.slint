import { Theme } from "theme.slint";
import { Strings } from "strings.slint";

export component Icon inherits Image {
    in property <string> kind;
    in property <bool> inverted: false;
    in property <bool> enabled: true;
    width: 24px;
    height: 24px;
    image-fit: contain;
    colorize: !root.enabled ? Theme.muted : root.inverted ? Theme.paper : Theme.ink;
    accessible-role: none;
    source: root.kind == "shelf-active" ? @image-url("../assets/icons/shelf-active.svg") :
        root.kind == "store-active" ? @image-url("../assets/icons/store-active.svg") :
        root.kind == "download-active" ? @image-url("../assets/icons/download-active.svg") :
        root.kind == "account-active" ? @image-url("../assets/icons/account-active.svg") :
        root.kind == "shelf" ? @image-url("../assets/icons/shelf.svg") :
        root.kind == "store" ? @image-url("../assets/icons/store.svg") :
        root.kind == "download" ? @image-url("../assets/icons/download.svg") :
        root.kind == "user" ? @image-url("../assets/icons/user.svg") :
        root.kind == "account" ? @image-url("../assets/icons/account.svg") :
        root.kind == "search" ? @image-url("../assets/icons/search.svg") :
        root.kind == "filter" ? @image-url("../assets/icons/filter.svg") :
        root.kind == "grid" ? @image-url("../assets/icons/grid.svg") :
        root.kind == "list" ? @image-url("../assets/icons/list.svg") :
        root.kind == "back" ? @image-url("../assets/icons/back.svg") :
        root.kind == "next" ? @image-url("../assets/icons/next.svg") :
        root.kind == "close" ? @image-url("../assets/icons/close.svg") :
        root.kind == "check" ? @image-url("../assets/icons/check.svg") :
        root.kind == "refresh" ? @image-url("../assets/icons/refresh.svg") :
        root.kind == "sync" ? @image-url("../assets/icons/sync.svg") :
        root.kind == "display" ? @image-url("../assets/icons/display.svg") :
        root.kind == "picture" ? @image-url("../assets/icons/picture.svg") :
        root.kind == "light" ? @image-url("../assets/icons/light.svg") :
        root.kind == "wifi" ? @image-url("../assets/icons/wifi.svg") :
        root.kind == "battery" ? @image-url("../assets/icons/battery.svg") :
        root.kind == "more" ? @image-url("../assets/icons/more.svg") :
        root.kind == "bookmark" ? @image-url("../assets/icons/bookmark.svg") :
        root.kind == "settings" ? @image-url("../assets/icons/settings.svg") :
        root.kind == "phone" ? @image-url("../assets/icons/phone.svg") :
        root.kind == "warning" ? @image-url("../assets/icons/warning.svg") :
        root.kind == "wifi-off" ? @image-url("../assets/icons/wifi-off.svg") :
        root.kind == "qr-refresh" ? @image-url("../assets/icons/qr-refresh.svg") :
        root.kind == "reader-display" ? @image-url("../assets/icons/reader-display.svg") :
        root.kind == "reader-refresh" ? @image-url("../assets/icons/reader-refresh.svg") :
        root.kind == "reader-grid" ? @image-url("../assets/icons/reader-grid.svg") :
        root.kind == "reader-list" ? @image-url("../assets/icons/reader-list.svg") :
        root.kind == "wallet" ? @image-url("../assets/icons/wallet.svg") :
        root.kind == "trash" ? @image-url("../assets/icons/trash.svg") :
        @image-url("../assets/icons/book.svg");
}

component DashedRule inherits Rectangle {
    in property <color> stroke-color: Theme.line;
    in property <length> stroke: 1px;
    in property <bool> vertical: false;
    property <int> count: ceil((root.vertical ? root.height : root.width) / 8px);
    background: transparent;
    clip: true;
    for index in root.count: Rectangle {
        x: root.vertical ? 0px : index * 8px;
        y: root.vertical ? index * 8px : 0px;
        width: root.vertical ? root.stroke : 4px;
        height: root.vertical ? 4px : root.stroke;
        background: root.stroke-color;
    }
}

export component DashedOutline inherits Rectangle {
    in property <color> stroke-color: Theme.line;
    in property <length> stroke: 1px;
    in property <length> radius: 0px;
    background: transparent;
    clip: true;
    DashedRule { x: 0px; y: 0px; width: parent.width; height: root.stroke; stroke-color: root.stroke-color; stroke: root.stroke; }
    DashedRule { x: 0px; y: parent.height - root.stroke; width: parent.width; height: root.stroke; stroke-color: root.stroke-color; stroke: root.stroke; }
    DashedRule { x: 0px; y: 0px; width: root.stroke; height: parent.height; vertical: true; stroke-color: root.stroke-color; stroke: root.stroke; }
    DashedRule { x: parent.width - root.stroke; y: 0px; width: root.stroke; height: parent.height; vertical: true; stroke-color: root.stroke-color; stroke: root.stroke; }
}

export component SwipeTouchArea inherits TouchArea {
    callback tapped();
    callback swiped(int);
    property <length> start-x;
    property <length> start-y;
    property <bool> suppress-click;
    pointer-event(event) => {
        if event.kind == PointerEventKind.down {
            root.start-x = self.mouse-x;
            root.start-y = self.mouse-y;
            root.suppress-click = false;
        }
        if event.kind == PointerEventKind.up {
            if abs(self.mouse-x - root.start-x) >= 64px && abs(self.mouse-x - root.start-x) > abs(self.mouse-y - root.start-y) {
                root.suppress-click = true;
                root.swiped(self.mouse-x < root.start-x ? 1 : -1);
            } else if abs(self.mouse-y - root.start-y) >= 64px {
                root.suppress-click = true;
            }
        }
    }
    clicked => {
        if !root.suppress-click && abs(self.mouse-x - root.start-x) < 64px && abs(self.mouse-y - root.start-y) < 64px {
            root.tapped();
        }
    }
}

export component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> quiet: false;
    in property <bool> enabled: true;
    in property <bool> selected: false;
    in property <length> text-size: Theme.label-size;
    in property <int> text-weight: 500;
    callback clicked();
    property <bool> inverted: root.enabled && (root.primary || root.selected || touch.pressed);
    min-width: Theme.touch-size;
    preferred-width: max(Theme.touch-size, caption.preferred-width + 44px);
    height: Theme.button-height;
    border-width: root.quiet ? 0px : 2px;
    border-color: root.enabled ? Theme.ink : Theme.line;
    background: root.inverted ? Theme.ink : Theme.paper;
    forward-focus: keyboard;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    caption := Text {
        text: root.text;
        color: !root.enabled ? Theme.muted : root.inverted ? Theme.paper : Theme.ink;
        font-family: Theme.ui-font;
        font-size: root.text-size;
        font-weight: root.text-weight;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    if keyboard.has-focus && root.enabled: Rectangle {
        x: 6px; y: 6px; width: parent.width - 12px; height: parent.height - 12px;
        border-width: 2px; border-color: root.inverted ? Theme.paper : Theme.ink; background: transparent;
    }
    touch := TouchArea {
        enabled: root.enabled;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down { Theme.refresh("press"); }
            else if event.kind == PointerEventKind.up { Theme.refresh("release"); }
        }
        clicked => { root.clicked(); }
    }
    keyboard := FocusScope {
        x: 0px; width: 0px; enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" { root.clicked(); return accept; }
            return reject;
        }
    }
}

export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <string> label: root.text;
    in property <bool> enabled: true;
    in property <bool> selected: false;
    in property <length> icon-size: Theme.scribe ? 28px : 24px;
    in property <length> text-size: Theme.body-size;
    in property <string> feedback-down: "press";
    in property <string> feedback-up: "release";
    callback clicked();
    property <bool> inverted: root.enabled && (root.selected || touch.pressed);
    preferred-width: root.text == "" ? Theme.touch-size : max(Theme.touch-size, caption.preferred-width + root.icon-size + 24px);
    width: root.preferred-width;
    height: Theme.touch-size;
    background: root.inverted ? Theme.ink : Theme.paper;
    horizontal-stretch: 0;
    forward-focus: keyboard;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    HorizontalLayout {
        x: 0px; y: 0px; width: root.width; height: root.height;
        padding-left: root.text == "" ? 0px : 10px;
        padding-right: root.text == "" ? 0px : 10px;
        spacing: root.text == "" ? 0px : 4px;
        alignment: center;
        Rectangle {
            width: root.icon-size; height: parent.height;
            Icon {
                x: 0px; y: (parent.height - self.height) / 2;
                width: parent.width; height: self.width;
                kind: root.icon; inverted: root.inverted; enabled: root.enabled;
            }
        }
        caption := Text {
            text: root.text;
            max-width: root.text == "" ? 0px : 100000px;
            font-family: Theme.ui-font;
            font-size: root.text-size;
            font-weight: 500;
            color: !root.enabled ? Theme.muted : root.inverted ? Theme.paper : Theme.ink;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    if keyboard.has-focus && root.enabled: Rectangle {
        x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px;
        border-width: 2px; border-color: root.inverted ? Theme.paper : Theme.ink; background: transparent;
    }
    touch := TouchArea {
        enabled: root.enabled;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down { Theme.refresh(root.feedback-down); }
            else if event.kind == PointerEventKind.up { Theme.refresh(root.feedback-up); }
        }
        clicked => { root.clicked(); }
    }
    keyboard := FocusScope {
        x: 0px; width: 0px; enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" { root.clicked(); return accept; }
            return reject;
        }
    }
}

export component NavigationButton inherits Rectangle {
    in property <string> text;
    in property <string> label: root.text;
    in property <string> icon: "back";
    in property <bool> trailing: false;
    in property <bool> primary: false;
    in property <bool> outlined: false;
    in property <bool> enabled: true;
    in property <length> text-size: Theme.label-size;
    in property <length> icon-size: Theme.scribe ? 28px : 22px;
    in property <length> horizontal-padding: 12px;
    in property <length> icon-spacing: 6px;
    callback clicked();
    property <bool> inverted: root.enabled && (root.primary || touch.pressed);
    preferred-width: max(Theme.touch-size, caption.preferred-width + root.icon-size + 2 * root.horizontal-padding + root.icon-spacing);
    width: root.preferred-width;
    height: Theme.button-height;
    horizontal-stretch: 0;
    background: root.inverted ? Theme.ink : Theme.paper;
    border-width: root.outlined ? 2px : 0px;
    border-color: root.enabled ? Theme.ink : Theme.line;
    forward-focus: keyboard;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    HorizontalLayout {
        x: 0px; y: 0px; width: root.width; height: root.height;
        padding-left: root.horizontal-padding; padding-right: root.horizontal-padding; spacing: root.icon-spacing;
        alignment: center;
        if !root.trailing: Rectangle {
            width: root.icon-size; height: parent.height;
            Icon {
                x: 0px; y: (parent.height - self.height) / 2;
                width: parent.width; height: self.width;
                kind: root.icon; enabled: root.enabled; inverted: root.inverted;
            }
        }
        caption := Text {
            text: root.text;
            font-family: Theme.ui-font; font-size: root.text-size; font-weight: 500;
            color: !root.enabled ? Theme.muted : root.inverted ? Theme.paper : Theme.ink;
            vertical-alignment: center; overflow: elide;
        }
        if root.trailing: Rectangle {
            width: root.icon-size; height: parent.height;
            Icon {
                x: 0px; y: (parent.height - self.height) / 2;
                width: parent.width; height: self.width;
                kind: root.icon; enabled: root.enabled; inverted: root.inverted;
            }
        }
    }
    if keyboard.has-focus && root.enabled: Rectangle {
        x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px;
        border-width: 2px; border-color: root.inverted ? Theme.paper : Theme.ink; background: transparent;
    }
    touch := TouchArea {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        enabled: root.enabled;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down { Theme.refresh("press"); }
            else if event.kind == PointerEventKind.up { Theme.refresh("release"); }
        }
        clicked => { root.clicked(); }
    }
    keyboard := FocusScope {
        x: 0px; width: 0px; enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" { root.clicked(); return accept; }
            return reject;
        }
    }
}

export component PageHeader inherits Rectangle {
    in property <string> title;
    in property <length> title-size: Theme.body-size;
    in property <int> title-weight: 500;
    in property <string> back-text: Strings.common-back;
    in property <bool> more: false;
    in property <bool> separator: true;
    callback back();
    callback menu();
    x: 0px;
    y: 0px;
    height: Theme.header-height;
    background: Theme.paper;
    property <length> side-width: max(Theme.touch-size, back-button.preferred-width);
    HorizontalLayout {
        x: 0px; y: 0px; width: root.width; height: root.height;
        padding-left: Theme.scribe ? 32px : 8px;
        padding-right: Theme.scribe ? 32px : 8px;
        spacing: 8px;
        back-button := IconButton {
            width: root.side-width; height: Theme.header-height;
            icon: "back"; text: root.back-text;
            label: root.back-text == "" ? Strings.common-back : root.back-text;
            clicked => { root.back(); }
        }
        Text {
            text: root.title; color: Theme.ink; font-family: Theme.ui-font;
            font-size: root.title-size; font-weight: root.title-weight;
            vertical-alignment: center; horizontal-alignment: center; horizontal-stretch: 1;
            overflow: elide;
        }
        Rectangle {
            width: root.side-width;
            if root.more: IconButton {
                x: parent.width - Theme.touch-size; y: (parent.height - Theme.touch-size) / 2;
                icon: "more"; label: Strings.common-more;
                clicked => { root.menu(); }
            }
        }
    }
    if root.separator: Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.ink; }
}

export component PageBar inherits Rectangle {
    in property <int> page: 1;
    in property <int> count: 1;
    callback turn(int);
    callback jump();
    height: Theme.button-height;
    background: Theme.paper;
    HorizontalLayout {
        x: 0px; y: 0px; width: root.width; height: root.height;
        padding-left: Theme.margin;
        padding-right: Theme.margin;
        NavigationButton { text: Strings.common-previous; icon: "back"; enabled: root.page > 1; clicked => { root.turn(-1); } }
        Rectangle { horizontal-stretch: 1; }
        ActionButton { text: root.page + " / " + root.count; quiet: true; clicked => { root.jump(); } }
        Rectangle { horizontal-stretch: 1; }
        NavigationButton { text: Strings.common-next; icon: "next"; trailing: true; enabled: root.page < root.count; clicked => { root.turn(1); } }
    }
}

export component ProgressTrack inherits Rectangle {
    in property <float> value: 0;
    height: 4px;
    background: Theme.fill;
    Rectangle { x: 0px; y: 0px; width: parent.width * clamp(root.value, 0, 1); height: parent.height; background: Theme.ink; }
}

export component BookCover inherits Rectangle {
    in property <image> cover;
    in property <string> title;
    in property <string> badge;
    in property <float> progress: 0;
    background: Theme.fill;
    border-width: 1px;
    border-color: Theme.ink;
    clip: true;
    Text {
        x: 10px; y: 12px; width: parent.width - 20px; height: parent.height - 24px;
        text: root.title; font-family: Theme.serif-font;
        font-size: Theme.scribe ? 20px : 17px; font-weight: 700;
        color: Theme.ink; wrap: word-wrap;
        horizontal-alignment: center; vertical-alignment: center;
    }
    if root.cover.width > 0 && root.cover.height > 0: Image {
        x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
        source: root.cover; image-fit: ImageFit.cover;
    }
    if root.badge != "": Rectangle {
        x: 0px; y: 0px;
        width: min(parent.width, badge-label.preferred-width + 12px);
        height: Theme.scribe ? 28px : 24px;
        background: Theme.ink;
        badge-label := Text {
            x: 6px; y: 0px; width: parent.width - 12px; height: parent.height;
            text: root.badge; color: Theme.paper; font-family: Theme.ui-font;
            font-size: Theme.scribe ? 15px : 13px; font-weight: 500;
            vertical-alignment: center; overflow: elide;
        }
    }
    if root.progress > 0: ProgressTrack {
        x: 1px; y: parent.height - 4px; width: parent.width - 2px; height: 3px;
        value: root.progress;
    }
}

export component StatusBar inherits Rectangle {
    in property <string> clock;
    in property <string> network;
    in property <string> battery;
    in property <bool> online: false;
    in property <length> edge: Theme.margin;
    height: Theme.status-height;
    background: Theme.paper;
    HorizontalLayout {
        x: 0px; y: 0px; width: root.width; height: root.height;
        padding-left: root.edge;
        padding-right: root.edge;
        spacing: Theme.scribe ? 12px : 10px;
        Text { text: root.clock; font-family: Theme.ui-font; font-size: Theme.minimum-size; color: Theme.ink; vertical-alignment: center; }
        Rectangle { horizontal-stretch: 1; }
        if !root.online && root.network != "": Rectangle {
            width: network-label.preferred-width + (Theme.scribe ? 14px : 12px);
            height: parent.height;
            Rectangle {
                x: 0px; y: (parent.height - self.height) / 2;
                width: parent.width; height: min(parent.height - 2px, network-label.preferred-height + 2px);
                border-width: 1px; border-color: Theme.ink; background: Theme.paper;
                network-label := Text {
                    x: Theme.scribe ? 7px : 6px; y: 0px;
                    width: parent.width - (Theme.scribe ? 14px : 12px); height: parent.height;
                    text: root.network; font-family: Theme.ui-font; font-size: Theme.scribe ? 15px : 13px;
                    color: Theme.ink; vertical-alignment: center;
                }
            }
        }
        if root.online: Rectangle {
            width: Theme.scribe ? 18px : 16px; height: parent.height;
            Icon {
                x: 0px; y: (parent.height - self.height) / 2;
                kind: "wifi"; width: parent.width; height: self.width;
                accessible-label: root.network;
            }
        }
        Rectangle {
            width: Theme.scribe ? 28px : 24px; height: parent.height;
            Icon {
                x: 0px; y: (parent.height - self.height) / 2;
                kind: "battery"; width: parent.width; height: Theme.scribe ? 16px : 14px;
            }
        }
        Text { text: root.battery; font-family: Theme.ui-font; font-size: Theme.minimum-size; color: Theme.ink; vertical-alignment: center; }
    }
}

export component BottomNav inherits Rectangle {
    in property <string> active: "shelf";
    in property <int> pending: 0;
    callback change(string);
    height: Theme.nav-height;
    background: Theme.paper;
    Rectangle { x: 0px; y: 0px; width: parent.width; height: 2px; background: Theme.ink; }
    for tab[index] in ["shelf", "store", "downloads", "account"]: Rectangle {
        x: index * root.width / 4; y: 2px; width: root.width / 4; height: root.height - 2px;
        property <bool> current: root.active == tab || (tab == "account" && root.active == "me");
        property <string> caption: tab == "shelf" ? Strings.nav-shelf : tab == "store" ? Strings.nav-store : tab == "downloads" ? Strings.nav-downloads : Strings.nav-account;
        background: nav-touch.pressed ? Theme.ink : Theme.paper;
        forward-focus: nav-keyboard;
        accessible-role: button;
        accessible-label: self.caption;
        accessible-checkable: true;
        accessible-checked: self.current;
        accessible-action-default => { root.change(tab); }
        Icon {
            width: Theme.scribe ? 28px : 24px; height: self.width;
            x: (parent.width - self.width) / 2; y: Theme.scribe ? 10px : 7px;
            kind: tab == "downloads" ? (parent.current ? "download-active" : "download") : tab + (parent.current ? "-active" : "");
            inverted: nav-touch.pressed;
        }
        Text {
            x: 0px; y: Theme.scribe ? 42px : 33px; width: parent.width; height: Theme.scribe ? 26px : 22px;
            text: parent.caption; color: nav-touch.pressed ? Theme.paper : Theme.ink;
            font-family: Theme.ui-font; font-size: Theme.scribe ? 18px : 15px;
            font-weight: parent.current ? 700 : 400; horizontal-alignment: center; vertical-alignment: center;
        }
        if tab == "downloads" && root.pending > 0: Rectangle {
            x: parent.width * 0.58; y: Theme.scribe ? 6px : 3px;
            width: max(18px, pending-label.preferred-width + 10px); height: 18px;
            background: nav-touch.pressed ? Theme.paper : Theme.ink;
            pending-label := Text {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                text: root.pending; color: nav-touch.pressed ? Theme.ink : Theme.paper;
                font-family: Theme.ui-font; font-size: 12px; font-weight: 700;
                horizontal-alignment: center; vertical-alignment: center;
            }
        }
        if root.active == tab || (tab == "account" && root.active == "me"): Rectangle {
            x: parent.width * 0.22; y: parent.height - 5px; width: parent.width * 0.56; height: 5px;
            background: nav-touch.pressed ? Theme.paper : Theme.ink;
        }
        if nav-keyboard.has-focus: Rectangle {
            x: 5px; y: 5px; width: parent.width - 10px; height: parent.height - 10px;
            border-width: 2px; border-color: nav-touch.pressed ? Theme.paper : Theme.ink; background: transparent;
        }
        nav-touch := TouchArea {
            pointer-event(event) => {
                if event.kind == PointerEventKind.down { Theme.refresh("press"); }
                else if event.kind == PointerEventKind.up { Theme.refresh("release"); }
            }
            clicked => { root.change(tab); }
        }
        nav-keyboard := FocusScope {
            x: 0px; width: 0px;
            key-pressed(event) => {
                if event.text == " " || event.text == "\n" { root.change(tab); return accept; }
                return reject;
            }
        }
    }
}
