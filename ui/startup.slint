import { Strings } from "strings.slint";
import { Theme } from "theme.slint";
import { WaitingIndicator } from "widgets.slint";

component StartupText inherits Text {
    font-family: "BiliComics Startup";
    color: Theme.ink;
    horizontal-alignment: center;
    vertical-alignment: center;
}

export component StartupScreen inherits Rectangle {
    in property <int> frame: 0;
    in property <bool> failed: false;
    in property <bool> paused: false;
    callback exit();

    background: Theme.paper;
    property <length> gap: Theme.scribe ? 28px : 20px;
    property <length> brand-height: Theme.scribe ? 84px : 56px;
    property <length> status-height: root.failed ? (Theme.scribe ? 39px : 28px) : (Theme.scribe ? 34px : 25px);
    property <length> tail-height: root.failed ? Theme.button-height : (Theme.scribe ? 18px : 14px);

    Rectangle {
        x: 24px; y: (root.height - self.height) / 2;
        width: root.width - 48px;
        height: root.brand-height + root.status-height + root.tail-height + 2 * root.gap;
        StartupText {
            x: 0px; y: 0px; width: parent.width; height: root.brand-height;
            text: Strings.startup-app-name;
            font-size: Theme.scribe ? 60px : 40px;
            font-weight: 500;
        }
        StartupText {
            x: 0px; y: root.brand-height + root.gap; width: parent.width; height: root.status-height;
            text: root.failed ? Strings.startup-error-title : root.paused ? Strings.startup-suspended : Strings.startup-loading;
            font-size: root.failed ? (Theme.scribe ? 28px : 20px) : (Theme.scribe ? 24px : 18px);
            font-weight: root.failed ? 700 : 400;
        }
        if !root.failed: WaitingIndicator {
            x: (parent.width - self.width) / 2; y: parent.height - self.height;
            frame: root.paused ? -1 : root.frame;
            gap: Theme.scribe ? 14px : 10px;
        }
        if root.failed: Rectangle {
            x: (parent.width - self.width) / 2; y: parent.height - self.height;
            width: Theme.scribe ? 220px : 160px; height: root.tail-height;
            background: exit-touch.pressed ? Theme.paper : Theme.ink;
            border-width: 2px;
            border-color: Theme.ink;
            accessible-role: button;
            accessible-label: Strings.startup-exit;
            accessible-enabled: !root.paused;
            accessible-action-default => { if !root.paused { root.exit(); } }
            StartupText {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                text: Strings.startup-exit;
                font-size: Theme.scribe ? 22px : 17px;
                font-weight: 700;
                color: exit-touch.pressed ? Theme.ink : Theme.paper;
            }
            exit-touch := TouchArea {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                enabled: !root.paused;
                clicked => { root.exit(); }
            }
        }
    }
}
