import { Theme } from "theme.slint";
import { Strings } from "strings.slint";
import { ActionButton, BookCover, ChoiceTile, Icon, NavigationButton, WaitingIndicator } from "widgets.slint";

export struct PurchaseRangeItem {
    id: string,
    label: string,
    scope: string,
    price: string,
    original: string,
    enabled: bool,
}

export struct PurchaseIncludedItem {
    number: string,
    title: string,
    note: string,
}

export global PurchaseModel {
    callback action(string, string);
    in-out property <string> phase: "review";
    in-out property <string> back-label: Strings.handoff-back-detail;
    in-out property <string> comic-title;
    in-out property <string> start-label;
    in-out property <image> cover;
    in-out property <[PurchaseRangeItem]> ranges;
    in-out property <[PurchaseIncludedItem]> included;
    in-out property <string> included-label;
    in-out property <string> selected-range;
    in-out property <string> payment: "coin";
    in-out property <string> wallet-label: Strings.buy-wallet-unknown;
    in-out property <string> coupon-label: Strings.buy-coupon-unknown;
    in-out property <bool> coupons-allowed;
    in-out property <string> total: Strings.buy-unknown;
    in-out property <string> after-text;
    in-out property <string> pay-label: Strings.buy-confirm;
    in-out property <string> scope-label;
    in-out property <string> error-text;
    in-out property <bool> sufficient: true;
    in-out property <bool> quote-ready;
    in-out property <bool> quote-loading;
    in-out property <bool> reconciling;
    in-out property <string> result-title: Strings.buy-success-title;
    in-out property <string> result-body;
    in-out property <bool> result-can-read;
    in-out property <string> pending-summary;
    in-out property <string> pending-body: Strings.buy-pending-body;
}

component PurchaseText inherits Text {
    color: Theme.ink;
    font-family: Theme.ui-font;
}

component PurchaseSectionTitle inherits PurchaseText {
    height: Theme.scribe ? 28px : 22px;
    font-size: Theme.scribe ? 20px : 16px;
    font-weight: 700;
    vertical-alignment: center;
}

component PurchaseButton inherits ActionButton {
    text-size: Theme.scribe ? 20px : 17px;
    text-weight: root.primary ? 700 : 400;
}

component PurchasePriceTile inherits ChoiceTile {
    in property <PurchaseRangeItem> item;
    enabled: root.item.enabled;
    selected: root.item.id != "" && root.item.id == PurchaseModel.selected-range;
    accessible-label: root.item.label + " " + root.item.scope + " " + root.item.price;
    clicked => { PurchaseModel.action("range", root.item.id); }
    VerticalLayout {
        x: Theme.scribe ? 20px : 14px;
        y: 0px;
        width: parent.width - 2 * self.x;
        height: parent.height;
        alignment: center;
        PurchaseText {
            height: Theme.scribe ? 45px : 33px;
            min-width: 0px;
            text: root.item.label;
            color: root.enabled ? Theme.ink : Theme.secondary;
            font-size: Theme.scribe ? 36px : 26px;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
        }
        PurchaseText {
            height: Theme.scribe ? 25px : 21px;
            min-width: 0px;
            text: root.item.scope;
            color: root.enabled ? Theme.ink : Theme.secondary;
            font-size: Theme.scribe ? 17px : 14px;
            vertical-alignment: center;
            overflow: elide;
        }
        Rectangle { height: Theme.scribe ? 10px : 6px; }
        PurchaseText {
            height: Theme.scribe ? 32px : 24px;
            min-width: 0px;
            text: root.item.price;
            font-size: Theme.scribe ? 22px : 17px;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
        }
        Rectangle {
            height: Theme.scribe ? 25px : 20px;
            original := PurchaseText {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                text: root.item.original;
                color: Theme.secondary;
                font-size: Theme.scribe ? 17px : 14px;
                vertical-alignment: center;
                overflow: elide;
            }
            if root.item.original != "": Rectangle {
                x: 0px; y: parent.height / 2; width: min(parent.width, original.preferred-width); height: 1px;
                background: Theme.secondary;
            }
        }
    }
}

component PurchasePaymentTile inherits ChoiceTile {
    in property <string> title;
    in property <string> subtitle;
    accessible-label: root.title + " " + root.subtitle;
    VerticalLayout {
        x: Theme.scribe ? 20px : 14px;
        y: 0px;
        width: parent.width - 2 * self.x;
        height: parent.height;
        alignment: center;
        spacing: 2px;
        PurchaseText {
            height: Theme.scribe ? 31px : 24px;
            text: root.title;
            color: root.enabled ? Theme.ink : Theme.secondary;
            font-size: Theme.scribe ? 22px : 17px;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
        }
        PurchaseText {
            height: Theme.scribe ? 25px : 21px;
            text: root.subtitle;
            color: Theme.secondary;
            font-size: Theme.scribe ? 17px : 14px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

component PurchaseIncludedRow inherits Rectangle {
    in property <PurchaseIncludedItem> item;
    property <length> gap: Theme.scribe ? 10px : 6px;
    property <length> number-width: Theme.scribe ? 40px : 28px;
    height: Theme.scribe ? 60px : 44px;
    PurchaseText {
        x: 0px; y: 0px; width: root.number-width; height: parent.height;
        text: root.item.number;
        font-family: Theme.serif-font;
        font-size: Theme.scribe ? 20px : 16px;
        font-weight: 700;
        vertical-alignment: center;
        overflow: elide;
    }
    PurchaseText {
        x: root.number-width + root.gap; y: 0px;
        width: max(0px, parent.width - self.x - (root.item.note == "" ? 0px : note.width + root.gap));
        height: parent.height;
        text: root.item.title;
        font-size: Theme.scribe ? 20px : 16px;
        vertical-alignment: center;
        overflow: elide;
    }
    note := PurchaseText {
        x: parent.width - self.width; y: 0px;
        width: min(self.preferred-width, parent.width / 2); height: parent.height;
        text: root.item.note;
        color: Theme.secondary;
        font-size: Theme.scribe ? 17px : 14px;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
    }
    Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.line; }
}

component PurchaseReviewBody inherits Flickable {
    in property <length> inset;
    property <length> cover-width: Theme.scribe ? 62px : 47px;
    property <length> cover-height: Theme.scribe ? 82px : 62px;
    property <length> book-padding: Theme.scribe ? 24px : 14px;
    property <length> section-gap: Theme.scribe ? 28px : 16px;
    property <length> label-gap: Theme.scribe ? 10px : 6px;
    viewport-width: root.width;
    viewport-height: max(root.height, form.height);
    interactive: root.viewport-height > root.height;

    form := VerticalLayout {
        x: 0px; y: 0px; width: root.width; height: self.preferred-height;
        alignment: start;
        Rectangle {
            height: root.cover-height + 2 * root.book-padding + 1px;
            BookCover {
                x: root.inset; y: root.book-padding;
                width: root.cover-width; height: root.cover-height;
                cover: PurchaseModel.cover;
                title: PurchaseModel.comic-title;
            }
            VerticalLayout {
                x: root.inset + root.cover-width + root.book-padding;
                y: 0px;
                width: parent.width - self.x - root.inset;
                height: parent.height;
                alignment: center;
                spacing: 2px;
                PurchaseText {
                    height: Theme.scribe ? 40px : 29px;
                    text: PurchaseModel.comic-title;
                    font-family: Theme.serif-font;
                    font-size: Theme.scribe ? 28px : 20px;
                    font-weight: 700;
                    vertical-alignment: center;
                    overflow: elide;
                }
                PurchaseText {
                    height: Theme.scribe ? 28px : 23px;
                    text: PurchaseModel.start-label;
                    color: Theme.secondary;
                    font-size: Theme.scribe ? 20px : 16px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.ink; }
        }
        VerticalLayout {
            padding-left: root.inset;
            padding-right: root.inset;
            padding-top: root.section-gap;
            padding-bottom: root.section-gap;
            alignment: start;
            PurchaseSectionTitle { text: Strings.buy-scope; }
            Rectangle { height: root.label-gap; }
            range-grid := Rectangle {
                property <length> gap: Theme.scribe ? 20px : 12px;
                property <length> tile-height: Theme.scribe ? 156px : 124px;
                property <length> tile-width: (self.width - 2 * self.gap) / 3;
                property <int> rows: ceil(PurchaseModel.ranges.length / 3);
                height: self.rows * self.tile-height + max(0, self.rows - 1) * self.gap;
                for item[index] in PurchaseModel.ranges: PurchasePriceTile {
                    x: mod(index, 3) * (range-grid.tile-width + range-grid.gap);
                    y: floor(index / 3) * (range-grid.tile-height + range-grid.gap);
                    width: range-grid.tile-width;
                    height: range-grid.tile-height;
                    item: item;
                }
            }
            if PurchaseModel.quote-loading || PurchaseModel.error-text != "": Rectangle { height: root.label-gap; }
            if PurchaseModel.quote-loading || PurchaseModel.error-text != "": PurchaseText {
                height: self.preferred-height;
                text: PurchaseModel.quote-loading ? Strings.buy-loading-quote : PurchaseModel.error-text;
                font-size: Theme.scribe ? 17px : 14px;
                color: Theme.secondary;
                wrap: word-wrap;
            }
            if PurchaseModel.included.length > 0: Rectangle { height: root.section-gap; }
            if PurchaseModel.included.length > 0: PurchaseSectionTitle { text: PurchaseModel.included-label; }
            if PurchaseModel.included.length > 0: Rectangle { height: root.label-gap; }
            if PurchaseModel.included.length > 0: included-grid := Rectangle {
                property <length> gap: Theme.scribe ? 32px : 20px;
                property <length> row-height: Theme.scribe ? 60px : 44px;
                property <length> column-width: (self.width - self.gap) / 2;
                height: 1px + ceil(PurchaseModel.included.length / 2) * self.row-height;
                Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.line; }
                for item[index] in PurchaseModel.included: PurchaseIncludedRow {
                    x: mod(index, 2) * (included-grid.column-width + included-grid.gap);
                    y: 1px + floor(index / 2) * included-grid.row-height;
                    width: included-grid.column-width;
                    item: item;
                }
            }
        }
    }
}

component PurchasePayment inherits Rectangle {
    in property <length> inset;
    property <length> label-gap: Theme.scribe ? 10px : 6px;
    height: Theme.scribe ? 150px : 108px;
    PurchaseSectionTitle { x: root.inset; y: 0px; width: parent.width - 2 * self.x; text: Strings.buy-payment; }
    HorizontalLayout {
        x: root.inset; y: (Theme.scribe ? 28px : 22px) + root.label-gap;
        width: parent.width - 2 * self.x; height: Theme.scribe ? 84px : 64px;
        spacing: Theme.scribe ? 20px : 12px;
        PurchasePaymentTile {
            horizontal-stretch: 1;
            title: Strings.buy-coin;
            subtitle: PurchaseModel.wallet-label;
            selected: PurchaseModel.payment == "coin";
            clicked => { PurchaseModel.action("payment", "coin"); }
        }
        PurchasePaymentTile {
            horizontal-stretch: 1;
            title: Strings.buy-coupon;
            subtitle: PurchaseModel.coupon-label;
            selected: PurchaseModel.payment == "coupon";
            enabled: PurchaseModel.coupons-allowed;
            clicked => { PurchaseModel.action("payment", "coupon"); }
        }
    }
}

component PurchaseTotal inherits Rectangle {
    in property <length> inset;
    property <bool> coin-shortfall: !PurchaseModel.sufficient && PurchaseModel.payment == "coin";
    property <bool> needs-refresh: !PurchaseModel.quote-ready && !PurchaseModel.quote-loading;
    property <length> button-gap: Theme.scribe ? 24px : 14px;
    property <length> refresh-width: min(Theme.scribe ? 180px : 120px, (root.width - 2 * root.inset) * 0.27);
    property <length> primary-width: root.coin-shortfall
        ? min(Theme.scribe ? 200px : 140px, (root.width - 2 * root.inset) * 0.30)
        : min(Theme.scribe ? 280px : 180px, (root.width - 2 * root.inset) * 0.43);
    height: Theme.scribe ? 150px : 106px;
    Rectangle { x: 0px; y: 0px; width: parent.width; height: 2px; background: Theme.ink; }
    VerticalLayout {
        x: root.inset; y: Theme.scribe ? 22px : 13px;
        width: max(0px, parent.width - 2 * self.x - root.primary-width - root.button-gap
            - (root.coin-shortfall ? root.refresh-width + root.button-gap : 0px));
        height: self.preferred-height;
        alignment: start;
        PurchaseText {
            height: Theme.scribe ? 27px : 23px;
            text: Strings.buy-total;
            font-size: Theme.scribe ? 17px : 14px;
            color: Theme.secondary;
            vertical-alignment: center;
        }
        Rectangle { height: Theme.scribe ? 4px : 2px; }
        amount-label := PurchaseText {
            height: Theme.scribe ? 46px : 33px;
            text: PurchaseModel.total;
            font-size: Theme.scribe ? 34px : 26px;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
        }
        PurchaseText {
            height: Theme.scribe ? 28px : 23px;
            text: PurchaseModel.after-text;
            font-size: Theme.scribe ? 17px : 14px;
            font-weight: PurchaseModel.sufficient ? 400 : 700;
            color: PurchaseModel.sufficient ? Theme.secondary : Theme.ink;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    if root.coin-shortfall: PurchaseButton {
        x: parent.width - root.inset - root.primary-width - root.button-gap - self.width;
        y: (parent.height - self.height) / 2;
        width: root.refresh-width;
        text: Strings.buy-refresh-wallet;
        enabled: !PurchaseModel.quote-loading;
        clicked => { PurchaseModel.action("refresh-wallet", ""); }
    }
    PurchaseButton {
        x: parent.width - root.inset - self.width;
        y: (parent.height - self.height) / 2;
        width: root.primary-width;
        text: root.coin-shortfall ? Strings.buy-recharge : root.needs-refresh ? Strings.buy-refresh-quote : PurchaseModel.pay-label;
        primary: true;
        enabled: !PurchaseModel.quote-loading && (root.coin-shortfall || root.needs-refresh
            || (PurchaseModel.sufficient && PurchaseModel.quote-ready && amount-label.preferred-width <= amount-label.width));
        clicked => { PurchaseModel.action(root.coin-shortfall ? "recharge" : root.needs-refresh ? "refresh-quote" : "submit", ""); }
    }
}

component PurchasePendingActions inherits Rectangle {
    property <length> gap: Theme.scribe ? 16px : 10px;
    property <length> action-width: Theme.scribe ? (root.width - root.gap) / 2 : root.width;
    height: Theme.scribe ? Theme.button-height : 2 * Theme.button-height + root.gap;
    PurchaseButton {
        x: 0px; y: 0px; width: root.action-width;
        text: PurchaseModel.reconciling ? Strings.buy-reconciling : Strings.buy-reconcile;
        enabled: !PurchaseModel.reconciling;
        primary: true;
        clicked => { PurchaseModel.action("reconcile", ""); }
    }
    PurchaseButton {
        x: Theme.scribe ? root.action-width + root.gap : 0px;
        y: Theme.scribe ? 0px : Theme.button-height + root.gap;
        width: root.action-width;
        text: Strings.buy-close;
        enabled: !PurchaseModel.reconciling;
        clicked => { PurchaseModel.action("close", ""); }
    }
}

component PurchaseDoneActions inherits Rectangle {
    property <length> gap: Theme.scribe ? 16px : 10px;
    property <length> read-width: Theme.scribe ? (root.width - 2 * root.gap) * 200 / 520 : root.width;
    property <length> other-width: Theme.scribe ? (root.width - root.read-width - 2 * root.gap) / 2 : root.width;
    height: Theme.scribe ? Theme.button-height : 3 * Theme.button-height + 2 * root.gap;
    PurchaseButton {
        x: 0px; y: 0px; width: root.read-width;
        text: Strings.buy-read;
        enabled: PurchaseModel.result-can-read;
        primary: true;
        clicked => { PurchaseModel.action("read", ""); }
    }
    PurchaseButton {
        x: Theme.scribe ? root.read-width + root.gap : 0px;
        y: Theme.scribe ? 0px : Theme.button-height + root.gap;
        width: root.other-width;
        text: Strings.buy-download;
        enabled: PurchaseModel.result-can-read;
        clicked => { PurchaseModel.action("download", ""); }
    }
    PurchaseButton {
        x: Theme.scribe ? root.read-width + root.other-width + 2 * root.gap : 0px;
        y: Theme.scribe ? 0px : 2 * (Theme.button-height + root.gap);
        width: root.other-width;
        text: Strings.buy-detail;
        clicked => { PurchaseModel.action("detail", ""); }
    }
}

component PurchaseResult inherits Flickable {
    in property <length> inset;
    property <bool> submitting: PurchaseModel.phase == "submitting";
    property <bool> pending: PurchaseModel.phase == "pending";
    property <bool> done: PurchaseModel.phase == "done";
    property <length> gap: Theme.scribe ? 20px : 14px;
    viewport-width: root.width;
    viewport-height: max(root.height, result.height + 2 * root.gap);
    interactive: root.viewport-height > root.height;
    result := VerticalLayout {
        x: root.inset; y: (root.viewport-height - self.height) / 2;
        width: root.width - 2 * self.x;
        height: self.preferred-height;
        spacing: root.gap;
        alignment: start;
        if root.pending: Rectangle {
            height: Theme.scribe ? 34px : 29px;
            Rectangle {
                x: (parent.width - self.width) / 2; y: 0px;
                width: badge.preferred-width + 24px; height: parent.height;
                border-width: 2px; border-color: Theme.ink;
                badge := PurchaseText {
                    x: 0px; y: 0px; width: parent.width; height: parent.height;
                    text: Strings.buy-pending-badge;
                    font-size: Theme.scribe ? 18px : 15px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        if root.done && PurchaseModel.result-can-read: Rectangle {
            height: Theme.scribe ? 88px : 64px;
            Rectangle {
                x: (parent.width - self.width) / 2; y: 0px; width: parent.height; height: parent.height;
                border-width: 3px; border-color: Theme.ink;
                Icon {
                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                    width: Theme.scribe ? 48px : 36px; height: self.width;
                    kind: "check";
                }
            }
        }
        PurchaseText {
            height: self.preferred-height;
            text: root.submitting ? Strings.buy-submitting : root.pending ? Strings.buy-pending-title
                : PurchaseModel.result-can-read ? Strings.buy-unlocked + " · " + PurchaseModel.scope-label : PurchaseModel.result-title;
            font-size: Theme.scribe ? (root.submitting ? 28px : 30px) : (root.submitting ? 20px : 22px);
            font-weight: 700;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        if root.submitting: Rectangle {
            height: Theme.scribe ? 18px : 14px;
            WaitingIndicator { x: (parent.width - self.width) / 2; y: 0px; gap: Theme.scribe ? 14px : 10px; frame: 1; }
        }
        if root.pending && PurchaseModel.pending-summary != "": PurchaseText {
            height: self.preferred-height;
            text: PurchaseModel.pending-summary;
            color: Theme.secondary;
            font-size: Theme.scribe ? 20px : 16px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        if root.pending || PurchaseModel.result-body != "": PurchaseText {
            height: self.preferred-height;
            text: root.pending ? (PurchaseModel.error-text != "" ? PurchaseModel.error-text : PurchaseModel.pending-body) : PurchaseModel.result-body;
            color: Theme.secondary;
            font-size: Theme.scribe ? 17px : 14px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        if root.pending: Rectangle {
            height: pending-actions.height + 8px;
            pending-actions := PurchasePendingActions {
                x: (parent.width - self.width) / 2; y: 8px;
                width: min(parent.width, Theme.scribe ? 460px : 360px);
            }
        }
        if root.done: Rectangle {
            height: done-actions.height + (Theme.scribe ? 12px : 8px);
            done-actions := PurchaseDoneActions {
                x: (parent.width - self.width) / 2; y: Theme.scribe ? 12px : 8px;
                width: min(parent.width, Theme.scribe ? 552px : 360px);
            }
        }
    }
}

export component PurchaseScreen inherits Rectangle {
    background: Theme.paper;
    property <bool> done: PurchaseModel.phase == "done";
    property <bool> pending: PurchaseModel.phase == "pending";
    property <bool> reviewing: !root.done && !root.pending && PurchaseModel.phase != "submitting";
    property <length> inset: Theme.scribe ? 48px : 16px;
    header := Rectangle {
        x: 0px; y: 0px; width: parent.width; height: Theme.header-height;
        HorizontalLayout {
            x: Theme.scribe ? 32px : 8px; y: 0px; width: parent.width - self.x - root.inset; height: parent.height;
            spacing: Theme.scribe ? 12px : 8px;
            if root.reviewing || root.done: Rectangle {
                width: back.preferred-width;
                back := NavigationButton {
                    x: 0px; y: (parent.height - self.height) / 2;
                    height: Theme.scribe ? 56px : 48px;
                    icon: "back";
                    icon-size: Theme.scribe ? 28px : 24px;
                    icon-spacing: Theme.scribe ? 4px : 2px;
                    horizontal-padding: Theme.scribe ? 6px : 4px;
                    text-size: Theme.scribe ? 20px : 16px;
                    text: PurchaseModel.back-label;
                    clicked => { PurchaseModel.action("back", ""); }
                }
            }
            PurchaseText {
                horizontal-stretch: 1;
                text: root.done ? PurchaseModel.result-title : root.pending ? Strings.buy-result-title : Strings.buy-review-title;
                font-size: Theme.scribe ? 22px : 17px;
                font-weight: 700;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        Rectangle { x: 0px; y: parent.height - 2px; width: parent.width; height: 2px; background: Theme.ink; }
    }
    if root.reviewing: Rectangle {
        x: 0px; y: header.height; width: parent.width; height: max(0px, parent.height - self.y);
        PurchaseReviewBody {
            x: 0px; y: 0px; width: parent.width; height: max(0px, payment.y);
            inset: root.inset;
        }
        payment := PurchasePayment {
            x: 0px; y: total.y - self.height; width: parent.width;
            inset: root.inset;
        }
        total := PurchaseTotal {
            x: 0px; y: parent.height - self.height; width: parent.width;
            inset: root.inset;
        }
    }
    if !root.reviewing: PurchaseResult {
        x: 0px; y: header.height; width: parent.width; height: max(0px, parent.height - self.y);
        inset: root.inset;
    }
}
