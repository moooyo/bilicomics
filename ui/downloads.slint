import { Theme } from "theme.slint";
import { Strings } from "strings.slint";
import { ActionButton, IconButton, Icon, NavigationButton, PageBar } from "widgets.slint";

export struct DownloadItem {
    id: string,
    title: string,
    cover: image,
    status: string,
    subtitle: string,
    progress: float,
    error: bool,
    active: bool,
    has-bar: bool,
    selected: bool,
}
export struct DownloadChapterItem { id: string, number: string, title: string, size: string }

export global DownloadModel {
    callback action(string, string);
    in-out property <[DownloadItem]> items;
    in-out property <[DownloadChapterItem]> chapters;
    in-out property <bool> selecting: false;
    in-out property <bool> has-active: false;
    in-out property <bool> all-paused: false;
    in-out property <string> status-summary;
    in-out property <string> summary;
    in-out property <string> smart-label;
    in-out property <string> selection-label;
    in-out property <string> remove-label;
    in-out property <int> page: 1;
    in-out property <int> page-count: 1;
    in-out property <int> selected-count: 0;
    in-out property <bool> sheet-open: false;
    in-out property <string> sheet-id;
    in-out property <string> sheet-title;
    in-out property <string> sheet-summary;
    in-out property <image> sheet-cover;
    in-out property <int> chapter-page: 1;
    in-out property <int> chapter-page-count: 1;
    in-out property <bool> task-visible: false;
    in-out property <bool> task-has-bar: false;
    in-out property <string> task-title;
    in-out property <string> task-note;
    in-out property <string> task-primary;
    in-out property <bool> task-primary-enabled: true;
    in-out property <string> task-secondary;
    in-out property <string> task-primary-action;
    in-out property <string> task-secondary-action;
    in-out property <float> task-progress: 0;
    in-out property <bool> can-read: false;
    in-out property <string> remove-current-label;
    in-out property <string> remove-current-action;
}

component DownloadCover inherits Rectangle {
    in property <image> source;
    background: Theme.fill;
    border-width: 1px;
    border-color: Theme.ink;
    Image { x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px; source: root.source; image-fit: cover; }
}

component DownloadProgress inherits Rectangle {
    in property <float> progress;
    background: Theme.paper;
    border-width: 1.5px;
    border-color: Theme.ink;
    Rectangle {
        x: 1.5px; y: 1.5px;
        width: max(0px, parent.width - 3px) * clamp(root.progress, 0.0, 1.0);
        height: max(0px, parent.height - 3px);
        background: Theme.ink;
    }
}

component DownloadRow inherits Rectangle {
    in property <DownloadItem> item;
    property <length> edge: Theme.scribe ? 48px : 16px;
    property <length> gap: Theme.scribe ? 20px : 12px;
    property <length> status-width: Theme.scribe ? 230px : 96px;
    property <length> title-height: Theme.scribe ? 29px : 22px;
    property <length> subtitle-height: Theme.scribe ? 25px : 20px;
    property <length> text-gap: Theme.scribe ? 4px : 2px;
    property <length> bar-height: Theme.scribe ? 12px : 10px;
    property <length> bar-gap: root.text-gap + 4px;
    property <length> retry-height: Theme.scribe ? 56px : 44px;
    property <length> retry-width: Theme.scribe ? 80px : 62px;
    property <length> badge-height: Theme.scribe ? 31px : 23px;
    property <length> retry-top: Theme.scribe ? (root.height - 1px - root.retry-height) / 2
        : (root.height - 1px - root.badge-height - 6px - root.retry-height) / 2 + root.badge-height + 6px;
    background: row-touch.pressed || root.item.selected ? Theme.pale : Theme.paper;
    forward-focus: row-keyboard;
    accessible-role: button;
    accessible-label: root.item.title + " · " + (DownloadModel.selecting ? Strings.dl-select : root.item.status + " · " + Strings.dl-local-chapters);
    accessible-enabled: !DownloadModel.sheet-open;
    accessible-checkable: DownloadModel.selecting;
    accessible-checked: root.item.selected;
    accessible-action-default => { if !DownloadModel.sheet-open { root.activate(); } }
    function activate() { DownloadModel.action(DownloadModel.selecting ? "toggle-item" : "open", root.item.id); }

    cover := DownloadCover {
        x: root.edge; y: (parent.height - 1px - self.height) / 2;
        width: Theme.scribe ? 62px : 47px; height: Theme.scribe ? 82px : 62px;
        source: root.item.cover;
    }
    Rectangle {
        x: cover.x + cover.width + root.gap; y: (parent.height - 1px - self.height) / 2;
        width: max(0px, parent.width - self.x - root.edge - root.gap - root.status-width);
        height: root.title-height + root.text-gap + root.subtitle-height + (root.item.has-bar ? root.bar-gap + root.bar-height : 0px);
        Text {
            x: 0px; y: 0px; width: parent.width; height: root.title-height;
            text: root.item.title; font-size: Theme.scribe ? 20px : 16px; font-weight: 700;
            color: Theme.ink; font-family: Theme.ui-font; vertical-alignment: center; overflow: elide;
        }
        Text {
            x: 0px; y: root.title-height + root.text-gap; width: parent.width; height: root.subtitle-height;
            text: root.item.subtitle; font-size: Theme.scribe ? 17px : 14px;
            color: Theme.secondary; font-family: Theme.ui-font; vertical-alignment: center; overflow: elide;
        }
        if root.item.has-bar: DownloadProgress {
            x: 0px; y: parent.height - self.height;
            width: Theme.scribe ? min(523px, parent.width) : parent.width; height: root.bar-height;
            progress: root.item.progress;
        }
    }
    if DownloadModel.selecting: Rectangle {
        x: parent.width - root.edge - self.width; y: (parent.height - 1px - self.height) / 2;
        width: Theme.scribe ? 32px : 28px; height: self.width;
        border-width: 2px; border-color: Theme.ink; background: root.item.selected ? Theme.ink : Theme.paper;
        if root.item.selected: Icon {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: Theme.scribe ? 22px : 18px; height: self.width; kind: "check"; inverted: true;
        }
    }
    if !DownloadModel.selecting && !root.item.error: Text {
        x: parent.width - root.edge - root.status-width; y: 0px; width: root.status-width; height: parent.height - 1px;
        text: root.item.status; color: root.item.active ? Theme.ink : Theme.secondary; font-family: Theme.ui-font;
        font-size: root.item.active ? (Theme.scribe ? 18px : 15px) : (Theme.scribe ? 17px : 14px);
        font-weight: root.item.active ? 700 : 400; horizontal-alignment: right; vertical-alignment: center; overflow: elide;
    }
    if !DownloadModel.selecting && root.item.error: Rectangle {
        x: parent.width - root.edge - self.width - (Theme.scribe ? root.retry-width + 16px : 0px);
        y: Theme.scribe ? (parent.height - 1px - self.height) / 2 : root.retry-top - 6px - self.height;
        width: failure.preferred-width + (Theme.scribe ? 20px : 16px); height: root.badge-height;
        background: Theme.ink;
        failure := Text {
            text: Strings.dl-failed; color: Theme.paper; font-family: Theme.ui-font; font-size: Theme.minimum-size;
            font-weight: 700; horizontal-alignment: center; vertical-alignment: center;
        }
    }
    Rectangle { x: 0px; y: parent.height - 1px; height: 1px; width: parent.width; background: Theme.line; }
    if row-keyboard.has-focus && !DownloadModel.sheet-open: Rectangle {
        x: 4px; y: 4px; width: cover.width + root.edge; height: parent.height - 8px;
        border-width: 2px; border-color: Theme.ink; background: transparent;
    }
    row-touch := TouchArea {
        width: parent.width; height: parent.height;
        enabled: !DownloadModel.sheet-open;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down { Theme.refresh("press"); }
            else if event.kind == PointerEventKind.up { Theme.refresh("release"); }
        }
        clicked => { root.activate(); }
    }
    row-keyboard := FocusScope {
        x: 0px; width: 0px; enabled: !DownloadModel.sheet-open;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" { root.activate(); return accept; }
            return reject;
        }
    }
    if !DownloadModel.selecting && root.item.error: ActionButton {
        x: parent.width - root.edge - self.width; y: root.retry-top;
        width: root.retry-width; height: root.retry-height;
        text: Strings.dl-retry; text-size: Theme.scribe ? 18px : 15px; text-weight: 700;
        clicked => { if !DownloadModel.sheet-open { DownloadModel.action("retry-item", root.item.id); } }
    }
}

component DownloadTaskCard inherits Rectangle {
    in property <bool> compact;
    property <length> inset: Theme.scribe ? 24px : 18px;
    property <length> vertical-inset: Theme.scribe ? 20px : root.compact ? 12px : 16px;
    property <length> gap: Theme.scribe ? 10px : root.compact ? 6px : 8px;
    property <length> title-height: Theme.scribe ? 29px : 24px;
    property <length> bar-height: Theme.scribe ? 15px : 13px;
    property <length> note-height: Theme.scribe ? 25px : 20px;
    property <length> button-height: Theme.scribe ? 56px : 48px;
    property <length> button-top: root.vertical-inset + root.title-height
        + (DownloadModel.task-has-bar ? root.bar-height + root.gap : 0px)
        + (DownloadModel.task-note != "" ? root.note-height + root.gap : 0px)
        + root.gap + (root.compact ? 2px : 4px);
    height: root.button-top + root.button-height + root.vertical-inset;
    border-width: 2px;
    border-color: Theme.ink;
    background: Theme.paper;

    Text {
        x: root.inset; y: root.vertical-inset; width: max(0px, parent.width - root.inset * 2); height: root.title-height;
        text: DownloadModel.task-title; font-family: Theme.ui-font; font-size: Theme.scribe ? 20px : 16px;
        font-weight: 700; color: Theme.ink; vertical-alignment: center; overflow: elide;
    }
    if DownloadModel.task-has-bar: DownloadProgress {
        x: root.inset; y: root.vertical-inset + root.title-height + root.gap;
        width: max(0px, parent.width - root.inset * 2); height: root.bar-height; progress: DownloadModel.task-progress;
    }
    if DownloadModel.task-note != "": Text {
        x: root.inset; y: root.vertical-inset + root.title-height + root.gap + (DownloadModel.task-has-bar ? root.bar-height + root.gap : 0px);
        width: max(0px, parent.width - root.inset * 2); height: root.note-height;
        text: DownloadModel.task-note; font-family: Theme.ui-font; font-size: Theme.scribe ? 17px : 14px;
        color: Theme.secondary; vertical-alignment: center; overflow: elide;
    }
    HorizontalLayout {
        x: root.inset; y: root.button-top; width: parent.width - root.inset * 2; height: root.button-height;
        spacing: Theme.scribe ? 16px : 12px;
        ActionButton {
            height: root.button-height; horizontal-stretch: 1;
            text: DownloadModel.task-primary; primary: true; enabled: DownloadModel.task-primary-enabled;
            text-size: Theme.scribe ? 20px : 16px; text-weight: 700;
            clicked => { DownloadModel.action("task", DownloadModel.task-primary-action); }
        }
        ActionButton {
            height: root.button-height; horizontal-stretch: 1;
            text: DownloadModel.task-secondary; text-size: Theme.scribe ? 20px : 16px; text-weight: 400;
            clicked => { DownloadModel.action("task", DownloadModel.task-secondary-action); }
        }
    }
}

component DownloadChapterPager inherits Rectangle {
    property <length> arrow-size: Theme.scribe ? 56px : Theme.touch-size;
    width: 2 * root.arrow-size + (Theme.scribe ? 66px : 50px);
    accessible-role: none;
    if DownloadModel.chapter-page > 1: IconButton {
        x: 0px; y: (parent.height - self.height) / 2; width: root.arrow-size; height: root.arrow-size;
        icon: "back"; icon-size: Theme.scribe ? 24px : 20px; label: Strings.common-previous;
        clicked => { DownloadModel.action("chapter-page", "-1"); }
    }
    HorizontalLayout {
        x: root.arrow-size; y: 0px; width: root.width - 2 * root.arrow-size; height: parent.height;
        spacing: 4px; alignment: center;
        Text {
            text: DownloadModel.chapter-page; font-family: Theme.ui-font; font-size: Theme.scribe ? 18px : 15px;
            font-weight: 700; color: Theme.ink; vertical-alignment: center;
        }
        Text {
            text: "/ " + DownloadModel.chapter-page-count; font-family: Theme.ui-font; font-size: Theme.scribe ? 18px : 15px;
            color: Theme.ink; vertical-alignment: center;
        }
    }
    if DownloadModel.chapter-page < DownloadModel.chapter-page-count: IconButton {
        x: parent.width - self.width; y: (parent.height - self.height) / 2; width: root.arrow-size; height: root.arrow-size;
        icon: "next"; icon-size: Theme.scribe ? 24px : 20px; label: Strings.common-next;
        clicked => { DownloadModel.action("chapter-page", "1"); }
    }
}

component DownloadSheet inherits Rectangle {
    property <length> edge: Theme.scribe ? 48px : 16px;
    property <length> header-height: Theme.scribe ? 176px : 120px;
    property <length> chapter-height: Theme.scribe ? 64px : 52px;
    property <length> footer-height: Theme.scribe ? 98px : 78px;
    property <length> card-gap: Theme.scribe ? 16px : 12px;
    property <length> chapter-top: root.header-height + (DownloadModel.task-visible ? task-card.height + root.card-gap : 0px);
    background: Theme.paper;

    Rectangle { x: 0px; y: 0px; width: parent.width; height: 2px; background: Theme.ink; }
    head-cover := DownloadCover {
        x: root.edge; y: Theme.scribe ? 32px : 22px;
        width: Theme.scribe ? 92px : 62px; height: Theme.scribe ? 122px : 82px; source: DownloadModel.sheet-cover;
    }
    Rectangle {
        x: head-cover.x + head-cover.width + (Theme.scribe ? 24px : 16px); y: head-cover.y + 4px;
        width: max(0px, done.x - self.x - 16px); height: head-cover.height;
        Text {
            x: 0px; y: 0px; width: parent.width; height: Theme.scribe ? 38px : 30px;
            text: DownloadModel.sheet-title; font-family: Theme.ui-font; font-size: Theme.scribe ? 26px : 20px;
            font-weight: 700; color: Theme.ink; vertical-alignment: center; overflow: elide;
        }
        Text {
            x: 0px; y: Theme.scribe ? 42px : 34px; width: parent.width; height: Theme.scribe ? 26px : 22px;
            text: DownloadModel.sheet-summary; font-family: Theme.ui-font; font-size: Theme.scribe ? 18px : 15px;
            color: Theme.secondary; vertical-alignment: center; overflow: elide;
        }
    }
    done := ActionButton {
        x: parent.width - (Theme.scribe ? 32px : 12px) - self.width; y: head-cover.y;
        width: self.preferred-width + (Theme.scribe ? 20px : 0px); height: Theme.scribe ? 56px : 48px;
        text: Strings.dl-done; text-size: Theme.scribe ? 20px : 16px; text-weight: 400;
        clicked => { DownloadModel.action("sheet-close", ""); }
    }
    task-card := DownloadTaskCard {
        x: root.edge; y: root.header-height; width: parent.width - root.edge * 2;
        visible: DownloadModel.task-visible;
        // The shorter task card leaves room for four complete rows on Paperwhite.
        compact: !Theme.scribe && (DownloadModel.chapters.length >= 4 || root.height < 612px);
    }
    chapter-header := Rectangle {
        x: 0px; y: root.chapter-top; width: parent.width; height: Theme.scribe ? 56px : 44px;
        Text {
            x: root.edge; y: 0px; width: parent.width - root.edge * 2 - (DownloadModel.chapter-page-count > 1 ? 180px : 0px);
            height: parent.height; text: Strings.dl-local-chapters; font-family: Theme.ui-font;
            font-size: Theme.scribe ? 17px : 14px; color: Theme.secondary; vertical-alignment: center;
        }
        if DownloadModel.chapter-page-count > 1: DownloadChapterPager {
            x: parent.width - (Theme.scribe ? 32px : 8px) - self.width; y: 0px; height: parent.height;
        }
        Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.ink; }
    }
    Rectangle {
        x: 0px; y: chapter-header.y + chapter-header.height; width: parent.width;
        height: max(0px, parent.height - self.y - root.footer-height); clip: true;
        for chapter[index] in DownloadModel.chapters: Rectangle {
            x: 0px; y: index * root.chapter-height; width: parent.width; height: root.chapter-height;
            property <length> gap: Theme.scribe ? 16px : 12px;
            property <length> number-width: Theme.scribe ? 120px : 84px;
            Text {
                x: root.edge; y: 0px; width: parent.number-width; height: parent.height - 1px;
                text: chapter.number; font-family: Theme.ui-font; font-size: Theme.scribe ? 20px : 16px;
                font-weight: 700; color: Theme.ink; vertical-alignment: center; overflow: elide;
            }
            Text {
                x: root.edge + parent.number-width + parent.gap; y: 0px; width: max(0px, size-label.x - self.x - parent.gap);
                height: parent.height - 1px; text: chapter.title; font-family: Theme.ui-font; font-size: Theme.scribe ? 20px : 16px;
                color: Theme.ink; vertical-alignment: center; overflow: elide;
            }
            size-label := Text {
                x: parent.width - root.edge - self.width; y: 0px; width: min(self.preferred-width, 128px); height: parent.height - 1px;
                text: chapter.size; font-family: Theme.ui-font; font-size: Theme.scribe ? 17px : 14px;
                color: Theme.secondary; horizontal-alignment: right; vertical-alignment: center; overflow: elide;
            }
            Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.line; }
        }
        if DownloadModel.chapters.length == 0: Text {
            x: root.edge; y: min(Theme.scribe ? 48px : 32px, max(0px, (parent.height - self.height) / 2));
            width: parent.width - root.edge * 2; height: Theme.scribe ? 30px : 24px;
            text: Strings.dl-no-complete-episodes; font-family: Theme.ui-font; font-size: Theme.scribe ? 20px : 16px;
            color: Theme.secondary; horizontal-alignment: center; vertical-alignment: center;
        }
    }
    Rectangle {
        x: 0px; y: parent.height - root.footer-height; width: parent.width; height: root.footer-height;
        background: Theme.paper;
        Rectangle { x: 0px; y: 0px; width: parent.width; height: 2px; background: Theme.ink; }
        ActionButton {
            x: root.edge; y: 2px + (parent.height - 2px - self.height) / 2;
            width: self.preferred-width + (Theme.scribe ? 20px : 0px); height: Theme.button-height;
            text: DownloadModel.remove-current-label; text-size: Theme.scribe ? 20px : 16px; text-weight: 400;
            clicked => { DownloadModel.action(DownloadModel.remove-current-action, ""); }
        }
        if DownloadModel.can-read: ActionButton {
            x: parent.width - root.edge - self.width; y: 2px + (parent.height - 2px - self.height) / 2;
            width: self.preferred-width + (Theme.scribe ? 24px : 8px); height: Theme.button-height;
            text: Strings.dl-read-offline; text-size: Theme.scribe ? 20px : 16px; text-weight: 700; primary: true;
            clicked => { DownloadModel.action("read", ""); }
        }
    }
}

export component DownloadsScreen inherits Rectangle {
    background: Theme.paper;
    clip: true;
    property <length> edge: Theme.scribe ? 48px : 16px;
    property <length> header-height: Theme.scribe ? 72px : 56px;
    property <length> header-button-height: Theme.scribe ? 56px : 44px;
    property <length> info-height: Theme.scribe ? 64px : 48px;
    property <length> list-top: root.header-height + root.info-height;
    property <length> row-height: Theme.scribe ? 108px : 80px;
    property <length> page-height: Theme.scribe ? 64px : 52px;
    property <length> page-gap: Theme.scribe ? 12px : 8px;
    property <length> sheet-top: max(0px, root.height - (Theme.scribe ? 840px : 612px));
    property <length> shown-under-sheet: floor(max(0px, root.sheet-top - 16px - root.list-top) / root.row-height) * root.row-height;

    header := Rectangle {
        x: 0px; y: 0px; width: parent.width; height: root.header-height;
        HorizontalLayout {
            x: 0px; y: 0px; width: parent.width; height: parent.height - 2px;
            padding-left: root.edge; padding-right: Theme.scribe ? 48px : 12px;
            spacing: Theme.scribe ? 12px : 8px;
            Text {
                text: DownloadModel.selecting ? DownloadModel.selection-label : DownloadModel.status-summary;
                font-family: Theme.ui-font; font-size: Theme.scribe ? 22px : 16px; font-weight: 700;
                color: Theme.ink; vertical-alignment: center; horizontal-stretch: 1; min-width: 0px; overflow: elide;
            }
            if !DownloadModel.selecting && DownloadModel.has-active: ActionButton {
                width: self.preferred-width - (Theme.scribe ? 4px : 16px); height: root.header-button-height;
                text: DownloadModel.all-paused ? Strings.dl-resume-all : Strings.dl-pause-all;
                text-size: Theme.scribe ? 18px : 15px; text-weight: 400;
                clicked => { if !DownloadModel.sheet-open { DownloadModel.action("toggle-all", ""); } }
            }
            if DownloadModel.selecting || DownloadModel.items.length > 0: ActionButton {
                width: self.preferred-width - (Theme.scribe ? 4px : 16px); height: root.header-button-height;
                text: DownloadModel.selecting ? Strings.dl-cancel : Strings.dl-select;
                text-size: Theme.scribe ? 18px : 15px; text-weight: 400;
                clicked => { if !DownloadModel.sheet-open { DownloadModel.action(DownloadModel.selecting ? "cancel-select" : "select", ""); } }
            }
            if DownloadModel.selecting: ActionButton {
                width: self.preferred-width - (Theme.scribe ? 4px : 16px); height: root.header-button-height;
                text: DownloadModel.remove-label; primary: true; enabled: DownloadModel.selected-count > 0;
                text-size: Theme.scribe ? 18px : 15px; text-weight: 700;
                clicked => { DownloadModel.action("remove-selected", ""); }
            }
        }
        Rectangle { x: 0px; y: parent.height - 2px; width: parent.width; height: 2px; background: Theme.ink; }
    }
    Rectangle {
        x: 0px; y: header.height; width: parent.width; height: root.info-height;
        Text {
            x: root.edge; y: 0px; width: max(0px, smart.x - self.x - 8px); height: parent.height - 1px;
            text: DownloadModel.summary; font-family: Theme.ui-font; font-size: Theme.scribe ? 17px : 14px;
            color: Theme.secondary; vertical-alignment: center; overflow: elide;
        }
        smart := NavigationButton {
            x: parent.width - (Theme.scribe ? 40px : 8px) - self.width; y: (parent.height - 1px - self.height) / 2;
            height: root.header-button-height; text: DownloadModel.smart-label; trailing: true; icon: "next";
            text-size: Theme.scribe ? 18px : 15px; text-weight: 400;
            icon-size: Theme.scribe ? 22px : 18px; horizontal-padding: Theme.scribe ? 8px : 6px; icon-spacing: Theme.scribe ? 4px : 2px;
            clicked => { if !DownloadModel.sheet-open { DownloadModel.action("smart-settings", ""); } }
        }
        Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.ink; }
    }
    Rectangle {
        x: 0px; y: root.list-top; width: parent.width;
        height: DownloadModel.sheet-open ? root.shown-under-sheet
            : max(0px, parent.height - self.y - (DownloadModel.page-count > 1 ? root.page-height + root.page-gap : 0px));
        clip: true;
        for item[index] in DownloadModel.items: DownloadRow {
            x: 0px; y: index * root.row-height; width: parent.width; height: root.row-height; item: item;
        }
        if DownloadModel.items.length == 0: Rectangle {
            x: 0px; y: max(0px, (parent.height - self.height - (Theme.scribe ? 80px : 56px)) / 2);
            width: parent.width; height: Theme.scribe ? 108px : 88px;
            Text {
                x: root.edge; y: 0px; width: parent.width - root.edge * 2; height: Theme.scribe ? 32px : 24px;
                text: Strings.dl-empty; font-family: Theme.ui-font; font-size: Theme.scribe ? 22px : 17px;
                color: Theme.secondary; horizontal-alignment: center; vertical-alignment: center;
            }
            ActionButton {
                x: (parent.width - self.width) / 2; y: parent.height - self.height;
                width: self.preferred-width + (Theme.scribe ? 16px : 8px); height: Theme.scribe ? 56px : 48px;
                text: Strings.dl-go-store; text-size: Theme.scribe ? 18px : 16px; text-weight: 700;
                clicked => { DownloadModel.action("store", ""); }
            }
        }
    }
    if !DownloadModel.sheet-open && DownloadModel.page-count > 1: PageBar {
        x: 0px; y: parent.height - root.page-gap - root.page-height; width: parent.width; height: root.page-height;
        edge: root.edge; separator: true; page: DownloadModel.page; count: DownloadModel.page-count;
        turn(delta) => { DownloadModel.action("page", "" + delta); }
    }
    if DownloadModel.sheet-open: Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        // Clip the background at a complete row, then keep a white isolation band above the panel.
        Rectangle { x: 0px; y: max(0px, root.sheet-top - 16px); width: parent.width; height: min(16px, root.sheet-top); background: Theme.paper; }
        TouchArea {
            x: 0px; y: 0px; width: parent.width; height: parent.height;
            clicked => { if self.mouse-y < root.sheet-top { DownloadModel.action("sheet-close", ""); } }
        }
        DownloadSheet { x: 0px; y: root.sheet-top; width: parent.width; height: parent.height - self.y; }
    }
}
