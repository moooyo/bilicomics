import { Theme } from "theme.slint";
import { Strings } from "strings.slint";
import { ActionButton, Icon, IconButton, NavigationButton } from "widgets.slint";

export struct AccountInfoItem { label: string, value: string }
export struct AccountRecordItem { title: string, status: string, amount: string, time: string }
struct AccountOption { id: string, label: string }
struct AccountChoice { action: string, title: string, current: int, options: [AccountOption] }
struct AccountCategory { id: string, title: string, summary: string }

export global AccountModel {
    callback action(string, string);
    in-out property <string> section: "home";
    in-out property <string> local-dialog;
    in-out property <bool> signed-in;
    in-out property <string> username;
    in-out property <string> initial;
    in-out property <string> session-status;
    in-out property <string> balance;
    in-out property <string> coupons;
    in-out property <string> balance-time;
    in-out property <bool> wallet-refreshed;
    in-out property <string> last-purchase;
    in-out property <string> last-recharge;
    in-out property <[AccountRecordItem]> purchase-rows;
    in-out property <[AccountRecordItem]> recharge-rows;
    in-out property <string> recharge-history-status;
    in-out property <string> storage-used;
    in-out property <string> storage-free;
    in-out property <string> manual-used;
    in-out property <string> cache-used;
    in-out property <string> cache-action;
    in-out property <string> cache-result;
    in-out property <float> cache-fill;
    in-out property <float> storage-manual-fill;
    in-out property <float> storage-cache-fill;
    in-out property <string> data-directory;
    in-out property <string> version;
    in-out property <string> device-short;
    in-out property <string> firmware;
    in-out property <string> diagnostics-result;
    in-out property <bool> session-imported;
    in-out property <string> message;
    in-out property <bool> busy;
    in-out property <string> mode: "page";
    in-out property <string> fit: "page";
    in-out property <string> direction: "ltr";
    in-out property <string> every: "smart";
    in-out property <string> refresh-mode: "normal";
    in-out property <string> refresh-mode-note;
    in-out property <bool> dither: true;
    in-out property <string> dither-method: "bayer8";
    in-out property <string> dither-note;
    in-out property <string> landscape: "spread";
    in-out property <bool> jpeg-acceleration;
    in-out property <bool> jpeg-acceleration-available;
    in-out property <string> jpeg-acceleration-note;
    in-out property <string> smart: "on";
    in-out property <int> ahead: 2;
    in-out property <int> concurrency: 2;
    in-out property <int> preload: 3;
    in-out property <string> wifi: "auto";
    in-out property <int> cache-limit: 512;
    in-out property <string> launch: "resume";
    in-out property <string> sleep-cover: "system";
    in-out property <string> flashui: "on";
    in-out property <string> orientation: "portrait";
    in-out property <bool> can-wifi;
    in-out property <bool> can-orient;
    in-out property <bool> can-sleep-cover;
    in-out property <bool> can-smart;
    in-out property <bool> can-update;
    in-out property <bool> recharge-visible;
    in-out property <string> recharge-phase;
    in-out property <[AccountInfoItem]> recharge-options;
    in-out property <int> recharge-index;
    in-out property <bool> recharge-busy;
    in-out property <string> recharge-total;
    in-out property <string> recharge-coins;
    in-out property <image> recharge-qr;
    in-out property <string> recharge-message;
    in-out property <bool> recharge-can-check;
}

component AccountText inherits Text {
    font-family: Theme.ui-font;
    font-size: Theme.body-size;
    color: Theme.ink;
    vertical-alignment: center;
    overflow: elide;
}

component RowRule inherits Rectangle {
    x: 0px; height: 1px;
    background: Theme.line;
}

component AccountHit inherits Rectangle {
    in property <bool> enabled: true;
    in property <string> label;
    in property <bool> checkable;
    in property <bool> checked;
    out property <bool> pressed: touch.pressed;
    callback activated();
    background: transparent;
    forward-focus: keyboard;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-checkable: root.checkable;
    accessible-checked: root.checked;
    accessible-action-default => { if root.enabled { root.activated(); } }
    if keyboard.has-focus && root.enabled: Rectangle {
        x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px;
        border-width: 1px; border-color: Theme.ink; background: transparent;
    }
    touch := TouchArea {
        enabled: root.enabled;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down { Theme.refresh("press"); }
            else if event.kind == PointerEventKind.up { Theme.refresh("release"); }
        }
        clicked => { root.activated(); }
    }
    keyboard := FocusScope {
        x: 0px; width: 0px; enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" { root.activated(); return accept; }
            return reject;
        }
    }
}

component SettingRow inherits Rectangle {
    in property <string> title;
    in property <string> value;
    in property <bool> navigates;
    in property <bool> toggle;
    in property <bool> checked;
    in property <string> button-text;
    in property <bool> button-enabled: true;
    callback clicked();
    height: Theme.scribe ? 72px : 60px;
    background: hit.pressed ? Theme.pale : Theme.paper;
    property <length> inset: Theme.scribe ? 0px : 16px;
    property <length> trailing: Theme.scribe ? 34px : 26px;
    property <length> button-width: root.button-text == "" ? 0px : min(root.width * 0.42, button-label.preferred-width + 38px);
    property <length> value-right: root.width - root.inset - (root.button-text != "" ? root.button-width + 12px : root.trailing);
    AccountText {
        x: root.inset; y: 0px;
        width: max(0px, (root.toggle ? switch.x : root.value == "" ? root.value-right : row-value.x) - self.x - 10px);
        height: parent.height; text: root.title;
    }
    row-value := AccountText {
        x: root.value-right - self.width;
        y: 0px; width: min(self.preferred-width, max(0px, root.value-right - root.inset - root.width * 0.42)); height: parent.height;
        text: root.value; color: Theme.secondary; font-size: Theme.scribe ? 18px : 15px;
        horizontal-alignment: right;
    }
    if root.navigates: Icon {
        x: parent.width - root.inset - self.width + (Theme.scribe ? -2px : 4px);
        y: (parent.height - self.height) / 2;
        width: Theme.scribe ? 22px : 18px; height: self.width; kind: "next";
    }
    switch := Rectangle {
        visible: root.toggle;
        x: parent.width - root.inset - self.width;
        y: (parent.height - self.height) / 2;
        width: 56px; height: 30px;
        border-width: 2px; border-color: Theme.ink;
        background: root.checked ? Theme.ink : Theme.paper;
        Rectangle {
            x: root.checked ? 30px : 4px; y: 4px; width: 22px; height: 22px;
            background: root.checked ? Theme.paper : Theme.ink;
        }
    }
    button-label := AccountText {
        visible: false; text: root.button-text; font-size: Theme.scribe ? 18px : 15px; font-weight: 700;
    }
    if root.button-text != "": ActionButton {
        x: parent.width - root.inset - self.width; y: (parent.height - self.height) / 2;
        width: root.button-width; height: Theme.scribe ? 56px : 44px;
        text: root.button-text; text-size: Theme.scribe ? 18px : 15px; text-weight: 700;
        enabled: root.button-enabled;
        clicked => { root.clicked(); }
    }
    RowRule { y: parent.height - 1px; width: parent.width; }
    hit := AccountHit {
        visible: root.navigates || root.toggle;
        enabled: self.visible;
        label: root.value == "" ? root.title : root.title + " " + root.value;
        checkable: root.toggle; checked: root.checked;
        activated => { root.clicked(); }
    }
}

component CategoryRow inherits Rectangle {
    in property <AccountCategory> category;
    in property <bool> selected;
    callback clicked();
    height: Theme.scribe ? 72px : 66px;
    background: root.selected || hit.pressed ? Theme.pale : Theme.paper;
    if Theme.scribe && root.selected: Rectangle { x: 0px; y: 0px; width: 6px; height: parent.height; background: Theme.ink; }
    AccountText {
        x: Theme.scribe ? 48px : 16px;
        y: Theme.scribe ? 0px : 10px;
        width: parent.width - self.x - (Theme.scribe ? 16px : 48px);
        height: Theme.scribe ? parent.height : 24px;
        text: root.category.title; font-weight: root.selected || !Theme.scribe ? 700 : 400;
    }
    if !Theme.scribe: AccountText {
        x: 16px; y: 34px; width: parent.width - 60px; height: 22px;
        text: root.category.summary; font-size: Theme.minimum-size; color: Theme.secondary;
    }
    if !Theme.scribe: Icon { x: parent.width - 30px; y: (parent.height - self.height) / 2; width: 18px; height: 18px; kind: "next"; }
    if !Theme.scribe: RowRule { y: parent.height - 1px; width: parent.width; }
    hit := AccountHit {
        label: Theme.scribe ? root.category.title : root.category.title + " " + root.category.summary;
        checkable: Theme.scribe; checked: root.selected;
        activated => { root.clicked(); }
    }
}

component WalletFigures inherits Rectangle {
    out property <length> ideal-width: coins.preferred-width + coin-unit.preferred-width + coupons.preferred-width + coupon-unit.preferred-width + 3 * root.spacing + root.gap;
    property <length> spacing: Theme.scribe ? 8px : 6px;
    property <length> gap: Theme.scribe ? 14px : 10px;
    property <length> unit-height: Theme.scribe ? 34px : 30px;
    HorizontalLayout {
        x: 0px; y: 0px; width: root.width; height: root.height;
        alignment: start; spacing: root.spacing;
        coins := AccountText { text: AccountModel.balance; font-size: Theme.scribe ? 32px : 26px; font-weight: 700; }
        coin-unit := AccountText {
            y: (root.height - self.height) / 2 + (Theme.scribe ? 7px : 5px); height: root.unit-height;
            text: Strings.acct-coin; font-size: Theme.scribe ? 18px : 15px;
        }
        Rectangle { width: root.gap - root.spacing; }
        coupons := AccountText { text: AccountModel.coupons; font-size: Theme.scribe ? 32px : 26px; font-weight: 700; }
        coupon-unit := AccountText {
            y: (root.height - self.height) / 2 + (Theme.scribe ? 7px : 5px); height: root.unit-height;
            text: Strings.acct-coupon-count-long; font-size: Theme.scribe ? 18px : 15px;
        }
    }
}

component AccountProfile inherits Rectangle {
    height: Theme.scribe ? 112px : AccountModel.signed-in ? 146px : 150px;
    property <length> inset: Theme.scribe ? 48px : 16px;
    property <length> right-inset: Theme.scribe ? 32px : 16px;
    property <length> identity-height: Theme.scribe ? 110px : 84px;
    property <length> control-height: Theme.scribe ? 56px : 44px;
    property <length> control-y: Theme.scribe ? (root.identity-height - root.control-height) / 2 : root.identity-height;
    property <length> spacing: Theme.scribe ? 18px : 10px;
    property <length> recharge-width: Theme.scribe ? 80px : 62px;
    property <length> refresh-width: (Theme.scribe ? 76px : 62px) + (AccountModel.wallet-refreshed ? Theme.label-size : 0px);
    property <length> controls-x: root.width - root.right-inset - root.recharge-width - root.spacing - root.refresh-width;
    property <length> wallet-width: Theme.scribe ? min(max(0px, root.controls-x - 270px), figures.ideal-width) : root.controls-x - root.inset - 12px;
    property <length> right-edge-of-name: Theme.scribe ? (AccountModel.signed-in ? figures.x - 18px : login-button.x - 18px) : root.width - 138px;

    avatar := Rectangle {
        x: root.inset; y: (root.identity-height - self.height) / 2;
        width: Theme.scribe ? 64px : 56px; height: self.width;
        border-width: 2px; border-color: Theme.ink; border-radius: self.width / 2;
        AccountText {
            horizontal-alignment: center;
            text: AccountModel.initial == "" || !AccountModel.signed-in ? "?" : AccountModel.initial;
            font-size: Theme.scribe ? 28px : 24px; font-weight: 700;
        }
    }
    AccountText {
        x: avatar.x + avatar.width + (Theme.scribe ? 18px : 14px);
        y: 0px; width: max(0px, root.right-edge-of-name - self.x); height: root.identity-height;
        text: AccountModel.signed-in ? AccountModel.username : Strings.acct-signed-out;
        font-size: Theme.scribe ? 26px : 22px; font-weight: 700;
    }
    if !Theme.scribe: NavigationButton {
        x: parent.width - 8px - self.width; y: (root.identity-height - self.height) / 2;
        width: 116px; height: 44px; icon: "power"; icon-size: 18px;
        outlined: true; text: Strings.acct-exit-app; text-size: 15px;
        horizontal-padding: 8px;
        clicked => { AccountModel.action("exit", ""); }
    }
    figures := WalletFigures {
        visible: AccountModel.signed-in;
        x: Theme.scribe ? root.controls-x - self.width - 30px : root.inset;
        y: root.control-y; width: max(0px, root.wallet-width); height: root.control-height;
    }
    if AccountModel.signed-in: ActionButton {
        x: root.controls-x; y: root.control-y; width: root.refresh-width; height: root.control-height;
        text: AccountModel.wallet-refreshed ? Strings.acct-refreshed : Strings.acct-refresh;
        text-size: Theme.scribe ? 18px : 15px; enabled: !AccountModel.busy;
        clicked => { AccountModel.action("refresh-wallet", ""); }
    }
    if AccountModel.signed-in: ActionButton {
        x: parent.width - root.right-inset - self.width; y: root.control-y;
        width: root.recharge-width; height: root.control-height;
        text: Strings.acct-recharge; text-size: Theme.scribe ? 18px : 15px;
        primary: true; text-weight: 700;
        clicked => { AccountModel.action("recharge", ""); }
    }
    login-button := ActionButton {
        visible: !AccountModel.signed-in;
        x: Theme.scribe ? parent.width - root.right-inset - self.width : root.inset;
        y: Theme.scribe ? root.control-y : root.identity-height;
        width: Theme.scribe ? 128px : parent.width - 2 * root.inset; height: Theme.scribe ? root.control-height : 48px;
        primary: true; text: Strings.acct-login; text-weight: 700; enabled: self.visible;
        clicked => { AccountModel.action("login", ""); }
    }
    Rectangle { x: 0px; y: parent.height - 2px; width: parent.width; height: 2px; background: Theme.ink; }
}

component CacheHatch inherits Rectangle {
    background: Theme.paper;
    clip: true;
    for index in ceil((root.width + root.height) / 7px): Path {
        x: 0px; y: 0px; width: root.width; height: root.height;
        viewbox-width: max(1, root.width / 1px); viewbox-height: max(1, root.height / 1px);
        stroke: Theme.ink; stroke-width: 2px; fill: transparent;
        MoveTo { x: index * 7 - root.height / 1px; y: 0; }
        LineTo { x: index * 7; y: root.height / 1px; }
    }
}

component StorageBlock inherits Rectangle {
    height: Theme.scribe ? 146px : 124px;
    property <length> inset: Theme.scribe ? 0px : 16px;
    property <float> manual-ratio: clamp(AccountModel.storage-manual-fill, 0, 1);
    property <float> cache-ratio: clamp(AccountModel.storage-cache-fill, 0, 1 - root.manual-ratio);
    AccountText {
        x: root.inset; y: Theme.scribe ? 20px : 16px; width: (parent.width - 2 * root.inset) * 0.57;
        height: Theme.scribe ? 36px : 30px; text: Strings.acct-used-prefix + AccountModel.storage-used;
        font-size: Theme.scribe ? 24px : 20px; font-weight: 700;
    }
    AccountText {
        x: parent.width * 0.57; y: Theme.scribe ? 23px : 18px; width: parent.width - self.x - root.inset;
        height: Theme.scribe ? 36px : 30px; text: Strings.acct-free-prefix + AccountModel.storage-free;
        font-size: Theme.scribe ? 18px : 15px; color: Theme.secondary; horizontal-alignment: right;
    }
    track := Rectangle {
        x: root.inset; y: Theme.scribe ? 66px : 56px; width: parent.width - 2 * root.inset;
        height: Theme.scribe ? 22px : 18px;
        border-width: 2px; border-color: Theme.ink; background: Theme.paper;
        manual := Rectangle {
            x: 2px; y: 2px; width: (parent.width - 4px) * root.manual-ratio; height: parent.height - 4px;
            background: Theme.ink;
        }
        if root.cache-ratio > 0: CacheHatch {
            x: manual.x + manual.width; y: 2px; width: (parent.width - 4px) * root.cache-ratio; height: parent.height - 4px;
            if root.manual-ratio > 0: Rectangle { x: 0px; y: 0px; width: min(2px, parent.width); height: parent.height; background: Theme.ink; }
        }
    }
    HorizontalLayout {
        x: root.inset; y: track.y + track.height + 10px; width: parent.width - 2 * root.inset; height: 30px;
        alignment: start; spacing: 8px;
        Rectangle { width: 16px; Rectangle { x: 0px; y: (parent.height - 16px) / 2; width: 16px; height: 16px; background: Theme.ink; } }
        AccountText { text: Strings.acct-manual-download + AccountModel.manual-used; font-size: Theme.scribe ? 18px : 15px; }
        Rectangle { width: 8px; }
        Rectangle {
            width: 16px;
            Rectangle {
                x: 0px; y: (parent.height - 16px) / 2; width: 16px; height: 16px;
                border-width: 2px; border-color: Theme.ink; background: Theme.paper;
                CacheHatch { x: 2px; y: 2px; width: 12px; height: 12px; }
            }
        }
        AccountText { text: Strings.acct-auto-cache + AccountModel.cache-used; font-size: Theme.scribe ? 18px : 15px; }
    }
    RowRule { y: parent.height - 1px; width: parent.width; }
}

global AccountSettingsData {
    out property <bool> fast: AccountModel.refresh-mode == "fast";
    out property <AccountChoice> reading-mode: {
        action: "mode", title: Strings.acct-reading-mode,
        current: AccountModel.mode == "panel" ? 1 : AccountModel.mode == "strip" ? 2 : 0,
        options: [{id: "page", label: Strings.acct-single}, {id: "panel", label: Strings.acct-panel}, {id: "strip", label: Strings.acct-strip}]
    };
    out property <AccountChoice> fit: {
        action: "fit", title: Strings.read-fit,
        current: AccountModel.fit == "original" ? 0 : AccountModel.fit == "height" ? 2 : AccountModel.fit == "width" ? 3 : 1,
        options: [{id: "original", label: Strings.read-zoom-original}, {id: "page", label: Strings.read-zoom-page}, {id: "height", label: Strings.read-zoom-height}, {id: "width", label: Strings.read-zoom-width}]
    };
    out property <AccountChoice> direction: {
        action: "direction", title: Strings.acct-direction, current: AccountModel.direction == "rtl" ? 1 : 0,
        options: [{id: "ltr", label: Strings.acct-ltr}, {id: "rtl", label: Strings.acct-rtl}]
    };
    out property <AccountChoice> landscape: {
        action: "landscape", title: Strings.acct-landscape-layout, current: AccountModel.landscape == "single" ? 1 : 0,
        options: [{id: "spread", label: Strings.acct-spread}, {id: "single", label: Strings.acct-fit-width}]
    };
    out property <AccountChoice> launch: {
        action: "launch", title: Strings.acct-launch, current: AccountModel.launch == "shelf" ? 1 : 0,
        options: [{id: "resume", label: Strings.acct-resume}, {id: "shelf", label: Strings.acct-open-shelf}]
    };
    out property <AccountChoice> refresh-mode: {
        action: "refresh-mode", title: Strings.refresh-mode-label, current: fast ? 1 : 0,
        options: [{id: "normal", label: Strings.refresh-mode-normal}, {id: "fast", label: Strings.refresh-mode-fast}]
    };
    out property <AccountChoice> every: {
        action: "every", title: Strings.acct-auto-refresh,
        current: AccountModel.every == "1" ? 1 : AccountModel.every == "6" ? 2 : AccountModel.every == "0" ? 3 : AccountModel.every == "12" ? -1 : 0,
        options: [{id: "smart", label: Strings.acct-smart}, {id: "1", label: Strings.acct-every-page}, {id: "6", label: Strings.acct-every-six}, {id: "0", label: Strings.acct-never}]
    };
    out property <AccountChoice> dither: {
        action: "dither-method", title: Strings.acct-image-dither,
        current: !AccountModel.dither ? 0 : AccountModel.dither-method == "floyd_steinberg" ? 2 : 1,
        options: [{id: "off", label: Strings.spatial-dither-off}, {id: "bayer8", label: Strings.acct-bayer}, {id: "floyd_steinberg", label: Strings.acct-dither-precision}]
    };
    out property <AccountChoice> ahead: {
        action: "ahead", title: Strings.acct-download-ahead,
        current: AccountModel.ahead == 1 ? 0 : AccountModel.ahead == 3 ? 2 : AccountModel.ahead == 5 ? 3 : 1,
        options: [{id: "1", label: Strings.acct-one-episode}, {id: "2", label: Strings.acct-two-episodes}, {id: "3", label: Strings.acct-three-episodes}, {id: "5", label: Strings.acct-five-episodes}]
    };
    out property <AccountChoice> concurrency: {
        action: "concurrency", title: Strings.acct-concurrency, current: clamp(AccountModel.concurrency - 1, 0, 3),
        options: [{id: "1", label: "1" + Strings.acct-image-count-suffix}, {id: "2", label: "2" + Strings.acct-image-count-suffix}, {id: "3", label: "3" + Strings.acct-image-count-suffix}, {id: "4", label: "4" + Strings.acct-image-count-suffix}]
    };
    out property <AccountChoice> preload: {
        action: "preload", title: Strings.acct-preload, current: AccountModel.preload == 0 ? 0 : AccountModel.preload == 5 ? 2 : 1,
        options: [{id: "0", label: Strings.acct-off}, {id: "3", label: Strings.acct-next-three}, {id: "5", label: Strings.acct-next-five}]
    };
    out property <AccountChoice> wifi: {
        action: "wifi", title: "Wi-Fi", current: AccountModel.wifi == "always" ? 1 : 0,
        options: [{id: "auto", label: Strings.acct-wifi-auto}, {id: "always", label: Strings.acct-wifi-always}]
    };
    out property <AccountChoice> cache-limit: {
        action: "cache-limit", title: Strings.acct-cache-limit,
        current: AccountModel.cache-limit == 256 ? 0 : AccountModel.cache-limit == 1024 ? 2 : AccountModel.cache-limit == 2048 ? 3 : 1,
        options: [{id: "256", label: "256 MB"}, {id: "512", label: "512 MB"}, {id: "1024", label: "1 GB"}, {id: "2048", label: "2 GB"}]
    };
    out property <AccountChoice> orientation: {
        action: "orientation", title: Strings.acct-orientation, current: AccountModel.orientation == "auto" ? 0 : 1,
        options: [{id: "auto", label: Strings.acct-orientation-auto}, {id: "portrait", label: Strings.acct-orientation-portrait}]
    };
    out property <AccountChoice> sleep-cover: {
        action: "sleep-cover", title: Strings.acct-sleep, current: AccountModel.sleep-cover == "cover" ? 0 : 1,
        options: [{id: "cover", label: Strings.acct-sleep-cover}, {id: "system", label: Strings.acct-sleep-system}]
    };
    public pure function choice-label(choice: AccountChoice) -> string {
        return choice.current >= 0 ? choice.options[choice.current].label : Strings.acct-every-twelve;
    }
}

component SettingChoiceRow inherits SettingRow {
    in property <AccountChoice> choice;
    in property <bool> available: true;
    in property <bool> paused;
    title: root.choice.title;
    value: !root.available ? Strings.acct-unavailable : AccountSettingsData.choice-label(root.choice) + (root.paused ? " · " + Strings.acct-paused : "");
    navigates: root.available && !root.paused;
}

component AccountRecordRow inherits Rectangle {
    in property <AccountRecordItem> record;
    height: Theme.scribe ? 88px : 72px;
    property <length> inset: Theme.scribe ? 0px : 16px;
    property <length> amount-area: min(root.width * 0.45, max(amount-label.preferred-width, time-label.preferred-width));
    AccountText {
        x: root.inset; y: 0px; width: max(0px, parent.width - 2 * root.inset - root.amount-area - 12px);
        height: parent.height; text: root.record.title;
        font-weight: 700; vertical-alignment: root.record.status == "" ? center : top;
        visible: root.record.status == "";
    }
    if root.record.status != "": AccountText {
        x: root.inset; y: Theme.scribe ? 15px : 12px; width: max(0px, parent.width - 2 * root.inset - root.amount-area - 12px);
        height: Theme.scribe ? 30px : 26px; text: root.record.title; font-weight: 700;
    }
    if root.record.status != "": AccountText {
        x: root.inset; y: Theme.scribe ? 47px : 36px; width: max(0px, parent.width - 2 * root.inset - root.amount-area - 12px);
        height: Theme.scribe ? 27px : 24px; text: root.record.status; color: Theme.secondary;
        font-size: Theme.minimum-size;
    }
    amount-label := AccountText {
        x: root.width - root.inset - self.width; y: Theme.scribe ? 15px : 12px;
        width: root.amount-area; height: Theme.scribe ? 30px : 26px;
        text: root.record.amount; font-weight: 700; font-size: Theme.scribe ? 19px : 16px; horizontal-alignment: right;
    }
    time-label := AccountText {
        x: root.width - root.inset - self.width; y: root.record.amount == "" ? 0px : Theme.scribe ? 47px : 36px;
        width: root.amount-area; height: root.record.amount == "" ? parent.height : Theme.scribe ? 27px : 24px;
        text: root.record.time; font-size: Theme.minimum-size; color: Theme.secondary; horizontal-alignment: right;
    }
    RowRule { y: parent.height - 1px; width: parent.width; }
}

component CategorySettings inherits Rectangle {
    in property <string> section;
    callback pick(AccountChoice);
    callback signout();
    out property <length> content-height: rows.preferred-height;
    VerticalLayout {
        rows := VerticalLayout {
            vertical-stretch: 0;
            for choice in root.section == "reading" ? [AccountSettingsData.reading-mode, AccountSettingsData.fit, AccountSettingsData.direction, AccountSettingsData.landscape, AccountSettingsData.launch] : []: SettingChoiceRow {
                choice: choice; clicked => { root.pick(self.choice); }
            }
            if root.section == "display": SettingChoiceRow { choice: AccountSettingsData.refresh-mode; clicked => { root.pick(self.choice); } }
            if root.section == "display": SettingChoiceRow { choice: AccountSettingsData.every; paused: AccountSettingsData.fast; clicked => { root.pick(self.choice); } }
            if root.section == "display": SettingChoiceRow { choice: AccountSettingsData.dither; paused: AccountSettingsData.fast; clicked => { root.pick(self.choice); } }
            if root.section == "display": SettingRow {
                title: Strings.media-jpeg-acceleration;
                value: AccountModel.jpeg-acceleration-available ? "" : Strings.acct-unavailable;
                toggle: AccountModel.jpeg-acceleration-available; checked: AccountModel.jpeg-acceleration;
                clicked => { AccountModel.action("jpeg-acceleration", self.checked ? "off" : "on"); }
            }
            if root.section == "download": SettingRow {
                title: Strings.acct-smart-download;
                value: AccountModel.can-smart ? "" : Strings.acct-unavailable;
                toggle: AccountModel.can-smart; checked: AccountModel.smart == "on";
                clicked => { AccountModel.action("smart", self.checked ? "off" : "on"); }
            }
            if root.section == "download": SettingChoiceRow { choice: AccountSettingsData.ahead; available: AccountModel.can-smart; clicked => { root.pick(self.choice); } }
            if root.section == "download": SettingChoiceRow { choice: AccountSettingsData.concurrency; clicked => { root.pick(self.choice); } }
            if root.section == "download": SettingChoiceRow { choice: AccountSettingsData.preload; clicked => { root.pick(self.choice); } }
            if root.section == "download": SettingChoiceRow { choice: AccountSettingsData.wifi; available: AccountModel.can-wifi; clicked => { root.pick(self.choice); } }
            if root.section == "storage": StorageBlock {}
            if root.section == "storage": SettingChoiceRow { choice: AccountSettingsData.cache-limit; clicked => { root.pick(self.choice); } }
            if root.section == "storage": SettingRow {
                title: Strings.acct-auto-cache; value: AccountModel.cache-result; button-text: AccountModel.cache-action;
                clicked => { AccountModel.action("clear-cache", ""); }
            }
            if root.section == "system": SettingRow {
                title: Strings.acct-navigation-flash; toggle: true; checked: AccountModel.flashui == "on";
                clicked => { AccountModel.action("flashui", self.checked ? "off" : "on"); }
            }
            if root.section == "system": SettingChoiceRow { choice: AccountSettingsData.orientation; available: AccountModel.can-orient; clicked => { root.pick(self.choice); } }
            if root.section == "system": SettingChoiceRow { choice: AccountSettingsData.sleep-cover; available: AccountModel.can-sleep-cover; clicked => { root.pick(self.choice); } }
            if root.section == "account" && AccountModel.signed-in: SettingRow {
                title: Strings.acct-purchase-history; value: AccountModel.last-purchase; navigates: true;
                clicked => { AccountModel.action("purchase-history", ""); }
            }
            if root.section == "account" && AccountModel.signed-in: SettingRow {
                title: Strings.acct-recharge-history; value: AccountModel.last-recharge; navigates: true;
                clicked => { AccountModel.action("recharge-history", ""); }
            }
            if root.section == "account": SettingRow {
                title: Strings.acct-import-session;
                value: AccountModel.session-imported ? Strings.acct-imported : Strings.acct-import-filename;
                button-text: AccountModel.session-imported ? "" : Strings.acct-import;
                button-enabled: !AccountModel.busy;
                clicked => { AccountModel.action("import-session", ""); }
            }
            if root.section == "account" && AccountModel.signed-in: Rectangle {
                height: Theme.scribe ? 104px : 76px;
                ActionButton {
                    x: Theme.scribe ? 0px : 16px; y: Theme.scribe ? 28px : 24px;
                    width: Theme.scribe ? 128px : 116px; height: Theme.scribe ? 56px : 44px;
                    text: Strings.acct-logout; text-size: Theme.body-size; text-weight: 700;
                    enabled: !AccountModel.busy;
                    clicked => { root.signout(); }
                }
            }
            if root.section == "about": SettingRow { title: Strings.acct-version; value: "v" + AccountModel.version; }
            if root.section == "about": SettingRow { title: Strings.acct-device; value: AccountModel.device-short; }
            if root.section == "about": SettingRow { title: Strings.acct-firmware; value: AccountModel.firmware; }
            if root.section == "about": SettingRow { title: Strings.acct-data-directory; value: AccountModel.data-directory; }
            if root.section == "about": SettingRow {
                title: Strings.acct-export-diagnostics; value: AccountModel.diagnostics-result;
                button-text: self.value == "" ? Strings.acct-export : "";
                clicked => { AccountModel.action("export-diagnostics", ""); }
            }
            if root.section == "about": SettingRow {
                title: Strings.acct-check-update; value: AccountModel.can-update ? "" : Strings.acct-unavailable;
                button-text: AccountModel.can-update ? Strings.acct-check : "";
                clicked => { AccountModel.action("check-update", ""); }
            }
            if root.section == "about": SettingRow {
                title: Strings.acct-first-setup; button-text: Strings.acct-rerun;
                clicked => { AccountModel.action("onboarding", ""); }
            }
            for row in root.section == "purchases" ? AccountModel.purchase-rows : root.section == "recharges" ? AccountModel.recharge-rows : []: AccountRecordRow { record: row; }
            if root.section == "purchases" && AccountModel.purchase-rows.length == 0: SettingRow { title: Strings.acct-no-records; }
            if root.section == "recharges" && AccountModel.recharge-history-status != "": SettingRow { title: AccountModel.recharge-history-status; }
            if AccountModel.message != "": AccountText {
                height: self.preferred-height + 24px; horizontal-alignment: center; wrap: word-wrap; color: Theme.secondary;
                font-size: Theme.caption-size; text: AccountModel.message;
            }
        }
        Rectangle { vertical-stretch: 1; }
    }
}

component AccountDialogFrame inherits Rectangle {
    in property <length> halo: Theme.scribe ? 24px : 16px;
    background: Theme.paper;
    Rectangle {
        x: -root.halo; y: -root.halo; width: parent.width + 2 * root.halo; height: parent.height + 2 * root.halo;
        background: Theme.paper;
    }
    TouchArea { clicked => {} }
    Rectangle { x: 0px; y: 0px; width: parent.width; height: parent.height; border-width: 3px; border-color: Theme.ink; background: Theme.paper; }
    @children
}

component AccountPickerRow inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback picked();
    height: Theme.scribe ? 68px : 56px;
    property <length> inset: Theme.scribe ? 32px : 24px;
    background: hit.pressed ? Theme.pale : Theme.paper;
    Rectangle {
        x: root.inset; y: (parent.height - self.height) / 2;
        width: Theme.scribe ? 24px : 20px; height: self.width;
        border-width: 2px; border-color: Theme.ink; border-radius: self.width / 2;
        background: root.active ? Theme.ink : Theme.paper;
        if root.active: Rectangle {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: Theme.scribe ? 7px : 6px; height: self.width; border-radius: self.width / 2;
            background: Theme.paper;
        }
    }
    AccountText {
        x: root.inset + (Theme.scribe ? 38px : 34px); y: 0px;
        width: parent.width - self.x - root.inset; height: parent.height;
        text: root.label; font-weight: root.active ? 700 : 400;
    }
    RowRule { y: parent.height - 1px; width: parent.width; }
    hit := AccountHit {
        label: root.label; checkable: true; checked: root.active;
        activated => { root.picked(); }
    }
}

component AccountPicker inherits Rectangle {
    in property <AccountChoice> choice;
    callback dismissed();
    callback picked(string);
    property <length> title-height: Theme.scribe ? 64px : 56px;
    property <length> option-height: Theme.scribe ? 68px : 56px;
    property <length> inset: Theme.scribe ? 32px : 24px;
    property <length> footer-pad: Theme.scribe ? 24px : 16px;
    property <length> footer-height: Theme.button-height + 2 * root.footer-pad;
    TouchArea { clicked => { root.dismissed(); } }
    frame := AccountDialogFrame {
        x: (root.width - self.width) / 2;
        y: clamp((root.height - self.height + Theme.nav-height - Theme.status-height) / 2, 0px, root.height - self.height);
        width: min(root.width - 80px, Theme.scribe ? 560px : 552px);
        height: min(root.height, 6px + root.title-height + root.choice.options.length * root.option-height + root.footer-height);
        Rectangle {
            x: 3px; y: 3px; width: parent.width - 6px; height: root.title-height;
            AccountText {
                x: root.inset; y: 0px; width: parent.width - 2 * root.inset; height: parent.height;
                text: root.choice.title; font-size: Theme.scribe ? 22px : 19px; font-weight: 700;
            }
            Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.ink; }
        }
        Flickable {
            x: 3px; y: 3px + root.title-height; width: frame.width - 6px;
            height: frame.height - self.y - 3px - root.footer-height;
            viewport-width: self.width; viewport-height: max(self.height, root.choice.options.length * root.option-height);
            interactive: self.viewport-height > self.height;
            for option[index] in root.choice.options: AccountPickerRow {
                x: 0px; y: index * root.option-height; width: parent.width;
                label: option.label; active: index == root.choice.current;
                picked => { root.picked(option.id); }
            }
        }
        ActionButton {
            x: 3px + root.inset; y: parent.height - 3px - root.footer-pad - self.height;
            width: parent.width - 6px - 2 * root.inset; text: Strings.common-cancel;
            text-size: Theme.body-size;
            clicked => { root.dismissed(); }
        }
    }
}

component DialogActions inherits Rectangle {
    in property <string> secondary;
    in property <string> primary;
    in property <bool> secondary-enabled: true;
    in property <bool> primary-enabled: true;
    callback secondary-clicked();
    callback primary-clicked();
    height: Theme.button-height;
    property <length> gap: Theme.scribe ? 12px : 10px;
    ActionButton {
        x: 0px; y: 0px; width: root.primary == "" ? parent.width : (parent.width - root.gap) / 2.4;
        text: root.secondary; text-size: Theme.body-size; enabled: root.secondary-enabled;
        clicked => { root.secondary-clicked(); }
    }
    if root.primary != "": ActionButton {
        x: (parent.width - root.gap) / 2.4 + root.gap; y: 0px; width: parent.width - self.x;
        text: root.primary; text-weight: 700; text-size: Theme.body-size;
        primary: true; enabled: root.primary-enabled;
        clicked => { root.primary-clicked(); }
    }
}

component SignoutDialog inherits Rectangle {
    callback dismissed();
    callback confirmed();
    property <length> dialog-padding: Theme.scribe ? 39px : 27px;
    property <length> button-top: Theme.scribe ? 98px : 74px;
    TouchArea { clicked => {} }
    AccountDialogFrame {
        x: (root.width - self.width) / 2;
        y: clamp(Theme.scribe ? 360px - Theme.status-height : 260px - Theme.status-height, 0px, root.height - self.height);
        width: min(root.width - 80px, Theme.scribe ? 660px : 552px);
        height: root.button-top + Theme.button-height + root.dialog-padding;
        AccountText {
            x: root.dialog-padding; y: root.dialog-padding; width: parent.width - 2 * root.dialog-padding;
            height: Theme.scribe ? 40px : 33px;
            text: Strings.acct-signout-question; font-weight: 700; font-size: Theme.scribe ? 28px : 22px;
        }
        DialogActions {
            x: root.dialog-padding; y: root.button-top; width: parent.width - 2 * root.dialog-padding;
            secondary: Strings.common-cancel; primary: Strings.acct-logout;
            secondary-clicked => { root.dismissed(); }
            primary-clicked => { root.confirmed(); }
        }
    }
}

component RechargeOptionTile inherits Rectangle {
    in property <AccountInfoItem> option;
    in property <bool> active;
    callback picked();
    property <bool> inverted: root.active || hit.pressed;
    border-width: 2px; border-color: Theme.ink;
    background: root.inverted ? Theme.ink : Theme.paper;
    AccountText {
        x: 2px; y: Theme.scribe ? 7px : 4px; width: parent.width - 4px; height: Theme.scribe ? 35px : 32px;
        text: root.option.label; font-weight: 700; font-size: Theme.scribe ? 22px : 20px;
        color: root.inverted ? Theme.paper : Theme.ink; horizontal-alignment: center;
    }
    AccountText {
        x: 2px; y: Theme.scribe ? 41px : 36px; width: parent.width - 4px; height: Theme.scribe ? 25px : 20px;
        text: root.option.value; font-size: Theme.scribe ? 18px : 14px;
        color: root.inverted ? Theme.paper : Theme.ink; horizontal-alignment: center;
    }
    hit := AccountHit {
        label: root.option.label + " " + root.option.value; checkable: true; checked: root.active;
        activated => { root.picked(); }
    }
}

export component RechargeDialog inherits Rectangle {
    property <bool> selecting: AccountModel.recharge-phase == "select";
    property <bool> showing-qr: AccountModel.recharge-phase == "qr";
    property <bool> checking: root.showing-qr || AccountModel.recharge-phase == "pending";
    property <bool> retrying: AccountModel.recharge-phase == "error";
    property <int> page;
    property <int> columns: Theme.scribe ? 4 : 2;
    property <int> capacity: root.columns * 2;
    property <int> count: AccountModel.recharge-options.length;
    property <int> pages: max(1, floor((root.count + root.capacity - 1) / root.capacity));
    property <int> current-page: clamp(root.page, 0, root.pages - 1);
    property <int> visible-options: min(root.capacity, max(0, root.count - root.current-page * root.capacity));
    property <int> rows: floor((root.visible-options + root.columns - 1) / root.columns);
    property <length> tile-height: Theme.scribe ? 72px : 60px;
    property <length> tile-gap: Theme.scribe ? 12px : 10px;
    property <length> dialog-padding: Theme.scribe ? 39px : 27px;
    property <length> section-gap: Theme.scribe ? 20px : 16px;
    property <length> title-height: Theme.scribe ? 39px : 31px;
    property <length> amount-height: Theme.scribe ? 41px : 35px;
    property <length> grid-height: root.rows * root.tile-height + max(0, root.rows - 1) * root.tile-gap;
    property <length> pager-height: root.pages > 1 ? 52px : 0px;
    property <length> qr-size: Theme.scribe ? 260px : 200px;
    property <length> qr-height: root.qr-size + (Theme.scribe ? 74px : 64px);
    property <string> notice: AccountModel.recharge-phase == "loading" ? Strings.acct-recharge-loading
        : AccountModel.recharge-phase == "creating" ? Strings.acct-recharge-creating : AccountModel.recharge-message;
    changed selecting => { if !root.selecting { root.page = 0; } }
    TouchArea { clicked => {} }
    frame := AccountDialogFrame {
        x: (root.width - self.width) / 2;
        y: clamp((Theme.scribe ? 260px : 184px) - Theme.status-height, 0px, root.height - self.height);
        width: min(root.width - 80px, Theme.scribe ? 660px : 552px);
        height: min(root.height, 2 * root.dialog-padding + root.title-height + 2 * root.section-gap + body-layout.preferred-height + Theme.button-height);
        AccountText {
            x: root.dialog-padding; y: root.dialog-padding; width: parent.width - 2 * root.dialog-padding; height: root.title-height;
            text: Strings.acct-recharge; font-weight: 700; font-size: Theme.scribe ? 28px : 22px;
        }
        Flickable {
            x: root.dialog-padding; y: root.dialog-padding + root.title-height + root.section-gap;
            width: frame.width - 2 * root.dialog-padding;
            height: max(0px, frame.height - self.y - root.dialog-padding - Theme.button-height - root.section-gap);
            viewport-width: self.width; viewport-height: max(self.height, body-layout.preferred-height);
            interactive: self.viewport-height > self.height;
            body-layout := VerticalLayout {
                x: 0px; y: 0px; width: parent.width; height: self.preferred-height; spacing: root.section-gap;
                if root.selecting: Rectangle {
                    height: root.grid-height; clip: true;
                    property <length> tile-width: (self.width - (root.columns - 1) * root.tile-gap) / root.columns;
                    for option[index] in AccountModel.recharge-options: RechargeOptionTile {
                        visible: index >= root.current-page * root.capacity && index < (root.current-page + 1) * root.capacity;
                        x: mod(index, root.columns) * (parent.tile-width + root.tile-gap);
                        y: floor((index - root.current-page * root.capacity) / root.columns) * (root.tile-height + root.tile-gap);
                        width: parent.tile-width; height: root.tile-height;
                        option: option; active: index == AccountModel.recharge-index;
                        picked => { AccountModel.action("recharge-option", index + ""); }
                    }
                }
                if root.selecting && root.pages > 1: Rectangle {
                    height: root.pager-height;
                    if root.current-page > 0: IconButton {
                        x: 0px; y: (parent.height - self.height) / 2; icon: "back"; label: Strings.acct-previous;
                        clicked => { root.page = root.current-page - 1; }
                    }
                    AccountText {
                        x: 52px; y: 0px; width: parent.width - 104px; height: parent.height;
                        text: (root.current-page + 1) + " / " + root.pages; horizontal-alignment: center;
                    }
                    if root.current-page + 1 < root.pages: IconButton {
                        x: parent.width - self.width; y: (parent.height - self.height) / 2; icon: "next"; label: Strings.acct-next;
                        clicked => { root.page = root.current-page + 1; }
                    }
                }
                if root.selecting: Rectangle {
                    height: root.amount-height;
                    AccountText { x: 0px; y: 0px; width: parent.width / 2; height: parent.height; text: Strings.acct-amount-label; }
                    AccountText {
                        x: parent.width / 2; y: 0px; width: parent.width / 2; height: parent.height;
                        text: AccountModel.recharge-total; font-weight: 700; font-size: Theme.scribe ? 26px : 22px;
                        horizontal-alignment: right;
                    }
                }
                if root.showing-qr: Rectangle {
                    height: root.qr-height;
                    border-width: 1px; border-color: Theme.line;
                    Image {
                        x: (parent.width - self.width) / 2; y: Theme.scribe ? 12px : 10px;
                        width: root.qr-size; height: self.width; source: AccountModel.recharge-qr;
                        image-fit: contain; image-rendering: pixelated;
                    }
                    AccountText {
                        x: 8px; y: parent.height - self.height - (Theme.scribe ? 10px : 8px);
                        width: parent.width - 16px; height: Theme.scribe ? 40px : 36px;
                        text: AccountModel.recharge-total + (AccountModel.recharge-coins == "" ? "" : " · " + AccountModel.recharge-coins);
                        horizontal-alignment: center; font-weight: 700; font-size: Theme.scribe ? 26px : 22px;
                    }
                }
                if root.notice != "": AccountText {
                    width: parent.width; height: self.preferred-height;
                    text: root.notice; font-size: Theme.caption-size; color: Theme.secondary;
                    horizontal-alignment: center; wrap: word-wrap;
                }
            }
        }
        DialogActions {
            x: root.dialog-padding; y: parent.height - root.dialog-padding - self.height; width: parent.width - 2 * root.dialog-padding;
            secondary: root.selecting ? Strings.common-cancel : Strings.acct-close;
            secondary-enabled: !AccountModel.recharge-busy;
            primary: root.selecting ? Strings.acct-recharge-create : root.checking ? Strings.acct-refresh-balance : root.retrying ? Strings.acct-recharge-refresh : "";
            primary-enabled: !AccountModel.recharge-busy && ((root.selecting && root.count > 0) || (root.checking && AccountModel.recharge-can-check) || root.retrying);
            secondary-clicked => { AccountModel.action("recharge-close", ""); }
            primary-clicked => { AccountModel.action(root.selecting ? "recharge-create" : root.checking ? "recharge-check" : "recharge-config", ""); }
        }
    }
}

export component AccountScreen inherits Rectangle {
    background: Theme.paper;
    clip: true;
    property <string> section: Theme.scribe && AccountModel.section == "home" ? "reading" : AccountModel.section;
    property <bool> home: !Theme.scribe && root.section == "home";
    property <bool> history: root.section == "purchases" || root.section == "recharges";
    property <string> active-category: root.history ? "account" : root.section;
    property <length> profile-height: Theme.scribe ? 112px : AccountModel.signed-in ? 146px : 150px;
    property <length> sidebar-width: min(280px, root.width * 0.33);
    property <length> settings-x: Theme.scribe ? root.sidebar-width + 40px : 0px;
    property <length> settings-width: root.width - root.settings-x - (Theme.scribe ? 48px : 0px);
    property <length> heading-y: Theme.scribe ? root.profile-height : 52px;
    property <length> heading-height: Theme.scribe ? 88px : 53px;
    property <string> heading: root.section == "reading" ? Strings.acct-reading : root.section == "display" ? Strings.acct-display
        : root.section == "download" ? Strings.acct-download-network : root.section == "storage" ? Strings.acct-storage
        : root.section == "system" ? Strings.acct-screen-system : root.section == "about" ? Strings.acct-about
        : root.section == "purchases" ? Strings.acct-purchase-history : root.section == "recharges" ? Strings.acct-recharge-history
        : Strings.acct-account;
    property <[AccountCategory]> categories: [
        {id: "reading", title: Strings.acct-reading,
            summary: AccountSettingsData.choice-label(AccountSettingsData.reading-mode) + " · " + AccountSettingsData.choice-label(AccountSettingsData.fit) + " · " + AccountSettingsData.choice-label(AccountSettingsData.direction)},
        {id: "display", title: Strings.acct-display,
            summary: AccountSettingsData.fast ? Strings.refresh-mode-fast : Strings.refresh-mode-normal + " · " + (AccountModel.every == "smart" ? Strings.acct-smart-refresh : AccountModel.every == "0" ? Strings.acct-no-periodic-refresh : AccountSettingsData.choice-label(AccountSettingsData.every) + Strings.acct-full-refresh) + " · " + AccountSettingsData.choice-label(AccountSettingsData.dither)},
        {id: "download", title: Strings.acct-download-network,
            summary: (AccountModel.can-smart ? (AccountModel.smart == "on" ? Strings.acct-smart-on : Strings.acct-smart-off) : Strings.acct-manual-mode) + (AccountModel.can-wifi ? " · " + AccountSettingsData.choice-label(AccountSettingsData.wifi) : "")},
        {id: "storage", title: Strings.acct-storage,
            summary: Strings.acct-used-prefix + AccountModel.storage-used + " · " + Strings.acct-limit-prefix + AccountSettingsData.choice-label(AccountSettingsData.cache-limit)},
        {id: "system", title: Strings.acct-screen-system,
            summary: (AccountModel.can-orient ? AccountSettingsData.choice-label(AccountSettingsData.orientation) + " · " : "") + (AccountModel.can-sleep-cover ? AccountSettingsData.choice-label(AccountSettingsData.sleep-cover) : Strings.acct-unavailable)},
        {id: "account", title: Strings.acct-account, summary: AccountModel.signed-in ? AccountModel.username : Strings.acct-signed-out},
        {id: "about", title: Strings.acct-about, summary: "v" + AccountModel.version}
    ];
    property <AccountChoice> picker;
    changed section => { AccountModel.local-dialog = ""; settings-list.viewport-y = 0px; }
    property <bool> content-enabled: AccountModel.local-dialog == "" && !AccountModel.recharge-visible;

    if Theme.scribe || root.home: AccountProfile { x: 0px; y: 0px; width: parent.width; }
    if root.home: Flickable {
        x: 0px; y: root.profile-height; width: parent.width; height: root.height - self.y;
        viewport-width: self.width; viewport-height: max(self.height, root.categories.length * 66px);
        interactive: self.viewport-height > self.height;
        for category[index] in root.categories: CategoryRow {
            x: 0px; y: index * 66px; width: parent.width;
            category: category; clicked => { AccountModel.action("section", category.id); }
        }
    }
    if Theme.scribe: Rectangle {
        x: 0px; y: root.profile-height; width: root.sidebar-width; height: parent.height - self.y;
        property <length> exit-y: self.height - 88px;
        Flickable {
            x: 0px; y: 16px; width: parent.width - 1px; height: parent.exit-y - self.y;
            viewport-width: self.width; viewport-height: max(self.height, root.categories.length * 72px);
            interactive: self.viewport-height > self.height;
            for category[index] in root.categories: CategoryRow {
                x: 0px; y: index * 72px; width: parent.width;
                category: category; selected: root.active-category == category.id;
                clicked => { AccountModel.action("section", category.id); }
            }
        }
        Rectangle { x: 0px; y: parent.exit-y; width: parent.width; height: 1px; background: Theme.line; }
        Rectangle {
            x: 0px; y: parent.exit-y + 1px; width: parent.width - 1px; height: 71px;
            background: exit-hit.pressed ? Theme.pale : Theme.paper;
            Icon { x: 48px; y: (parent.height - self.height) / 2; width: 24px; height: 24px; kind: "power"; }
            AccountText { x: 82px; y: 0px; width: parent.width - 82px; height: parent.height; text: Strings.acct-exit-app; }
            exit-hit := AccountHit { label: Strings.acct-exit-app; activated => { AccountModel.action("exit", ""); } }
        }
        Rectangle { x: parent.width - 1px; y: 0px; width: 1px; height: parent.height; background: Theme.line; }
    }
    if !Theme.scribe && !root.home: NavigationButton {
        x: 8px; y: 2px; height: 48px;
        text: root.history ? Strings.acct-account : Strings.acct-title; text-size: 16px;
        icon-size: 24px; icon-spacing: 2px; horizontal-padding: 0px;
        clicked => { AccountModel.action("back", ""); }
    }
    if !root.home: Rectangle {
        x: root.settings-x; y: root.heading-y; width: root.settings-width; height: root.heading-height;
        back := NavigationButton {
            visible: Theme.scribe && root.history;
            x: 0px; y: (parent.height - self.height) / 2; height: 56px;
            text: Strings.acct-account; text-size: 20px; icon-size: 24px; horizontal-padding: 3px; icon-spacing: 4px;
            enabled: self.visible;
            clicked => { AccountModel.action("back", ""); }
        }
        if Theme.scribe && root.history: Rectangle { x: back.width + 14px; y: 16px; width: 1px; height: 56px; background: Theme.line; }
        AccountText {
            x: Theme.scribe ? (root.history ? back.width + 31px : 0px) : 16px;
            y: Theme.scribe ? 0px : -4px; width: parent.width - self.x; height: parent.height - (Theme.scribe ? 0px : 6px);
            text: root.heading; font-size: Theme.scribe ? 30px : 28px; font-weight: 700;
        }
        Rectangle { x: 0px; y: parent.height - self.height; width: parent.width; height: Theme.scribe ? 1px : 2px; background: Theme.ink; }
    }
    settings-list := Flickable {
        visible: !root.home;
        x: root.settings-x; y: root.heading-y + root.heading-height; width: root.settings-width;
        height: max(0px, root.height - self.y);
        viewport-width: self.width; viewport-height: max(self.height, settings.content-height);
        interactive: self.visible && self.viewport-height > self.height;
        settings := CategorySettings {
            x: 0px; y: 0px; width: parent.width; height: self.content-height;
            section: root.section;
            pick(choice) => { if root.content-enabled { root.picker = choice; AccountModel.local-dialog = "picker"; } }
            signout => { if root.content-enabled { AccountModel.local-dialog = "signout"; } }
        }
    }
    if AccountModel.local-dialog == "picker": AccountPicker {
        width: parent.width; height: parent.height; choice: root.picker;
        dismissed => { AccountModel.local-dialog = ""; }
        picked(id) => { AccountModel.local-dialog = ""; AccountModel.action(root.picker.action, id); }
    }
    if AccountModel.local-dialog == "signout": SignoutDialog {
        width: parent.width; height: parent.height;
        dismissed => { AccountModel.local-dialog = ""; }
        confirmed => { AccountModel.local-dialog = ""; AccountModel.action("logout", ""); }
    }
    if AccountModel.recharge-visible: RechargeDialog { width: parent.width; height: parent.height; }
}
