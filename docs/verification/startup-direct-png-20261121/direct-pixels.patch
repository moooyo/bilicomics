+    fn tiny_cover_png(depth: u8, color: u8, extra: &[(&[u8; 4], &[u8])], scanline: &[u8]) -> Result<Vec<u8>> {
+        use std::io::Write;
+        fn chunk(output: &mut Vec<u8>, kind: &[u8; 4], payload: &[u8]) {
+            output.extend_from_slice(&(payload.len() as u32).to_be_bytes());
+            output.extend_from_slice(kind);
+            output.extend_from_slice(payload);
+            let mut crc = crc32fast::Hasher::new();
+            crc.update(kind);
+            crc.update(payload);
+            output.extend_from_slice(&crc.finalize().to_be_bytes());
+        }
+        let mut png = b"\x89PNG\r\n\x1a\n".to_vec();
+        chunk(&mut png, b"IHDR", &[0, 0, 0, 1, 0, 0, 0, 1, depth, color, 0, 0, 0]);
+        for (kind, payload) in extra { chunk(&mut png, kind, payload); }
+        let mut compressed = flate2::write::ZlibEncoder::new(Vec::new(), flate2::Compression::fast());
+        compressed.write_all(scanline)?;
+        chunk(&mut png, b"IDAT", &compressed.finish()?);
+        chunk(&mut png, b"IEND", &[]);
+        Ok(png)
+    }
