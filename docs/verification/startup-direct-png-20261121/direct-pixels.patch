+pub(super) fn decode_managed_startup_cover(encoded: Vec<u8>, remaining: usize) -> Result<StartupCoverPixels> {
+    use image::ImageDecoder;
+    if !encoded.starts_with(b"\x89PNG\r\n\x1a\n\0\0\0\rIHDR") || encoded.get(24..29) != Some(&[8, 6, 0, 0, 0]) {
+        return decode_cover_bytes(encoded).map(StartupCoverPixels::Raw);
+    }
+    anyhow::ensure!(encoded.len() as u64 <= MAX_STARTUP_COVER_BYTES, "Cover data exceeds its byte limit");
+    let mut limits = cover_limits();
+    let mut decoder = image::codecs::png::PngDecoder::with_limits(Cursor::new(encoded), limits.clone())?;
+    let bytes = decoder.total_bytes();
+    limits.reserve(bytes)?;
+    decoder.set_limits(limits)?;
+    let (width, height) = decoder.dimensions();
+    if (1..=480).contains(&width) && (1..=640).contains(&height) && bytes <= remaining as u64
+        && decoder.color_type() == image::ColorType::Rgba8 && !decoder.is_apng()? {
