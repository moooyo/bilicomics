+#[cfg(all(feature = "desktop", target_os = "linux"))]
+#[derive(Clone, Copy, PartialEq, Eq, serde::Serialize)]
+#[serde(rename_all = "snake_case")]
+enum DesktopPresentMode {
+    Observe,
+    Wake,
+}
+
+#[cfg(all(feature = "desktop", target_os = "linux"))]
+fn desktop_present_mode(kindle: bool, rendering_notifier: bool) -> Result<Option<DesktopPresentMode>> {
+    if kindle || rendering_notifier { return Ok(None); }
+    match std::env::var_os("BILICOMICS_DESKTOP_PRESENT_PROBE").as_deref() {
+        None => Ok(None),
+        Some(value) if value == "observe" => Ok(Some(DesktopPresentMode::Observe)),
+        Some(value) if value == "wake" => Ok(Some(DesktopPresentMode::Wake)),
+        _ => bail!("Unknown desktop software presentation probe mode"),
+    }
+}
+
+#[cfg(all(feature = "desktop", target_os = "linux"))]
+#[derive(Clone, Copy, serde::Serialize)]
+struct DesktopPostSubmitTurn {
+    workers_started_before: bool,
+    window_alive: bool,
+    booting: bool,
+    suspended: bool,
+    quitting: bool,
+    cancelled: bool,
+    driver_available: bool,
+    ui_thread: bool,
+}
+
+#[cfg(all(feature = "desktop", target_os = "linux"))]
+impl DesktopPostSubmitTurn {
+    fn should_drive(self, mode: DesktopPresentMode) -> bool {
+        mode == DesktopPresentMode::Wake && self.ui_thread && self.window_alive && self.booting
+            && self.driver_available && !self.workers_started_before && !self.suspended && !self.quitting && !self.cancelled
+    }
+}
