@@ -0,0 +1,98 @@
+use std::cell::RefCell;
+
+#[derive(Default)]
+enum Observer {
+    #[default]
+    Unregistered,
+    Armed(Box<dyn FnOnce(u32, u32)>),
+    Submitted,
+}
+
+#[derive(Default)]
+pub(crate) struct FirstFullPresent(RefCell<Observer>);
+
+#[derive(Clone, Copy)]
+pub(crate) struct SubmittedDamage {
+    pub(crate) drawable: (u32, u32),
+    pub(crate) origin: (i32, i32),
+    pub(crate) extent: (u32, u32),
+}
+
+impl FirstFullPresent {
+    pub(crate) fn register(&self, callback: Box<dyn FnOnce(u32, u32)>) -> bool {
+        let mut state = self.0.borrow_mut();
+        if !matches!(*state, Observer::Unregistered) {
+            return false;
+        }
+        *state = Observer::Armed(callback);
+        true
+    }
+
+    pub(crate) fn finish<E>(&self, submitted: Result<Option<SubmittedDamage>, E>) -> Result<(), E> {
+        let Some(damage) = submitted? else { return Ok(()) };
+        let (width, height) = damage.drawable;
+        if width != 0 && height != 0 && damage.origin == (0, 0) && damage.extent == damage.drawable {
+            let previous = self.0.replace(Observer::Submitted);
+            if let Observer::Armed(callback) = previous {
+                callback(width, height);
+            }
+        }
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::{cell::Cell, rc::Rc};
+
+    const FULL: SubmittedDamage = SubmittedDamage { drawable: (1860, 2480), origin: (0, 0), extent: (1860, 2480) };
+
+    #[test]
+    fn only_a_successful_nonempty_full_submit_consumes_the_observer() -> Result<(), &'static str> {
+        let sensor = Rc::new(FirstFullPresent::default());
+        let weak = Rc::downgrade(&sensor);
+        let seen = Rc::new(Cell::new(None));
+        let captured = seen.clone();
+        assert!(sensor.register(Box::new(move |width, height| {
+            assert!(!weak.upgrade().unwrap().register(Box::new(|_, _| unreachable!())));
+            captured.set(Some((width, height)));
+        })));
+        assert!(!sensor.register(Box::new(|_, _| unreachable!())));
+        assert_eq!(sensor.finish(Err("submit error")), Err("submit error"));
+        sensor.finish::<&str>(Ok(None))?;
+        for damage in [
+            SubmittedDamage { drawable: (0, 2480), extent: (0, 2480), ..FULL },
+            SubmittedDamage { drawable: (1860, 0), extent: (1860, 0), ..FULL },
+            SubmittedDamage { extent: (0, 0), ..FULL },
+            SubmittedDamage { extent: (1859, 2480), ..FULL },
+            SubmittedDamage { extent: (1860, 2479), ..FULL },
+            SubmittedDamage { extent: (1861, 2480), ..FULL },
+            SubmittedDamage { origin: (-1, 0), ..FULL },
+            SubmittedDamage { origin: (0, 1), ..FULL },
+        ] {
+            sensor.finish::<&str>(Ok(Some(damage)))?;
+            assert_eq!(seen.get(), None);
+        }
+        sensor.finish::<&str>(Ok(Some(FULL)))?;
+        assert_eq!(seen.take(), Some(FULL.drawable));
+        sensor.finish::<&str>(Ok(Some(FULL)))?;
+        assert_eq!(seen.get(), None);
+        Ok(())
+    }
+
+    #[test]
+    fn another_renderer_cannot_notify_this_window_or_register_after_its_own_submit() -> Result<(), &'static str> {
+        let owned = FirstFullPresent::default();
+        let other = FirstFullPresent::default();
+        let seen = Rc::new(Cell::new(false));
+        let captured = seen.clone();
+        assert!(owned.register(Box::new(move |_, _| captured.set(true))));
+        other.finish::<&str>(Ok(Some(FULL)))?;
+        assert!(!seen.get());
+        assert!(!other.register(Box::new(|_, _| unreachable!())));
+        owned.finish::<&str>(Ok(Some(FULL)))?;
+        assert!(seen.get());
+        Ok(())
+    }
+}
